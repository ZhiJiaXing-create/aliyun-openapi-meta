  "description_en": "Creates a document library. A document library isolates document and index data. If your use case requires frequent natural language search by category, create multiple libraries to isolate different data types. You can customize vector and text indexes by format",
  "description_zh": "创建文档库。创建一个新的文档库，文档库用作隔离文档信息、索引信息，如果使用场景中需要经常按类别去做自然语言检索，建议创建多个文档库，来隔离不同类型的数据。支持按照格式自定义向量索引和文本索引",
  "endpoint_map": {
    "cn-beijing": "dianjin.cn-beijing.aliyuncs.com"
  },
  "global_endpoint": "",
  "kebab_example": "aliyun dianjin create-library --workspace-id llm-ik000000RVYCKzt --description '描述文档库的具体作用' --index-setting '{\"recallStrategy\":{\"documentRankType\":\"model\",\"limit\":20},\"queryEnhancer\":{\"enableFollowUp\":true,\"enableOpenQa\":true,\"localKnowledgeId\":\"xxxx\",\"enableMultiQuery\":true,\"withDocumentReference\":true,\"enableSession\":true,\"enableQueryRewrite\":true},\"modelConfig\":{\"temperature\":0.8,\"topP\":0.8},\"textIndexSetting\":{\"topK\":50,\"enable\":true,\"searchAnalyzer\":\"Standard\",\"indexAnalyzer\":\"Standard\",\"category\":\"ElasticSearch\",\"rankThreshold\":0.5},\"promptRoleStyle\":\"你是一位信息处理专家，耐心、友好、逻辑清晰。\",\"vectorIndexSetting\":{\"topK\":50,\"embeddingType\":\"DashScope\",\"enable\":true,\"category\":\"ADB\",\"rankThreshold\":0.5},\"chunkStrategy\":{\"docTreeSplit\":true,\"enhanceGraph\":true,\"enhanceTable\":true,\"sentenceSplit\":true,\"overlap\":20,\"split\":true,\"size\":300,\"sentenceSplitSize\":300,\"docTreeSplitSize\":300}}' --library-name '金融知识文档库' --region cn-hangzhou",
