{
  "name": "ListFunctionNames",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/metastore/catalogs/databases/functions/names",
  "parameters": [
    {
      "name": "CatalogId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据目录ID。",
        "en": "The ID of the data catalog."
      }
    },
    {
      "name": "DatabaseName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据库名称。",
        "en": "The name of the database."
      }
    },
    {
      "name": "FunctionNamePattern",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "函数名匹配的正则表达式。",
        "en": "The regular expression that the function names must match."
      }
    },
    {
      "name": "NextPageToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻页token，从返回结果返回，无则传空字符串或''。",
        "en": "The token to retrieve the next page of results. It is returned in the response. To retrieve the first page, pass an empty string ('') or leave this parameter empty."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页大小，最大值为1000。",
        "en": "The number of entries to return on each page. The maximum value is 1000."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取数据库的函数名称列表",
    "en": "ListFunctionNames"
  }
}