{
  "name": "ListFunctions",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/metastore/catalogs/databases/functions/list",
  "parameters": [
    {
      "name": "CatalogId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据目录ID。",
        "en": "The ID of the data catalog."
      }
    },
    {
      "name": "DatabaseName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据库名称。",
        "en": "The name of the database."
      }
    },
    {
      "name": "FunctionNamePattern",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户定义函数名的正则匹配表达式。",
        "en": "A regular expression that filters user-defined functions by name."
      }
    },
    {
      "name": "NextPageToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻页令牌，用于获取下一页数据。如果响应结果中没有提供，则传空字符串（\"\"）或空字符（''）。",
        "en": "The token to retrieve the next page of results. If the response does not provide this token, pass an empty string (\"\")."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页大小，最大值为1000。",
        "en": "The number of entries to return on each page. The maximum value is 1000."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取数据库的函数列表",
    "en": "ListFunctions"
  }
}