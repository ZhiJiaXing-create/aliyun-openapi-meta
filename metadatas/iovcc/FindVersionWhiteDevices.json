{
  "name": "FindVersionWhiteDevices",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DeviceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备ID，支持模糊匹配。",
        "en": "The device ID. Fuzzy match is supported."
      }
    },
    {
      "name": "OriginalId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "源设备ID，支持模糊匹配。",
        "en": "The original device ID. Fuzzy match is supported."
      }
    },
    {
      "name": "PageIndex",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页索引，从1开始。",
        "en": "The page number, starting from 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页大小，支持10、20、50三种。",
        "en": "The number of entries per page. Valid values: 10, 20, and 50."
      }
    },
    {
      "name": "ProjectId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目ID",
        "en": "The project ID."
      }
    },
    {
      "name": "VersionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "版本ID",
        "en": "The version ID."
      }
