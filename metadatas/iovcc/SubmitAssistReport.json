{
  "name": "SubmitAssistReport",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AssistDescription",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "诊断缺陷描述，描述问题现象、复现步骤。",
        "en": "The description of the diagnosed bug, including the symptoms and steps to reproduce the issue."
      }
    },
    {
      "name": "AssistId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "诊断会话ID。",
        "en": "The diagnostic session ID."
      }
    },
    {
      "name": "AssistReason",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "诊断原因定位，描述问题的主要原因。",
        "en": "The root cause analysis of the diagnosis, describing the primary cause of the issue."
      }
    },
    {
      "name": "AssistResult",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "诊断结论。",
        "en": "The diagnostic conclusion."
      }
    },
    {
      "name": "AssistTag",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "诊断标签，用于历史查询，按空格分隔。",
        "en": "The diagnostic labels used for history queries. Separate multiple labels with spaces."
      }
    },
    {
      "name": "DeviceModel",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备model。",
        "en": "The device model."
      }
    },
    {
      "name": "ProjectId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目ID。",
        "en": "The project ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "提交远程诊断报告",
    "en": "Submit a remote diagnostic report"
  },
  "descriptions": {
    "zh": "> 对于一次诊断，首次提交会创建一份报告，后续提交会更新报告内容。",
    "en": "> For a single diagnosis, the first submission creates a report, and subsequent submissions update the report content."
  }
}