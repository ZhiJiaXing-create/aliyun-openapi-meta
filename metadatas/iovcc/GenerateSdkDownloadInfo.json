{
  "name": "GenerateSdkDownloadInfo",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "自定义应用ID。",
        "en": "The ID of the custom application."
      }
    },
    {
      "name": "CertFileObjectKey",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "RSA证书文件上传OSS后，在OSS上的完整文件名。",
        "en": "The full name of the RSA certificate file in Object Storage Service (OSS) after the file is uploaded to OSS."
      }
    },
    {
      "name": "OsType",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "系统类型，1-Android。",
        "en": "The operating system type. Valid values: 1: Android."
      }
    },
    {
      "name": "PkgName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "自定义应用的包名。",
        "en": "The package name of the custom application."
      }
    },
    {
      "name": "ProjectId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目ID。",
        "en": "The project ID."
      }
    },
    {
      "name": "Sdks",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "用户选择要下载的sdk集合，多个以英文逗号隔开。",
        "en": "The SDKs that you want to download. Separate multiple SDKs with commas (,)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取SDK下载的信息",
    "en": "Retrieve SDK download information"
  }
