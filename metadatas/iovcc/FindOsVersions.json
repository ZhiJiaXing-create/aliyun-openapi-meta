{
  "name": "FindOsVersions",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DeviceModelId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备型号（机型）ID",
        "en": "The device model ID."
      }
    },
    {
      "name": "IsMilestone",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "是否里程碑，Y或N。",
        "en": "Specifies whether the version is a milestone. Valid values: Y and N."
      }
    },
    {
      "name": "PageIndex",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页索引，表示要获取第几页的数据，第一页从1开始。",
        "en": "The page number. Pages start from 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "每页大小，允许20、50、100三个选择。",
        "en": "The number of entries per page. Valid values: 20, 50, and 100."
      }
    },
    {
      "name": "ProjectId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目ID",
        "en": "The project ID."
      }
    },
    {
      "name": "Remark",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "版本备注",
        "en": "The version remarks."
      }
    },
    {
      "name": "Status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "版本状态，如：**TESTING**，**TEST_PASSED**，**PREPUBLISH**，**PUBLISHED**。",
        "en": "The version status, such as **TESTING**, **TEST_PASSED**, **PREPUBLISH**, or **PUBLISHED**."
      }
    },
    {
      "name": "SystemVersion",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "系统版本号",
        "en": "The OS version number."
      }
    },
    {
      "name": "VersionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "版本ID",
        "en": "The version ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "分页获取系统版本列表",
    "en": "Query OS versions by page"
  },
  "descriptions": {
    "zh": "> 此接口支持多种查询条件，如机型、系统版本号等。",
    "en": "> This operation supports multiple query conditions, such as device model and OS version number."
  }
}