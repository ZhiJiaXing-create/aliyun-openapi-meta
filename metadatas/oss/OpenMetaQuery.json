{
  "name": "OpenMetaQuery",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/?metaQuery&comp=add",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "Struct",
      "required": false,
      "description": {
        "zh": "接口请求体参数",
        "en": "The request body parameters."
      }
    },
    {
      "name": "bucket",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Bucket名称。",
        "en": "The bucket name."
      }
    },
    {
      "name": "mode",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "检索模式。取值如下：\n\nbasic（默认值）：标量检索\n\nsemantic：向量检索",
        "en": "The retrieve mode. Valid values:\n\nbasic (default): scalar retrieve\n\nsemantic: AISearch"
      }
    },
    {
      "name": "role",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "指定用于访问 OSS 服务的 RAM 角色名称，支持在控制台为角色授予权限，实现安全访问。",
        "en": "The name of the RAM role used to access OSS. You can grant permissions to the role in the console to implement secure access."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "开启元数据管理功能",
    "en": "Enable the metadata management feature"
  }
}