{
  "name": "DoMetaQuery",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/?metaQuery&comp=query",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "Struct",
      "required": false,
      "description": {
        "zh": "保存查询条件的请求体。",
        "en": "The request body that contains the query conditions."
      }
    },
    {
      "name": "bucket",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Bucket名称。",
        "en": "The bucket name."
      }
    },
    {
      "name": "mode",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "指定检索模式。\n- basic：标量检索（默认）\n- semantic：向量检索",
        "en": "The retrieve mode. Valid values:\n- basic: scalar retrieve (default).\n- semantic: AISearch."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询满足条件的文件",
    "en": "Query objects that meet conditions"
  }
}