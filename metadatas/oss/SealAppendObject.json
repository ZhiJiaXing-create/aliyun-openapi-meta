{
  "name": "SealAppendObject",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/[key]?seal",
  "parameters": [
    {
      "name": "bucket",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "存储空间名称",
        "en": "The name of the bucket."
      }
    },
    {
      "name": "key",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Appendable Object的名称",
        "en": "The name of the appendable object."
      }
    },
    {
      "name": "position",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "用于指定从用户期望Seal时该文件的长度。",
        "en": "The expected length of the object at the time of sealing."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "封存可追加对象",
    "en": "Seal an appendable object"
  }
}