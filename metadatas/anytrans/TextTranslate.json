{
  "name": "TextTranslate",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/anytrans/translate/text",
  "parameters": [
    {
      "name": "ext",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "控制翻译行为的扩展参数",
        "en": "Extended parameters to control translation behavior"
      }
    },
    {
      "name": "format",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文本格式",
        "en": "text format"
      }
    },
    {
      "name": "scene",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模型类型",
        "en": "Model type"
      }
    },
    {
      "name": "sourceLanguage",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "源语种代码",
        "en": "Source language code"
      }
    },
    {
      "name": "targetLanguage",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "目标语种代码",
        "en": "Target Language Code"
      }
    },
    {
      "name": "text",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待翻译的文本",
        "en": "Text to be translated"
      }
    },
    {
      "name": "workspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务空间Id",
        "en": "Workspace ID"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "文本翻译接口",
    "en": "Text Translation API"
  }
}