{
  "name": "SubmitImageTranslateTask",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/anytrans/translate/image/submit",
  "parameters": [
    {
      "name": "ext",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "控制翻译功能的扩展参数",
        "en": "Extended parameters to control translation features."
      }
    },
    {
      "name": "format",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻译形式",
        "en": "The translation format."
      }
    },
    {
      "name": "scene",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "翻译模型",
        "en": "Specifies the translation model."
      }
    },
    {
      "name": "sourceLanguage",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "源语言",
        "en": "The source language."
      }
    },
    {
      "name": "targetLanguage",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "目标语言列表",
        "en": "A list of target languages."
      }
    },
    {
      "name": "text",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待翻译的图片url",
        "en": "The URL of the image to translate."
      }
    },
    {
      "name": "workspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "当前请求所使用的百炼业务空间 id",
        "en": "The ID of the Model Studio workspace."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "提交图片翻译任务",
    "en": "Submit an image translation job"
  }
}