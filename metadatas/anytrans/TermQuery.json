    {
      "name": "targetLanguage",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "目标语言",
        "en": "The target language."
      }
    },
    {
      "name": "text",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "输入包含干预的句子",
        "en": "The source text to search for intervention terms."
      }
