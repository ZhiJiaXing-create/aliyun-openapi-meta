{
  "name": "TermQuery",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/anytrans/translate/intervene/query",
  "parameters": [
    {
      "name": "ext",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "en": "Extended parameters."
      }
    },
    {
      "name": "scene",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "翻译模型",
        "en": "The translation model."
      }
    },
    {
      "name": "sourceLanguage",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "源语言",
        "en": "The source language."
