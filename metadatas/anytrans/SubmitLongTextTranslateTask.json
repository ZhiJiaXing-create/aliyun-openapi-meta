{
  "name": "SubmitLongTextTranslateTask",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/anytrans/translate/longText/submit",
  "parameters": [
    {
      "name": "ext",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "控制翻译功能的扩展参数",
        "en": "A container for extended parameters that control translation features."
      }
    },
    {
      "name": "format",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻译形式",
        "en": "The format of the source text."
      }
    },
    {
      "name": "scene",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻译模型",
        "en": "The translation model."
      }
    },
    {
      "name": "sourceLanguage",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "源语言",
        "en": "The language code of the source language."
      }
    },
    {
      "name": "targetLanguage",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "目标语言",
        "en": "The language code of the target language."
      }
    },
    {
      "name": "text",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "待翻译的长文本",
        "en": "The long source text to translate."
      }
    },
    {
      "name": "workspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "当前请求所使用的百炼业务空间 id",
        "en": "The ID of the Model Studio workspace."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "提交长文本翻译任务",
    "en": "Submit a long-text translation job"
  }
}