{
  "name": "BatchTranslate",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/anytrans/translate/batch",
  "parameters": [
    {
      "name": "appName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "调用来源",
        "en": "The name of the calling application."
      }
    },
    {
      "name": "ext",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "控制翻译功能的扩展参数",
        "en": "The extended parameters that control translation features."
      }
    },
    {
      "name": "format",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻译形式",
        "en": "The translation format."
      }
    },
    {
      "name": "scene",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻译模型",
        "en": "The translation model."
      }
    },
    {
      "name": "sourceLanguage",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "源语言",
        "en": "The source language."
      }
    },
    {
      "name": "targetLanguage",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "目标语言",
        "en": "The target language."
      }
    },
    {
      "name": "text",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待翻译的批量文本",
        "en": "A map of texts to translate, in which the key is a custom identifier and the value is the source text."
      }
    },
    {
      "name": "workspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "当前请求所使用的百炼业务空间 id",
        "en": "The ID of the Model Studio workspace used for this request."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "批量文本翻译",
    "en": "Batch Text Translation"
  }
}