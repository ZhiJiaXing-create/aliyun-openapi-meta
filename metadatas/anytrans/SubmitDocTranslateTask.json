{
  "name": "SubmitDocTranslateTask",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/anytrans/translate/doc/submit",
  "parameters": [
    {
      "name": "ext",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "控制翻译功能的扩展参数",
        "en": "Extension parameters that control translation features."
      }
    },
    {
      "name": "format",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻译形式",
        "en": "The format for the translation."
      }
    },
    {
      "name": "scene",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "翻译模型",
        "en": "The translation model."
      }
    },
    {
      "name": "sourceLanguage",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "源语言",
        "en": "The source language code."
      }
    },
    {
      "name": "targetLanguage",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "目标语言",
        "en": "The target language code."
      }
    },
    {
      "name": "text",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待翻译文件URL",
        "en": "The URL of the document to translate."
      }
    },
    {
      "name": "workspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "当前请求所使用的百炼业务空间 id",
        "en": "The ID of the Model Studio workspace for the current request."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "文档翻译任务提交",
    "en": "Submit Document Translation Job"
  }
}