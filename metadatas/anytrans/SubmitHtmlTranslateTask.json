{
  "name": "SubmitHtmlTranslateTask",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/anytrans/translate/html/submit",
  "parameters": [
    {
      "name": "ext",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "控制翻译功能的扩展参数",
        "en": "Extended parameters to control translation behavior."
      }
    },
    {
      "name": "format",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻译形式",
        "en": "The format of the input text."
      }
    },
    {
      "name": "scene",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻译模型",
        "en": "The translation model."
      }
    },
    {
      "name": "sourceLanguage",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "源语言",
        "en": "The source language."
      }
    },
    {
      "name": "targetLanguage",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "目标语言",
        "en": "The target language."
      }
    },
    {
      "name": "text",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "待翻译的html内容",
        "en": "The HTML content to be translated."
      }
    },
    {
      "name": "workspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "当前请求所使用的百炼业务空间 id",
        "en": "The ID of the Model Studio workspace used for this request."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "提交html翻译任务",
    "en": "Submit an HTML translation job"
  }
}