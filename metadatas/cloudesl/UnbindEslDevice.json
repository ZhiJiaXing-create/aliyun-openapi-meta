{
  "name": "UnbindEslDevice",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Column",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "陈列系统的逻辑列。",
        "en": "The logical column in the display system."
      }
    },
    {
      "name": "ContainerName",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "EslBarCode",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "价签条码。",
        "en": "The ESL bar code."
      }
    },
    {
      "name": "ExtraParams",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "扩展参数",
        "en": "The extended parameters."
      }
    },
    {
      "name": "ItemBarCode",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "商品条码。",
        "en": "The item bar code."
      }
    },
    {
      "name": "Layer",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "陈列系统的层号。",
        "en": "The layer number in the display system."
      }
    },
    {
      "name": "Shelf",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "陈列系统的货架号。",
        "en": "The shelf number in the display system."
      }
    },
    {
      "name": "StoreId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "门店ID或商家自定义门店ID。",
        "en": "The store ID or custom store ID defined by the merchant."
      }
    }
  ],
  "security": [
    "AK",
    "BearerToken"
  ],
  "title": {
    "zh": "解绑价签设备",
    "en": "Unbind an ESL device"
  },
  "descriptions": {
    "zh": "该接口分为陈列模式和普通模式两种。陈列模式是用陈列货位和价签条码进行解绑，普通模式是用商品条码和价签条码进行解绑。",
    "en": "This operation supports two modes: display mode and standard mode. In display mode, the ESL is unbound by using the display shelf position and ESL bar code. In standard mode, the ESL is unbound by using the item bar code and ESL bar code."
  }
}