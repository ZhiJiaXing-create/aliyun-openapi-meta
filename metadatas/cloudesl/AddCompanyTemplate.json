      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否缺货，取值：-true：是。-false：否。",
        "en": "Indicates whether the item is out of stock. Valid values: - true: Yes. - false: No."
      }
    },
    {
      "name": "IfPromotion",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否促销，取值：-true：是。-false：否。",
        "en": "Specifies whether it is a promotion. Valid values: - true: Yes. - false: No."
      }
    },
    {
      "name": "IfSourceCode",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否溯源，取值：-true：是。-false：否。",
        "en": "Indicates whether source tracing is enabled. Valid values: - true: Yes. - false: No."
      }
