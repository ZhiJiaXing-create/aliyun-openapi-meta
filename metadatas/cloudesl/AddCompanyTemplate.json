    {
      "name": "TemplateType",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模板类型",
        "en": "Template type"
      }
    },
    {
      "name": "TemplateVersion",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "门店模板版本；",
        "en": "Outlet template version."
      }
