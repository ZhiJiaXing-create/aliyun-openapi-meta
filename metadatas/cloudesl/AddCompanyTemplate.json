{
  "name": "AddCompanyTemplate",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DeviceType",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "设备类型",
        "en": "Device type"
      }
    },
    {
      "name": "EslSize",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "价签尺寸",
        "en": "ESL size"
      }
    },
    {
      "name": "ExtraParams",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "系统扩展字段，请忽略；",
        "en": "System extension field. Ignore this field."
      }
    },
    {
      "name": "GroupId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模板组id",
        "en": "Template group ID"
