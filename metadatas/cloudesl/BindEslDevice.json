{
  "name": "BindEslDevice",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Column",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "陈列系统中的逻辑列。",
        "en": "The logical column in the display system."
      }
    },
    {
      "name": "ContainerId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "容器id",
        "en": "The container ID."
      }
    },
    {
      "name": "ContainerName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "容器名称。",
        "en": "The container name."
      }
    },
    {
      "name": "EslBarCode",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "价签条码。",
        "en": "The ESL bar code."
      }
    },
    {
      "name": "ExtraParams",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "扩展参数",
        "en": "The extended parameters."
      }
    },
    {
      "name": "ItemBarCode",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "商品条码。",
        "en": "The item bar code."
      }
    },
    {
      "name": "Layer",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "陈列系统中的层号。",
        "en": "The layer number in the display system."
      }
    },
    {
      "name": "LayoutId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "布局ID。仅支持传单个ID。",
        "en": "The layout ID. Only a single ID is supported."
      }
    },
    {
      "name": "LayoutName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "布局名称。",
        "en": "The layout name."
      }
    },
    {
      "name": "Shelf",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "陈列系统中的货架号。",
        "en": "The shelf number in the display system."
      }
    },
    {
      "name": "StoreId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "门店ID或商家自定义门店ID。",
        "en": "The store ID or the custom store ID defined by the merchant."
      }
    }
  ],
  "security": [
    "AK",
    "BearerToken"
  ],
  "title": {
    "zh": "绑定价签设备",
    "en": "Bind a cloudESL device"
  },
  "descriptions": {
    "zh": "该接口分为陈列模式和普通模式两种。陈列模式是用陈列货位和价签条码进行绑定，普通模式是用商品条码和价签条码进行绑定。",
    "en": "This operation supports two modes: display mode and standard mode. In display mode, binding is performed by using a display shelf position and an ESL bar code. In standard mode, binding is performed by using an item bar code and an ESL bar code."
  }
}