{
  "name": "ListTrainingJobEvents",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/trainingjobs/[TrainingJobId]/events",
  "parameters": [
    {
      "name": "EndTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "截止UTC时间（iso8601格式），为空则为当前时间。",
        "en": "End UTC time (ISO8601 format). If empty, it is the current time."
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "页码（默认值为1）。",
        "en": "Page number (default is 1)."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页大小（默认值为100）。",
        "en": "Page size (default is 100)."
      }
    },
    {
      "name": "StartTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "起始UTC时间（iso8601格式），为空则为任务开始时间。",
        "en": "Start UTC time (ISO8601 format). If empty, it is the task start time."
      }
    },
    {
      "name": "TrainingJobId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "训练任务ID。",
        "en": "Training task ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取训练任务事件",
    "en": "Retrieve Training Job Events"
  },
  "example": {
    "unifiedCli": "aliyun paistudio list-training-job-events --training-job-id traineyfz0m20000 --page-number 1 --page-size 100 --start-time 2020-11-08T16:00:00Z --end-time 2020-11-08T16:00:00Z --api-version 2022-01-12 --region cn-hangzhou",
    "legacyCli": "aliyun paistudio GET /api/v1/trainingjobs/traineyfz0m20000/events --region cn-hangzhou --PageSize 100 --EndTime '2020-11-08T16:00:00Z' --PageNumber 1 --StartTime '2020-11-08T16:00:00Z' --header \"Content-Type=application/json\""
  }
}