{
  "name": "GetResourceGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/resources/[ResourceGroupID]",
  "parameters": [
    {
      "name": "IsAIWorkspaceDataEnabled",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "这个参数是可选参数。默认是true。",
        "en": "Optional. Defaults to `true`."
      }
    },
    {
      "name": "ResourceGroupID",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "资源组 ID，每一个资源组都有全局唯一的资源组ID。可以通过资源组ID来获取资源组的信息。",
        "en": "The globally unique ID of the resource group."
      }
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "对应新增标签列表，最多包含20个子项",
        "en": "A list of up to 20 tags to add to the instance."
      },
      "sub_parameters": [
        {
          "name": "Key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "实例的标签键。N 的取值范围为 1~20。",
            "en": "The tag key."
          }
        },
        {
          "name": "Value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "实例的标签值。N 的取值范围：1~20。",
            "en": "The tag value."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取资源组详情",
    "en": "Get resource group details"
  },
  "example": {
    "unifiedCli": "aliyun paistudio get-resource-group --resource-group-id rgmhpp8ib5lprq9k --is-ai-workspace-data-enabled true --tag Value=TestValue Key=TestKey --api-version 2022-01-12 --region cn-hangzhou",
    "legacyCli": "aliyun paistudio GET /api/v1/resources/rgmhpp8ib5lprq9k --region cn-hangzhou --IsAIWorkspaceDataEnabled true --Tag '[{\"Value\":\"TestValue\",\"Key\":\"TestKey\"}]' --header \"Content-Type=application/json\""
  }
}