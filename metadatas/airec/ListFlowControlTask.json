{
  "name": "ListFlowControlTask",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v2/openapi/instances/[instanceId]/flowControlTasks",
  "parameters": [
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "page",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页页数。",
        "en": "The page number."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "指定每页展示条数，默认为10，限制:[1-50]。",
        "en": "The number of entries to return on each page. Default value: 10. Valid values: 1 to 50."
      }
    },
    {
      "name": "status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务状态。\n\n取值：\n\n- **DRAFT**：草稿。\n\n- **READY**：待生效。\n\n- **RUNNING**：运行中。\n\n- **ENDED**：结束。",
        "en": "The task status.\n\nValid values:\n\n- **DRAFT**: The task is a draft.\n\n- **READY**: The task is ready to take effect.\n\n- **RUNNING**: The task is running.\n\n- **ENDED**: The task has ended."
      }
    },
    {
      "name": "taskId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "流量调控任务ID。",
        "en": "The flow control task ID."
      }
    }
