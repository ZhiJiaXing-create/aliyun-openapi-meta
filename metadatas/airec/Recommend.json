{
  "name": "Recommend",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v2/openapi/instances/[instanceId]/actions/recommend",
  "parameters": [
    {
      "name": "filter",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "推荐过滤字符串",
        "en": "The filter string for recommendations."
      }
    },
    {
      "name": "imei",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备ID",
        "en": "The device ID."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID",
        "en": "The instance ID."
      }
    },
    {
      "name": "ip",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户最后登录的IP",
        "en": "The IP address of the user's last logon."
      }
    },
    {
      "name": "items",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用于相关推荐的item（限于相关推荐场景使用）",
        "en": "The item used for related recommendations. This parameter applies only to related recommendation scenarios."
      }
    },
    {
      "name": "rankOpen",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "召回排序阶段是否根据用户ID个性化排序",
        "en": "Specifies whether to personalize the sorting based on the user ID during the recall and ranking phase."
      }
    },
    {
      "name": "recType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "推荐服务类型",
        "en": "The type of the recommendation service."
      }
    },
    {
      "name": "returnCount",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "返回结果条数（0-50之间）",
        "en": "The number of results to return. Valid values: 0 to 50."
      }
    },
    {
      "name": "sceneId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "物品被投放的场景ID",
        "en": "The ID of the scene where items are delivered."
      }
    },
    {
      "name": "serviceType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "略",
        "en": "Omitted."
      }
    },
    {
      "name": "strategy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "如果需要使用坑位策略，请求参数内新增strategy=\"fixedSlot\"，此时系统将按照坑位配置返回推荐结果",
        "en": "If you want to use a fixed-slot policy, add the strategy parameter with a value of fixedSlot to the request parameters. The system then returns recommendation results based on the slot configuration."
      }
    },
    {
      "name": "userId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户唯一ID",
        "en": "The unique ID of the user."
      }
    },
    {
      "name": "userInfo",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "略",
        "en": "Omitted."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "智能推荐",
    "en": "Intelligent recommendation"
  }
}