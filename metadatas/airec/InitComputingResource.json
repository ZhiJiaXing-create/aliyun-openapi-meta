      "description": {
        "zh": "实例id",
        "en": "The ID of the instance."
      }
    },
    {
      "name": "key",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "type=MAX_COMPUTE则为mc工作空间名称",
        "en": "The name of the MaxCompute workspace. This parameter is required when type is set to MAX\\_COMPUTE."
      }
    },
    {
      "name": "type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源类型，本期固定为：MAX_COMPUTE",
        "en": "The type of the computing resource. The value must be MAX\\_COMPUTE."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
