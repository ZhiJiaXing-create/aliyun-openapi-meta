{
  "name": "InitComputingResource",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/v2/openapi/instances/[instanceId]/computing-resources/actions/init",
  "parameters": [
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
