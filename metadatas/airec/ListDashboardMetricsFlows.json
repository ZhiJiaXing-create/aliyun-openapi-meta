{
  "name": "ListDashboardMetricsFlows",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v2/openapi/instances/[instanceId]/dashboard/metrics/flows",
  "parameters": [
    {
      "name": "endTime",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "秒级时间戳",
        "en": "The UNIX timestamp in seconds."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "metricType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "指标类型\n\nUSER_ACTION_PV_COUNT 整体流量规模PV\n\nUSER_ACTION_UV_COUNT 整体流量规模UV\n\nUSER_ACTION_PV_RATIO  流量转化率\n\nUSER_ACTION_UV_RATIO 人均流量",
        "en": "The metric type.\n\nUSER\\_ACTION\\_PV\\_COUNT: The total number of page views (PVs).\n\nUSER\\_ACTION\\_UV\\_COUNT: The total number of unique visitors (UVs).\n\nUSER\\_ACTION\\_PV\\_RATIO: The traffic conversion rate.\n\nUSER\\_ACTION\\_UV\\_RATIO: The traffic per capita."
      }
    },
    {
      "name": "startTime",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "秒级时间戳",
        "en": "The UNIX timestamp in seconds."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询指定实例的整理仪表盘流量数据",
    "en": "ListDashboardMetricsFlows"
  }
}