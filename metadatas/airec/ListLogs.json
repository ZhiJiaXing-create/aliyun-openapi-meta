  "parameters": [
    {
      "name": "endTime",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "结束时间 （秒级时间戳）",
        "en": "The end time. This is a UNIX timestamp in seconds."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "page",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页数，默认1",
        "en": "The page number. The default value is 1."
      }
    },
    {
      "name": "queryParams",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "查询条件:\nkey1:value1;key2:value;\n例如：requestId:xxxx;requestUri:xxx;",
        "en": "The query conditions. Format: key1:value1;key2:value. For example: requestId:xxxx;requestUri:xxx."
