{
  "name": "CloneExperiment",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/v2/openapi/instances/[instanceId]/scenes/[sceneId]/experiments/[experimentId]/actions/clone",
  "parameters": [
    {
      "name": "dryRun",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否完成克隆。\n\n取值：\n\n- **true**：校验实验信息。\n\n- **false**：默认false,创建实验。",
        "en": "true: verifies experiment information. false (default): creates an experiment."
      }
    },
    {
      "name": "experimentId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实验ID。",
        "en": "The experiment ID."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "sceneId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "场景ID。",
        "en": "The scene ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "克隆实验",
    "en": "CloneExperiment"
  }
}