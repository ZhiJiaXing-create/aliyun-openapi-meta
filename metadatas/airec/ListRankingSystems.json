{
  "name": "ListRankingSystems",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v2/openapi/instances/[instanceId]/ranking-systems",
  "parameters": [
    {
      "name": "deployStatus",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "查询部署状态：\nNOT_DEPLOYED 未部署\nDEPLOY_SUCCESS 部署成功",
        "en": "The name of the ranking service."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例ID",
        "en": "Queries the list of ranking services."
      }
    },
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序服务名称",
        "en": "The ID of the instance."
      }
    },
    {
      "name": "page",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页，页码",
        "en": "The state of the deployment. Valid values: NOT_DEPLOYED: The ranking service is not deployed. DEPLOY_SUCCESS: The ranking service is deployed."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页，大小",
        "en": "The number of the page to return."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取排序服务列表",
    "en": "ListRankingSystems"
  }
}