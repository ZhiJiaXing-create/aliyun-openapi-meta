{
  "name": "GetHistoryListByBizType",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/[workspaceId]/api/history/list",
  "parameters": [
    {
      "name": "bizId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务唯一标识，当bizType为LibraryChat时，bizId指的是文档库id",
        "en": "Unique business identifier. When bizType is LibraryChat, bizId is the document library ID."
      }
    },
    {
      "name": "bizType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务类型，目前支持：模型问答（LlmChat）、文档库问答（LibraryChat）",
        "en": "Business type. Supported values are LlmChat and LibraryChat."
      }
    },
    {
      "name": "page",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码",
        "en": "Page number"
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页面大小",
        "en": "Number of records per page"
      }
    },
    {
      "name": "workspaceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务空间Id",
        "en": "Workspace ID"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "根据业务类型获取对话历史记录",
    "en": "Retrieve conversation history by business type"
  }
}