{
  "name": "ListInstanceAcl",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/instances/[instanceId]/acl",
  "parameters": [
    {
      "name": "filter",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "查询的过滤条件，若不输入则查询所有权限。",
        "en": "The condition that you specify to filter the ACLs. If you do not specify this parameter, all ACLs are queried."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID",
        "en": "The instance ID."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "当前页码，从1开始。",
        "en": "The page number. Pages start from page 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页大小，每页最多显示的返回结果数量。",
        "en": "The number of entries per page."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询访问权限列表",
    "en": "ListInstanceAcl"
  },
  "example": {
    "unifiedCli": "aliyun rocketmq list-instance-acl --instance-id rmq-cn-7e22ody0000 --page-number 1 --page-size 10 --filter CID-TEST --region cn-hangzhou",
    "legacyCli": "aliyun rocketmq GET /instances/rmq-cn-7e22ody0000/acl --region cn-hangzhou --filter 'CID-TEST' --pageNumber 1 --pageSize 10 --header \"Content-Type=application/json\""
  }
}