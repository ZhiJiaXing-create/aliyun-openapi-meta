{
  "name": "Associate",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentKey",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "业务空间key，不传时访问默认业务空间，key值在主账号业务管理页面获取"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "机器人实例ID"
      }
    },
    {
      "name": "Perspective",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "视角"
      }
    },
    {
      "name": "RecommendNum",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "推荐问题数量，1-10，当出推荐的时候才生效，返回不大于RecommendN"
      }
    },
    {
      "name": "SessionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "会话ID，用于标识一个访问者的会话和保持上下文信息。对于一个新的访问者，首次调用Chat接口时无需传递此字段，机器人会开启一个会话，并在Chat接口的响应中返回该会话的SessionId。对于该访问者的后续轮次的会话，调用Chat接口时传递当前会话的SessionId，机器人即可基于SessionId继续该轮次会话。"
      }
    },
    {
      "name": "Utterance",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "用户表述"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "给出推荐",
    "en": "Associate"
  }
}