{
  "name": "Chat",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentKey",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "业务空间key，不传时访问默认业务空间，key值在主账号业务管理页面获取"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "机器人实例ID"
      }
    },
    {
      "name": "IntentName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "意图名称，当不需要理解用户话术而直接开启某一个意图时，可以指定意图名称"
      }
    },
    {
      "name": "KnowledgeId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "知识id"
      }
    },
    {
      "name": "Perspective",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "视⻆编码，⽤于调⽤同⼀知识标题下不同视⻆的答案。在拼装请求参数时，需要以 Perspective.1={视⻆编码}的格式传递参数。 如： &Perspective.1=FZJBY3raWr。使⽤SDK时 以SDK中定义的参数为 准。⽬前仅⽀持⼀个视⻆答案的调⽤（公有云）。"
      }
    },
    {
      "name": "SenderId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "访问者ID。⽤于识别当前会话中的⽤户"
      }
    },
    {
      "name": "SenderNick",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "当前会话中访问的昵称"
      }
    },
    {
      "name": "SessionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "会话ID，⽤于标识⼀个访问者的会话和保持上下⽂信息。对于⼀个新的访问者，⾸次调⽤ Chat接⼝时⽆需传递此字段，机器⼈会开启⼀个会话，并在Chat接⼝的响应中返回该会话的 SessionId。对于该访问者的后续轮次的会 话，调⽤Chat接⼝时传递当前会话的 SessionId，机器⼈即可基于SessionId继续该轮次会话。"
      }
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "可以传递任何内容参数，该参数将会直接在返回结果中透传回来。"
      }
    },
    {
      "name": "Utterance",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "用户表述"
      }
    },
    {
      "name": "VendorParam",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "业务自定义扩展参数，可以在对话工厂中直接引用到，通常为一个JSON格式字符串。例如，{\"var1\":\"value1\"}，在对话工厂中即可以通过${VENDOR_PARAM.var1}获取到value1"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "进行问答"
  }
}