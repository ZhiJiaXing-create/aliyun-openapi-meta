{
  "name": "GetFunctionCode",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2021-04-06/services/[serviceName]/functions/[functionName]/code",
  "parameters": [
    {
      "name": "X-Fc-Account-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "您的阿里云账号（主账号）ID。",
        "en": "The ID of your Alibaba Cloud account."
      }
    },
    {
      "name": "X-Fc-Date",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "函数的调用开始日期，格式为**EEE,d MMM yyyy HH:mm:ss GMT**。",
        "en": "The time on which the function is invoked. The format of the value is: **EEE,d MMM yyyy HH:mm:ss GMT**."
      }
    },
    {
      "name": "X-Fc-Trace-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "自定义请求ID。",
        "en": "The custom request ID."
      }
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "函数名称。",
        "en": "The name of the function."
      }
    },
    {
      "name": "qualifier",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "服务的版本ID或者别名。",
        "en": "The version or alias of the service."
      }
    },
    {
      "name": "serviceName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务名称。",
        "en": "The name of the service."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取函数代码包",
    "en": "GetFunctionCode"
  },
  "example": {
    "unifiedCli": "aliyun fc-open get-function-code --service-name demoService --function-name demoFunction --qualifier demoQualifier --x-fc-account-id 1880770869020000 --x-fc-date Wed,_11_May_2022_09:00:00_GMT --x-fc-trace-id rid281s000000 --api-version 2021-04-06 --region cn-hangzhou",
    "legacyCli": "aliyun fc-open GET /2021-04-06/services/demoService/functions/demoFunction/code --region cn-hangzhou --qualifier demoQualifier --header \"X-Fc-Date=Wed,_11_May_2022_09:00:00_GMT\" --header \"X-Fc-Trace-Id=rid281s000000\" --header \"X-Fc-Account-Id=1880770869020000\" --header \"Content-Type=application/json\""
  }
}