{
  "name": "DeleteLayerVersion",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/2021-04-06/layers/[layerName]/versions/[version]",
  "parameters": [
    {
      "name": "X-Fc-Account-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "您的阿里云账号（主账号）ID。",
        "en": "The ID of your Alibaba Cloud account."
      }
    },
    {
      "name": "X-Fc-Date",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "函数的调用开始日期，格式为**EEE,d MMM yyyy HH:mm:ss GMT**。",
        "en": "The time when the function is invoked. The value is in the **EEE,d MMM yyyy HH:mm:ss GMT** format."
      }
    },
    {
      "name": "X-Fc-Trace-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求的调用链ID。",
        "en": "The trace ID of the request for Function Compute API."
      }
    },
    {
      "name": "layerName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "层的名称。",
        "en": "The name of the layer."
      }
    },
    {
      "name": "version",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "层的版本。",
        "en": "The layer version."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "删除层配置",
    "en": "DeleteLayerVersion"
  },
  "example": {
    "unifiedCli": "aliyun fc-open delete-layer-version --layer-name MyLayer --biz-version 1 --x-fc-account-id 1880770869020000 --x-fc-date Wed,_11_May_2022_09:00:00_GMT --x-fc-trace-id asdf0000 --api-version 2021-04-06 --region cn-hangzhou",
    "legacyCli": "aliyun fc-open DELETE /2021-04-06/layers/MyLayer/versions/1 --region cn-hangzhou --header \"X-Fc-Date=Wed,_11_May_2022_09:00:00_GMT\" --header \"X-Fc-Trace-Id=asdf0000\" --header \"X-Fc-Account-Id=1880770869020000\" --header \"Content-Type=application/json\""
  }
}