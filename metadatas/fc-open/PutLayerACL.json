{
  "name": "PutLayerACL",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/2021-04-06/layers/[layerName]/acl",
  "parameters": [
    {
      "name": "X-Fc-Account-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "您的阿里云账号（主账号）ID。",
        "en": "The ID of your Alibaba Cloud account."
      }
    },
    {
      "name": "X-Fc-Date",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "API调用时间，格式为**EEE,d MMM yyyy HH:mm:ss GMT**。",
        "en": "The time when the operation is called. The format is: **EEE,d MMM yyyy HH:mm:ss GMT**."
      }
    },
    {
      "name": "X-Fc-Trace-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求的调用链ID。",
        "en": "The trace ID of the request for Function Compute API."
      }
    },
    {
      "name": "layerName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "层的名称。",
        "en": "The name of the layer."
      }
    },
    {
      "name": "public",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否公开。\n- **true**：公开。\n- **false**：不公开。",
        "en": "Specifies whether the layer is public.\n\n*   **true**: Public.\n*   **false**: Not public."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "设置层的权限",
    "en": "PutLayerACL"
  },
  "example": {
    "unifiedCli": "aliyun fc-open put-layer-acl --layer-name MyLayer --public true --x-fc-account-id 1880770869020000 --x-fc-date Wed,_11_May_2022_09:00:00_GMT --x-fc-trace-id asdf0000 --api-version 2021-04-06 --region cn-hangzhou",
    "legacyCli": "aliyun fc-open PUT /2021-04-06/layers/MyLayer/acl --region cn-hangzhou --public true --header \"X-Fc-Date=Wed,_11_May_2022_09:00:00_GMT\" --header \"X-Fc-Trace-Id=asdf0000\" --header \"X-Fc-Account-Id=1880770869020000\" --header \"Content-Type=application/json\""
  }
}