{
  "name": "GetAlias",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2021-04-06/services/[serviceName]/aliases/[aliasName]",
  "parameters": [
    {
      "name": "X-Fc-Account-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "您的阿里云账号（主账号）ID。",
        "en": "The ID of your Alibaba Cloud account."
      }
    },
    {
      "name": "X-Fc-Date",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "函数的调用开始日期，格式为**EEE,d MMM yyyy HH:mm:ss GMT**。",
        "en": "The time on which the function is invoked. The format of the value is: **EEE,d MMM yyyy HH:mm:ss GMT**."
      }
    },
    {
      "name": "X-Fc-Trace-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "函数计算调用请求的调用链ID。",
        "en": "The trace ID of the invocation request of Function Compute."
      }
    },
    {
      "name": "aliasName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "别名的名称。",
        "en": "The name of the alias."
      }
    },
    {
      "name": "serviceName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务的名称。",
        "en": "The name of the service."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询别名",
    "en": "GetAlias"
  },
  "example": {
    "unifiedCli": "aliyun fc-open get-alias --service-name service_name --alias-name alias_test --x-fc-account-id 1880770869020000 --x-fc-date Wed,_11_May_2022_09:00:00_GMT --x-fc-trace-id r4isu4sls0000 --api-version 2021-04-06 --region cn-hangzhou",
    "legacyCli": "aliyun fc-open GET /2021-04-06/services/service_name/aliases/alias_test --region cn-hangzhou --header \"X-Fc-Date=Wed,_11_May_2022_09:00:00_GMT\" --header \"X-Fc-Trace-Id=r4isu4sls0000\" --header \"X-Fc-Account-Id=1880770869020000\" --header \"Content-Type=application/json\""
  }
}