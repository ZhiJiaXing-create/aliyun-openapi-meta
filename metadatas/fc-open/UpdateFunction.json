{
  "name": "UpdateFunction",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/2021-04-06/services/[serviceName]/functions/[functionName]",
  "parameters": [
    {
      "name": "If-Match",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用于确保实际更改的资源和期望更改的资源是一致的，该值来自[CreateFunction](~~415747~~)、[GetFunction](~~415750~~)和[UpdateFunction](~~415749~~)的响应。",
        "en": "Used to ensure that the resource to be modified is the same as the expected resource. The value is obtained from the response of the [CreateFunction](~~415747~~), [GetFunction](~~415750~~), or [UpdateFunction](~~415749~~) operation."
      }
    },
    {
      "name": "X-Fc-Account-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "您的阿里云账号（主账号）ID。",
        "en": "The ID of your Alibaba Cloud account."
      }
    },
    {
      "name": "X-Fc-Code-Checksum",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "函数代码包的CRC-64值。",
        "en": "The CRC-64 value of the function code package."
      }
    },
    {
      "name": "X-Fc-Date",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "函数的调用开始日期，格式为**EEE,d MMM yyyy HH:mm:ss GMT**。",
        "en": "The start date of the function call. The format is **EEE,d MMM yyyy HH:mm:ss GMT**."
      }
    },
    {
      "name": "X-Fc-Trace-Id",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "调用函数的ID，与返回参数requestId对应。",
        "en": "The ID used to call the function. It corresponds to the `requestId` parameter in the response."
      }
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "函数名称。",
        "en": "The name of the function."
      }
    },
    {
      "name": "functionUpdateFields",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "更新函数结构体。",
        "en": "The function update struct."
      }
    },
    {
      "name": "serviceName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务名称。",
        "en": "The name of the service."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新函数",
    "en": "UpdateFunction"
  },
  "example": {
    "unifiedCli": "aliyun fc-open update-function --if-match e19d5cd5af0378da05f63f891c7467af --service-name demoService --function-name demoFunction --x-fc-account-id 1880770869020000 --x-fc-code-checksum 1506052139770049xxxx --x-fc-date Wed,_11_May_2022_09:00:00_GMT --x-fc-trace-id test-trace-id --api-version 2021-04-06 --region cn-hangzhou",
    "legacyCli": "aliyun fc-open PUT /2021-04-06/services/demoService/functions/demoFunction --region cn-hangzhou --header \"X-Fc-Date=Wed,_11_May_2022_09:00:00_GMT\" --header \"X-Fc-Code-Checksum=1506052139770049xxxx\" --header \"X-Fc-Trace-Id=test-trace-id\" --header \"If-Match=e19d5cd5af0378da05f63f891c7467af\" --header \"X-Fc-Account-Id=1880770869020000\" --header \"Content-Type=application/json\" --body {\"customRuntimeConfig\":\"example-string\",\"handler\":\"index.handler\",\"code\":\"example-string\",\"instanceLifecycleConfig\":\"example-string\",\"instanceType\":\"e1\",\"instanceSoftConcurrency\":5,\"description\":\"test_desc\",\"runtime\":\"python3.9\",\"cpu\":1.5,\"customContainerConfig\":\"example-string\",\"timeout\":60,\"initializer\":\"index.handler\",\"initializationTimeout\":60,\"diskSize\":512,\"memorySize\":512,\"caPort\":9000,\"customDNS\":\"example-string\",\"environmentVariables\":{\"key\":\"example-string\"},\"customHealthCheckConfig\":\"example-string\",\"gpuMemorySize\":2048,\"layers\":[\"layername\"],\"InstanceConcurrency\":10}"
  }
}