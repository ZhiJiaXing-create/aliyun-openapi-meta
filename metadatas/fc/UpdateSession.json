{
  "name": "UpdateSession",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/2023-03-30/functions/[functionName]/sessions/[sessionId]",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "会话更新配置",
        "en": "The session update configuration."
      }
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Session所属的函数名称",
        "en": "The name of the function to which the session belongs."
      }
    },
    {
      "name": "qualifier",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "待更新的SessionID关联的函数别名或版本信息",
        "en": "The function alias or version associated with the session ID to update."
      }
    },
    {
      "name": "sessionId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "待更新的会话ID值",
        "en": "The ID of the session to update."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新会话配置",
    "en": "Update session configuration"
  },
  "example": {
    "unifiedCli": "aliyun fc update-session --function-name my-func --session-id test-sessionid-1 --qualifier aliasName1 --region cn-hangzhou",
    "legacyCli": "aliyun fc PUT /2023-03-30/functions/my-func/sessions/test-sessionid-1 --region cn-hangzhou --qualifier aliasName1 --header \"Content-Type=application/json\" --body \"example-string\""
  }
}