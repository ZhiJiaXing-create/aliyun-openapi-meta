{
  "name": "PutLayerACL",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/2023-03-30/layers/[layerName]/acl",
  "parameters": [
    {
      "name": "acl",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设置层的访问权限，1：公开，0：私有，默认为私有",
        "en": "The access permissions of the layer. Valid values: 1 (public) and 0 (private). The default value is 0."
      }
    },
    {
      "name": "layerName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "层名称",
        "en": "The name of the layer."
      }
    },
    {
      "name": "public",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "是否公开层。true或者false。",
        "en": "Specifies whether to make the layer public. Valid values: true and false."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "设置层访问权限",
    "en": "PutLayerACL"
  },
  "example": {
    "unifiedCli": "aliyun fc put-layer-acl --layer-name my-layer --public true --acl 1 --region cn-hangzhou",
    "legacyCli": "aliyun fc PUT /2023-03-30/layers/my-layer/acl --region cn-hangzhou --public true --acl 1 --header \"Content-Type=application/json\""
  }
}