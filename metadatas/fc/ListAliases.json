{
  "name": "ListAliases",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/functions/[functionName]/aliases",
  "parameters": [
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "函数名称",
        "en": "The function name."
      }
    },
    {
      "name": "limit",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "返回的别名数量",
        "en": "The number of aliases to return."
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "分页起始标记",
        "en": "The token that marks the start of the next page of results."
      }
    },
    {
      "name": "prefix",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "别名名称前缀",
        "en": "The prefix of the alias name."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出别名",
    "en": "ListAliases"
  },
  "example": {
    "unifiedCli": "aliyun fc list-aliases --function-name my-func --prefix my-alias --next-token MTIzNCNhYmM= --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/functions/my-func/aliases --region cn-hangzhou --prefix 'my-alias' --nextToken 'MTIzNCNhYmM=' --limit 10 --header \"Content-Type=application/json\""
  }
}