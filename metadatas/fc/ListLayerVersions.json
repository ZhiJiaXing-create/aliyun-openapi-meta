{
  "name": "ListLayerVersions",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/layers/[layerName]/versions",
  "parameters": [
    {
      "name": "layerName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "层名称",
        "en": "The layer name."
      }
    },
    {
      "name": "limit",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "返回的版本数量",
        "en": "The number of versions to return."
      }
    },
    {
      "name": "startVersion",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "起始版本",
        "en": "The version from which to start the query."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出层版本",
    "en": "ListLayerVersions"
  },
  "example": {
    "unifiedCli": "aliyun fc list-layer-versions --layer-name my-layer --start-version 1 --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/layers/my-layer/versions --region cn-hangzhou --startVersion 1 --limit 10 --header \"Content-Type=application/json\""
  }
}