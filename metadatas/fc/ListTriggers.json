{
  "name": "ListTriggers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/functions/[functionName]/triggers",
  "parameters": [
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "函数名称",
        "en": "The function name."
      }
    },
    {
      "name": "limit",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "返回的触发器数量",
        "en": "The number of triggers to return."
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "分页起始标记",
        "en": "The token that marks the start of the next page of results."
      }
    },
    {
      "name": "prefix",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "触发器名称前缀",
        "en": "The trigger name prefix."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出触发器",
    "en": "ListTriggers"
  },
  "example": {
    "unifiedCli": "aliyun fc list-triggers --function-name my-func --prefix my-trigger --next-token MTIzNCNhYmM= --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/functions/my-func/triggers --region cn-hangzhou --prefix 'my-trigger' --nextToken 'MTIzNCNhYmM=' --limit 10 --header \"Content-Type=application/json\""
  }
}