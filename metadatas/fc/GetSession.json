{
  "name": "GetSession",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/functions/[functionName]/sessions/[sessionId]",
  "parameters": [
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "会话所属函数名称",
        "en": "The name of the function to which the session belongs."
      }
    },
    {
      "name": "qualifier",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "查询的会话ID关联的函数别名或版本信息",
        "en": "The function alias or version associated with the session ID to query."
      }
    },
    {
      "name": "sessionId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "查询的会话ID值",
        "en": "The ID of the session to query."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取会话配置信息",
    "en": "Get session configuration information"
  },
  "example": {
    "unifiedCli": "aliyun fc get-session --function-name myFunction --session-id test-sessionid-index1 --qualifier aliasName1 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/functions/myFunction/sessions/test-sessionid-index1 --region cn-hangzhou --qualifier aliasName1 --header \"Content-Type=application/json\""
  }
}