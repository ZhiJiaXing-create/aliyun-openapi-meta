{
  "name": "ListFunctionVersions",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/functions/[functionName]/versions",
  "parameters": [
    {
      "name": "direction",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "版本排序方式。BACKWARD或者FORWARD。",
        "en": "The order in which to sort the versions. Valid values: BACKWARD and FORWARD."
      }
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "函数名称",
        "en": "The function name."
      }
    },
    {
      "name": "limit",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "返回的版本数量",
        "en": "The number of versions to return."
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "分页起始标记",
        "en": "The token that marks the start of the next page of results."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出函数版本",
    "en": "ListFunctionVersions"
  },
  "example": {
    "unifiedCli": "aliyun fc list-function-versions --function-name my-func --next-token MTIzNCNhYmM= --direction BACKWARD --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/functions/my-func/versions --region cn-hangzhou --nextToken 'MTIzNCNhYmM=' --limit 10 --direction BACKWARD --header \"Content-Type=application/json\""
  }
}