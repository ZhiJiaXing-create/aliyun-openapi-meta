      "required": false,
      "description": {
        "zh": "用于指定Sesion所属的版本或别名",
        "en": "The version or alias of the function to which the session belongs."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "创建会话资源",
    "en": "Create a session resource"
  },
  "example": {
    "unifiedCli": "aliyun fc create-session --function-name my-func --qualifier aliasName1 --region cn-hangzhou",
    "legacyCli": "aliyun fc POST /2023-03-30/functions/my-func/sessions --region cn-hangzhou --qualifier aliasName1 --header \"Content-Type=application/json\" --body \"example-string\""
