      "description": {
        "zh": "创建会话配置",
        "en": "The session configuration."
      }
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "创建Session的函数名称",
        "en": "The name of the function for which to create the session."
      }
    },
    {
      "name": "qualifier",
      "position": "Query",
