      "description": {
        "zh": "实例所在地域。"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查看自定义地址"
  },
  "descriptions": {
    "zh": "该接口用于获取用户已配置的自定义终端节点（Endpoint）列表，便于管理和查看私有连接或VPC终端服务的设置。",
    "en": "该接口用于获取用户已配置的自定义终端节点（Endpoint）列表，便于管理和查看私有连接或VPC终端服务的设置。"
  },
  "example": {
    "unifiedCli": "aliyun polardbx describe-db-instance-endpoint --biz-region-id cn-hangzhou --db-instance-name pxc-hzjasd0000 --max-results 1000 --next-token xxdds --region cn-hangzhou",
    "legacyCli": "aliyun polardbx DescribeDBInstanceEndpoint --region cn-hangzhou --NextToken xxdds --MaxResults 1000 --RegionId 'cn-hangzhou' --DBInstanceName 'pxc-hzjasd0000'"
