{
  "name": "TagResources",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "地域",
        "en": "The region ID."
      }
    },
    {
      "name": "ResourceId",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "description": {
        "zh": "资源ID,最多 50个子项",
        "en": "The resource IDs. You can specify up to 50 resource IDs."
      }
    },
    {
      "name": "ResourceType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "资源类型,必须为：PolarDBXInstance",
        "en": "The resource type. Set this parameter to PolarDBXInstance."
      }
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "description": {
        "zh": "标签列表，最多包含20个子项",
        "en": "The tags. You can specify up to 20 tags."
      },
      "sub_parameters": [
        {
          "name": "Key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键",
            "en": "The tag key."
          }
        },
        {
          "name": "Value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值",
            "en": "The tag value."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "为资源打标签",
    "en": "Add tags to resources"
  },
  "example": {
    "unifiedCli": "aliyun polardbx tag-resources --biz-region-id cn-hangzhou --resource-type PolarDBXInstance --resource-id pxc-xxxxx --tag Value=22 Key=12 --region cn-hangzhou",
    "legacyCli": "aliyun polardbx TagResources --region cn-hangzhou --ResourceId.1 'pxc-xxxxx' --Tag.1.Key 12 --Tag.1.Value 22 --ResourceType PolarDBXInstance --RegionId 'cn-hangzhou'"
  }
}