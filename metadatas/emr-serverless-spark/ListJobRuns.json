{
  "name": "ListJobRuns",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/workspaces/[workspaceId]/jobRuns",
  "parameters": [
    {
      "name": "applicationConfigs",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "spark配置。",
        "en": "The Spark configurations."
      }
    },
    {
      "name": "creator",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "创建用户UID。",
        "en": "The UID of the user who created the job."
      }
    },
    {
      "name": "endTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务结束时间范围。",
        "en": "The time range when the job run ended."
      }
    },
    {
      "name": "isWorkflow",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "是否为工作流任务。",
        "en": "Specifies whether the job is a workflow task."
      }
    },
    {
      "name": "jobRunDeploymentId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "流任务部署的任务ID。",
        "en": "The deployment ID of the streaming job."
      }
    },
    {
      "name": "jobRunId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务ID。",
        "en": "The job run ID."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "一次获取的最大记录数，最大不超过100。",
        "en": "The maximum number of entries to return. The maximum value is 100."
      }
    },
    {
      "name": "minDuration",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "任务执行时长的最小值，单位ms。",
        "en": "The minimum runtime of the job run, in milliseconds."
      }
    },
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务名称。",
        "en": "The job name."
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "标记当前开始读取的位置。",
        "en": "The token that specifies the position from which to start the next read."
      }
    },
    {
      "name": "regionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "地域ID。",
        "en": "The region ID."
      }
    },
    {
      "name": "resourceQueueId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Spark任务运行的资源队列名称。",
        "en": "The ID of the resource queue on which the Spark job runs."
      }
    },
    {
      "name": "runtimeConfigs",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "运行配置。",
        "en": "The runtime configurations."
      }
    },
    {
      "name": "startTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务开始时间范围。",
        "en": "The time range when the job run started."
      }
    },
    {
      "name": "states",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "任务状态。",
        "en": "The job run states."
      }
    },
    {
      "name": "tags",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "标签列表。",
        "en": "The list of tags."
      },
      "sub_parameters": [
        {
          "name": "key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键。",
            "en": "The tag key."
          }
        },
        {
          "name": "value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值。",
            "en": "The tag value."
          }
        }
      ]
    },
    {
      "name": "workspaceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取Spark任务列表",
    "en": "ListJobRuns"
  }
}