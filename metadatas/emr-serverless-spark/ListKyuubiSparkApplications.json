  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/kyuubi/[workspaceId]/[kyuubiServiceId]/applications",
  "parameters": [
    {
      "name": "applicationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Kyuubi提交的Spark应用ID，用于搜索。",
        "en": "The ID of the Spark application submitted by Kyuubi, used for searching."
      }
    },
    {
      "name": "applicationName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Kyuubi提交的Spark应用名，用于搜索。",
        "en": "The name of the Spark application submitted by Kyuubi, used for searching."
      }
    },
    {
      "name": "endTime",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "kyuubiServiceId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Kyuubi服务ID。",
        "en": "The Kyuubi service ID."
      }
    },
    {
      "name": "latestSqlStatementStatuses",
      "position": "Query",
      "type": "String",
