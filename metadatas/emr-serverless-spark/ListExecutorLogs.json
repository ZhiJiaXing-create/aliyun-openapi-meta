{
  "name": "ListExecutorLogs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/workspaces/[workspaceId]/jobRuns/[jobRunId]/executors/[executorId]/logs",
  "parameters": [
    {
      "name": "executorId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "作业Executor ID。",
        "en": "The ID of the job executor."
      }
    },
    {
      "name": "jobRunId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务运行ID。",
        "en": "The ID of the job run."
      }
    },
    {
      "name": "logType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "日志类型。",
        "en": "The type of log. Only logs of this type are returned."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "一次获取的最大记录数。",
        "en": "The maximum number of results to return per page. Valid values: 1 to 100. Default value: 20."
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "下一页TOKEN。",
        "en": "The pagination token. This is the `nextToken` from a previously truncated response."
      }
    },
    {
      "name": "regionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "区域ID。",
        "en": "The ID of the region."
      }
    },
    {
      "name": "workspaceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The ID of the workspace."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取Spark作业日志",
    "en": "ListExecutorLogs"
  }
}