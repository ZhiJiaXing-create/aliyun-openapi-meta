{
  "name": "ListWorkspaces",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/workspaces",
  "parameters": [
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "一次获取的最大记录数。",
        "en": "The maximum number of results per page."
      }
    },
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作空间的名称，支持根据工作空间名称进行模糊搜索。",
        "en": "The name of the workspace. Fuzzy search is supported."
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "标记当前开始读取的位置。",
        "en": "The token for the next page of results."
      }
    },
    {
      "name": "regionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "区域ID。",
        "en": "The ID of the region."
      }
    },
    {
      "name": "resourceGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "en": "The ID of the resource group."
      }
    },
    {
      "name": "state",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作空间状态",
        "en": "The state of the workspace."
      }
    },
    {
      "name": "tag",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "标签值。",
        "en": "Filters the results by one or more tags."
      },
      "sub_parameters": [
        {
          "name": "key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键。",
            "en": "The tag key."
          }
        },
        {
          "name": "value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值。",
            "en": "The tag value."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取工作空间列表",
    "en": "ListWorkspaces"
  }
}