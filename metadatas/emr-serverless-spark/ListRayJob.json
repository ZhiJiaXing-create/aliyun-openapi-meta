{
  "name": "ListRayJob",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/workspaces/[workspaceId]/rayJob",
  "parameters": [
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Ray Job的名称（精确搜索）。",
        "en": "The name of the Ray Job (exact match)."
      }
    },
    {
      "name": "pageNum",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认值：1。",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "返回结果的分页数。默认值：20。",
        "en": "The number of entries per page. Default value: 20."
      }
    },
    {
      "name": "submissionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Ray Job的提交id。",
        "en": "The submission ID of the Ray Job."
      }
    },
    {
      "name": "submitTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "提交时间范围。",
        "en": "The submit time range."
      }
    },
    {
      "name": "taskBizId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据开发任务ID。",
        "en": "The data development node ID."
      }
    },
    {
      "name": "workspaceId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出Ray Job信息。",
    "en": "List ray job information"
  }
}