{
  "name": "GetRegistryModuleVersion",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/registryModuleVersion/[namespaceName]/[moduleName]/[version]",
  "parameters": [
    {
      "name": "moduleName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "模板名称",
        "en": "The template name."
      }
    },
    {
      "name": "namespaceName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间名称",
        "en": "The workspace name."
      }
    },
    {
      "name": "version",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "版本号",
        "en": "The version number."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询Registry模板版本",
    "en": "Query a registry template version"
  },
  "descriptions": {
    "zh": "单用户调用频率：200 次/秒。",
    "en": "Single-user call frequency: 200 calls per second."
  },
  "example": {
    "unifiedCli": "aliyun iacservice get-registry-module-version --namespace-name NamespaceName --module-name ModuleName --biz-version 1.1.0 --api-version 2021-08-06 --region cn-hangzhou",
    "legacyCli": "aliyun iacservice GET /registryModuleVersion/NamespaceName/ModuleName/1.1.0 --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}