{
  "name": "ListProject",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/project",
  "parameters": [
    {
      "name": "keyword",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "搜索关键词，支持名称搜索。",
        "en": "The search keyword. Name-based search is supported."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "页码，默认1。",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "每页返回的结果数量。默认值：20，最小值：1，最大值：100。",
        "en": "The number of results per page. Default value: 20. Minimum value: 1. Maximum value: 100."
      }
    },
    {
      "name": "tag",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "标签列表。",
        "en": "The list of tags."
      },
      "sub_parameters": [
        {
          "name": "key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键",
            "en": "The tag key."
          }
        },
        {
          "name": "value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值",
            "en": "The tag value."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取项目列表",
    "en": "List projects"
  },
  "example": {
    "unifiedCli": "aliyun iacservice list-project --page-size 10 --page-number 1 --tag value=name key=key --keyword test-case2 --api-version 2021-08-06 --region cn-hangzhou",
    "legacyCli": "aliyun iacservice GET /project --region cn-hangzhou --pageNumber 1 --pageSize 10 --tag '[{\"value\":\"name\",\"key\":\"key\"}]' --keyword 'test-case2' --header \"Content-Type=application/json\""
  }
}