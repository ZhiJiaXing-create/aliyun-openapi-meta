{
  "name": "ListEvalResults",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/PAILLMTrace/eval/results",
  "parameters": [
    {
      "name": "EvaluationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "链路数据所属的评估任务的任务id。",
        "en": "The ID of the evaluation task. Will return the latest evaluation result if this ID not provied."
      }
    },
    {
      "name": "Keyword",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "查询关键字，在评估输入数据里查询。",
        "en": "The search key word."
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页查询时设置的页码。 起始值：1。默认值：1。",
        "en": "The number of the page to return.\n- Pages start from page 1.\n- Default value: 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页大小，默认值10，最大值50。",
        "en": "Page size, default is 10."
      }
    },
    {
      "name": "RecordIds",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "链路数据id列表。",
        "en": "The IDs of the traces."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取链路数据评估结果",
    "en": "Retrieve Trace Assessment Results"
  },
  "example": {
    "unifiedCli": "aliyun paillmtrace list-eval-results --record-ids 7423034a494ca17c16443ffd16336981 --page-number 1 --page-size 10 --evaluation-id 0bb05ae2a2dc11ef9757faaa2a1ec0c6 --keyword foo --region cn-hangzhou",
    "legacyCli": "aliyun paillmtrace GET /api/v1/PAILLMTrace/eval/results --region cn-hangzhou --PageSize 10 --Keyword foo --PageNumber 1 --EvaluationId 0bb05ae2a2dc11ef9757faaa2a1ec0c6 --RecordIds 7423034a494ca17c16443ffd16336981 --header \"Content-Type=application/json\""
  }
}