{
  "name": "ListKnowledgeBaseChunks",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/langstudio/knowledgebases/[KnowledgeBaseId]/knowledgebasechunks",
  "parameters": [
    {
      "name": "ChunkStatus",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "切片状态。\n- Enable: 有效。\n- Disable: 无效。",
        "en": "Segment status.  \n- Enable: Valid.  \n- Disable: Invalid."
      }
    },
    {
      "name": "KnowledgeBaseId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "知识库ID。",
        "en": "Knowledge base ID."
      }
    },
    {
      "name": "MetaData",
      "position": "Query",
      "type": "Struct",
      "required": false,
      "description": {
        "zh": "原始文件信息。为空表示遍历整个知识库版本。",
        "en": "Original file information. If empty, the entire knowledge base version is traversed."
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "当前页数。",
        "en": "Current page number."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页查询数量。",
        "en": "Number of items per page."
      }
    },
    {
      "name": "VersionName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "知识库版本。默认为v1。",
        "en": "Knowledge base version. The default is v1."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取知识库切片列表",
    "en": "ListKnowledgeBaseChunks"
  }
}