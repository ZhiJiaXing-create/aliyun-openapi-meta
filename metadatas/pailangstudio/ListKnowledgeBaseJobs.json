{
  "name": "ListKnowledgeBaseJobs",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/langstudio/knowledgebases/[KnowledgeBaseId]/knowledgebasejobs",
  "parameters": [
    {
      "name": "Accessibility",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "JobAction",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务操作类型。\n- SyncIndex：更新知识库索引",
        "en": "任务操作类型。\n- SyncIndex：更新知识库索引"
      }
    },
    {
      "name": "KnowledgeBaseId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "知识库ID。",
        "en": "知识库ID。"
      }
    },
    {
      "name": "KnowledgeBaseJobId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "知识库任务ID。",
        "en": "知识库任务ID。"
      }
    },
    {
      "name": "MaxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "使用 NextToken 方式查询时，每次最多返回的结果数。",
        "en": "使用 NextToken 方式查询时，每次最多返回的结果数。"
      }
    },
    {
      "name": "NextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用来标记当前开始读取的位置，置空表示从头开始。",
        "en": "用来标记当前开始读取的位置，置空表示从头开始。"
      }
    },
    {
      "name": "Order",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方式。\n\n- ASC：升序。\n- DESC：降序。",
        "en": "排序方式。\n\n- ASC：升序。\n- DESC：降序。"
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "当前页数。 取值范围：大于0。 默认值：1。如果同时传入MaxResults，则使用NextToken查询方式，忽略此字段值。",
        "en": "当前页数。 取值范围：大于0。 默认值：1。如果同时传入MaxResults，则使用NextToken查询方式，忽略此字段值。"
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页查询的数量。如果同时传入 MaxResults，则以 MaxResults 数量为准。",
        "en": "每页查询的数量。如果同时传入 MaxResults，则以 MaxResults 数量为准。"
      }
    },
    {
      "name": "SortBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序字段。目前只支持GmtCreateTime。",
        "en": "排序字段。目前只支持GmtCreateTime。"
      }
    },
    {
      "name": "Status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "知识库任务状态。\n- Running: 运行中。\n- Success: 运行成功。\n- Failed: 运行失败。",
        "en": "知识库任务状态。\n- Running: 运行中。\n- Success: 运行成功。\n- Failed: 运行失败。"
      }
    },
    {
      "name": "WorkspaceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "知识库所在工作空间ID。",
        "en": "知识库所在工作空间ID。"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取知识库任务列表",
    "en": "ListKnowledgeBaseJobs"
  }
}