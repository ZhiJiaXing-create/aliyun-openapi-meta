{
  "name": "ListSnapshots",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/dlf/v1/[catalogId]/databases/[database]/tables/[table]/snapshots",
  "parameters": [
    {
      "name": "catalogId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据目录ID。",
        "en": "The catalog ID."
      }
    },
    {
      "name": "database",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据库名称。",
        "en": "The database name."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "一次获取的最大记录数",
        "en": "The maximum number of records to return on a single page."
      }
    },
    {
      "name": "pageToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻页令牌，用于获取下一页数据。如果响应结果中没有提供，则传空字符串（\"\"）或空字符（''）。",
        "en": "The token that is used to retrieve the next page of results. If the response does not provide this token, pass an empty string (\"\")."
      }
    },
    {
      "name": "table",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据表名称。",
        "en": "The table name."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取快照列表",
    "en": "ListSnapshots"
  }
}