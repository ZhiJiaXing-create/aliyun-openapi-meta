{
  "name": "ListTableDetails",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/dlf/v1/[catalogId]/databases/[database]/table-details",
  "parameters": [
    {
      "name": "catalogId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据目录ID。",
        "en": "The ID of the data catalog."
      }
    },
    {
      "name": "database",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据库名称。",
        "en": "The database name."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "一次获取的最大记录数",
        "en": "The maximum number of records to retrieve in a single request."
      }
    },
    {
      "name": "pageToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻页令牌，用于获取下一页数据。如果响应结果中没有提供，则传空字符串（\"\"）或空字符（''）。",
        "en": "The pagination token used to retrieve the next page of data. If the response does not provide this value, pass an empty string (\"\") or an empty character ('')."
      }
    },
    {
      "name": "status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "表删除状态",
        "en": "The deletion status of the table. Valid values:\n- retained: The table is deleted and temporarily stored in the recycle bin.\n- active: The table is in a normal state. This is the default value."
      }
    },
    {
      "name": "tableNamePattern",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "表模糊匹配名。",
        "en": "The fuzzy match pattern for the table name."
      }
    },
    {
      "name": "type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "类型",
        "en": "The type."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取数据表详细列表",
    "en": "List table details"
  }
}