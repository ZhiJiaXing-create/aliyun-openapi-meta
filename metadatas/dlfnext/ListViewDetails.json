{
  "name": "ListViewDetails",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/dlf/v1/[catalogId]/databases/[database]/view-details",
  "parameters": [
    {
      "name": "catalogId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据目录ID。",
        "en": "The ID of the data catalog."
      }
    },
    {
      "name": "database",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据库名称。",
        "en": "The name of the database."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "一次获取的最大记录数",
        "en": "The maximum number of records to return in a single request."
      }
    },
    {
      "name": "pageToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻页令牌，用于获取下一页数据。如果响应结果中没有提供，则传空字符串（\"\"）或空字符（''）。",
        "en": "The token for the next page of results. If the response does not include this token, pass an empty string (\"\")."
      }
    },
    {
      "name": "viewNamePattern",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "视图模糊匹配名。",
        "en": "A pattern to filter view names."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取视图详细列表",
    "en": "ListViewDetails"
  }
}