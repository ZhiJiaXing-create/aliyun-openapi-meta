{
  "name": "ListIcebergTableDetails",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/iceberg/dlf/v1/[catalogId]/namespaces/[namespace]/table-details",
  "parameters": [
    {
      "name": "catalogId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据目录ID。",
        "en": "The catalog ID."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "一次获取的最大记录数",
        "en": "The maximum number of records to return in a single request."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "命名空间。",
        "en": "The namespace."
      }
    },
    {
      "name": "pageToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻页令牌，用于获取下一页数据。如果响应结果中没有提供，则传空字符串（\"\"）或空字符（''）。",
        "en": "The token to retrieve the next page of results. If this parameter is not returned in the response, pass an empty string (\"\")."
      }
    },
    {
      "name": "tableNamePattern",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "表模糊匹配名。",
        "en": "The pattern to filter table names."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取Iceberg数据表详细列表",
    "en": "ListIcebergTableDetails"
  }
}