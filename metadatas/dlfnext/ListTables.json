{
  "name": "ListTables",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/dlf/v1/[catalogId]/databases/[database]/tables",
  "parameters": [
    {
      "name": "catalogId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据目录ID。",
        "en": "The catalog ID."
      }
    },
    {
      "name": "database",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据库名称。",
        "en": "The database name."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "本次请求所返回的最大记录条数。",
        "en": "The maximum number of records to return."
      }
    },
    {
      "name": "pageToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻页令牌，用于获取下一页数据。如果响应结果中没有提供，则传空字符串（\"\"）或空字符（''）。",
        "en": "The token to retrieve the next page of results. If the response does not include this parameter, pass an empty string (\"\")."
      }
    },
    {
      "name": "tableNamePattern",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "表模糊匹配名。",
        "en": "The table name pattern."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取数据表列表",
    "en": "ListTables"
  }
}