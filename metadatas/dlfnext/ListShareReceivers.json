        "en": "The token to retrieve the next page of results. If the response does not include this token, pass an empty string (\"\")."
      }
    },
    {
      "name": "share",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "共享名称。",
