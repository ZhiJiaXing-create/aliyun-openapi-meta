{
  "name": "ListFunctions",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/dlf/v1/[catalogId]/databases/[database]/functions",
  "parameters": [
    {
      "name": "catalogId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据目录ID。",
        "en": "The ID of the data catalog."
      }
    },
    {
      "name": "database",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据库名称。",
        "en": "The name of the database."
      }
    },
    {
      "name": "functionNamePattern",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "函数模糊匹配名。",
        "en": "A pattern to filter function names."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "本次请求所返回的最大记录条数。",
        "en": "The maximum number of records to return in the response."
      }
    },
    {
      "name": "pageToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "翻页令牌，用于获取下一页数据。如果响应结果中没有提供，则传空字符串（\"\"）或空字符（''）。",
        "en": "A pagination token. Use this token to retrieve the next page of results. Pass an empty string (\"\") if this parameter is not returned in the response."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取函数列表",
    "en": "ListFunctions"
  }
}