{
  "name": "CreateProjectModifyRecords",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Databases",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "数据库对象列表。",
        "en": "A list of database objects."
      },
      "sub_parameters": [
        {
          "name": "Id",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "数据库的 ID。",
            "en": "The ID of the database."
          }
        },
        {
          "name": "MappedName",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "数据库的映射名称。",
            "en": "The mapped name of the database."
          }
        },
        {
          "name": "Name",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "数据库的名称。",
            "en": "The name of the database."
          }
        },
        {
          "name": "SpecificTables",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "具体表对象的配置集合。`mode` 为 `WILDCARD` 时，该参数表示具体表对象的重命名、行过滤配置。",
            "en": "A collection of configurations for specific table objects. When `mode` is `WILDCARD`, this parameter specifies the renaming and row filtering configurations for specific table objects."
          }
        },
        {
          "name": "SpecificViews",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "具体视图对象的配置列表。`mode` 为 `WILDCARD` 时，该参数表示具体视图对象的重命名配置。",
            "en": "A list of configurations for specific view objects. When `mode` is `WILDCARD`, this parameter specifies the renaming configuration for specific view objects."
          }
        },
        {
          "name": "Tables",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "当前数据库中传输表对象的配置。Mode 为 WILDCARD 时，该参数表示具体黑名单或白名单的配置，表和视图共用。",
            "en": "The configuration for transferring table objects in the current database. When Mode is set to WILDCARD, this parameter specifies the blacklist or whitelist configuration, which is shared by tables and views."
          }
        },
        {
          "name": "Views",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "当前数据库中传输视图对象的配置列表。",
            "en": "A list of configurations for transferring view objects in the current database."
          }
        }
      ]
    },
    {
      "name": "Id",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据迁移或数据同步任务的 ID。",
        "en": "The ID of the data migration or data synchronization task."
      }
    },
    {
      "name": "TransferMapping",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "传输对象列表（修改匹配规则时必填）",
        "en": "The list of transfer objects. This is required when you modify matching rules."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "修改传输对象",
    "en": "Modify transfer object"
  },
