{
  "name": "UpdateRecordTemplate",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用ID。通过控制台创建和查询，仅支持传单个ID。",
        "en": "Application ID. Created and queried through the console. Only a single ID is supported."
      }
    },
    {
      "name": "BackgroundColor",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "背景色RGB，默认是0（黑色）。计算公式为R+G×256+B×65536，R（红）、G（绿）、B（蓝）的取值：**0~255**。",
        "en": "Background color RGB. The default value is 0 (black). The calculation formula is R+G×256+B×65536. The values of R (red), G (green), and B (blue) range from **0 to 255**."
      }
    },
    {
      "name": "Backgrounds",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "背景图片信息。",
        "en": "Background image information."
      },
      "sub_parameters": [
        {
          "name": "Display",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "图片显示。取值：\n\n- **0**（None）：不显示。\n- **1**（Always）：总是显示。",
            "en": "Image display. Valid values:\n\n- **0** (None): Not displayed.\n- **1** (Always): Always displayed."
          }
        },
        {
          "name": "Height",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "窗格高，归一化百分比。",
            "en": "Pane height, normalized percentage."
          }
        },
        {
          "name": "Url",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "图片的HTTP或HTTPS地址。",
            "en": "HTTP or HTTPS address of the image."
          }
        },
        {
          "name": "Width",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "窗格宽，归一化百分比。",
            "en": "Pane width, normalized percentage."
          }
        },
        {
          "name": "X",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "坐标X，归一化百分比。",
            "en": "X coordinate, normalized percentage."
          }
        },
        {
          "name": "Y",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "坐标Y，归一化百分比。",
            "en": "Y coordinate, normalized percentage."
          }
        },
        {
          "name": "ZOrder",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "叠放顺序，0为最底层，1层在0层之上，以此类推。",
            "en": "Stacking order. 0 is the bottom layer, layer 1 is on top of layer 0, and so on."
          }
        }
      ]
    },
    {
      "name": "ClockWidgets",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "时钟信息。",
        "en": "Clock information."
      },
      "sub_parameters": [
        {
          "name": "FontColor",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "时钟文字颜色（RGB）。\n\n计算公式为`R + G × 256 + B × 65536`，R（红）、G（绿）、B（蓝）的取值：**0**~**255**。",
            "en": "Clock text color (RGB).\n\nThe calculation formula is `R + G × 256 + B × 65536`. The values of R (red), G (green), and B (blue) range from **0** to **255**."
          }
        },
        {
          "name": "FontSize",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "时钟字体大小。字体合理范围**(0, 72]**。",
            "en": "Clock font size. The reasonable range of the font is **(0, 72]**."
          }
        },
        {
          "name": "FontType",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "时钟字体类型，取值：\n\n- **0**（默认值）：NOTO_SERIF_CJKSC_REGULAR\n- **1**：ALIBABA_PUHUITI_REGULAR\n- **2**：ALIBABA_PUHUITI_BOLD\n- **3**：ALIBABA_PUHUITI_Heavy\n- **4**：ALIBABA_PUHUITI_LIGHT\n- **5**：ALIBABA_PUHUITI_MEDIUM",
            "en": "Clock font type. Valid values:\n\n- **0** (default): NOTO_SERIF_CJKSC_REGULAR\n- **1**: ALIBABA_PUHUITI_REGULAR\n- **2**: ALIBABA_PUHUITI_BOLD\n- **3**: ALIBABA_PUHUITI_Heavy\n- **4**: ALIBABA_PUHUITI_LIGHT\n- **5**: ALIBABA_PUHUITI_MEDIUM"
          }
        },
        {
          "name": "X",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "时钟坐标X，归一化百分比。",
            "en": "Clock X coordinate, normalized percentage."
          }
        },
        {
          "name": "Y",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "时钟坐标Y，归一化百分比。",
            "en": "Clock Y coordinate, normalized percentage."
          }
        },
        {
          "name": "ZOrder",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "时钟叠放顺序，0为最底层，1层在0层之上，以此类推。",
            "en": "Clock stacking order. 0 is the bottom layer, layer 1 is on top of layer 0, and so on."
          }
        }
      ]
    },
    {
      "name": "DelayStopTime",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "延时停止录制的时间。单位：秒。默认值为**180**秒。",
        "en": "Delayed recording stop time. Unit: seconds. The default value is **180** seconds."
      }
    },
    {
      "name": "EnableM3u8DateTime",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "录制的m3u8文件是否需要加上ts文件时间点。",
        "en": "Whether the recorded m3u8 file needs to include ts file timestamps."
      }
    },
    {
      "name": "FileSplitInterval",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "录制文件切割时长（大于等于1800）。单位：秒。",
        "en": "Recording file split duration (greater than or equal to 1800). Unit: seconds."
      }
    },
    {
      "name": "Formats",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "description": {
        "zh": "录制文件格式。",
        "en": "Recording file format."
      }
    },
    {
      "name": "HttpCallbackUrl",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "录制事件HTTP回调地址。",
        "en": "Recording event HTTP callback URL."
      }
    },
    {
      "name": "LayoutIds",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "description": {
        "zh": "布局ID组。",
        "en": "Layout ID group."
      }
    },
    {
      "name": "MediaEncode",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "编码选项。",
        "en": "Encoding option."
      }
    },
    {
      "name": "MnsQueue",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "录制事件回调消息队列。",
        "en": "Recording event callback message queue."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "录制配置模板名称。",
        "en": "Recording configuration template name."
      }
    },
    {
      "name": "OssBucket",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "录制文件存储的OSS Bucket。",
        "en": "OSS bucket for storing recording files."
      }
    },
    {
      "name": "OssEndpoint",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "OssFilePrefix",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "录制文件命名规则。",
        "en": "Recording file naming rule."
      }
    },
    {
      "name": "TaskProfile",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务计费配置。",
        "en": "Task billing configuration."
      }
    },
    {
      "name": "TemplateId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "配置模板ID。获取模板ID，请参加[AddRecordTemplate](~~193625~~)。",
        "en": "Configuration template ID. To obtain the template ID, see [AddRecordTemplate](~~193625~~)."
      }
    },
    {
      "name": "Watermarks",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "水印信息。",
        "en": "Watermark information."
      },
      "sub_parameters": [
        {
          "name": "Alpha",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "透明度。0.0表示透明，1.0表示完全不透明。",
            "en": "Transparency. 0.0 means transparent, 1.0 means completely opaque."
          }
        },
        {
          "name": "Display",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "水印显示。取值：\n\n- **0**（None）：不显示。\n- **1**（Always）：总是显示。",
            "en": "Watermark display. Valid values:\n\n- **0** (None): Not displayed.\n- **1** (Always): Always displayed."
          }
        },
        {
          "name": "Height",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "窗格高，归一化百分比。",
            "en": "Pane height, normalized percentage."
          }
        },
        {
          "name": "Url",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "水印的HTTP或HTTPS地址。",
            "en": "HTTP or HTTPS address of the watermark."
          }
        },
        {
          "name": "Width",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "窗格宽，归一化百分比。",
            "en": "Pane width, normalized percentage."
          }
        },
        {
          "name": "X",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "坐标X，归一化百分比。",
            "en": "X coordinate, normalized percentage."
          }
        },
        {
          "name": "Y",
          "position": "Query",
          "type": "Float",
          "required": false,
          "description": {
            "zh": "坐标Y，归一化百分比。",
            "en": "Y coordinate, normalized percentage."
          }
        },
        {
          "name": "ZOrder",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "叠放顺序，0为最底层，1层在0层之上，以此类推。",
            "en": "Stacking order. 0 is the bottom layer, layer 1 is on top of layer 0, and so on."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新录制配置模板",
    "en": "Update Recording Configuration Template"
  },
  "descriptions": {
    "zh": "# 使用说明\n调用本接口前，您必须已经调用[AddRecordTemplate](~~193625~~)添加录制配置模板。\n# QPS限制\n本接口的单用户QPS限制为100次/秒。超过限制，API调用会被限流，这可能会影响您的业务，请合理调用。更多信息，请参见[QPS限制](~~341645~~)。",
    "en": "# Usage notes\nBefore you call this operation, you must have already called [AddRecordTemplate](~~193625~~) to add a recording configuration template.\n# QPS limit\nThe per-user QPS limit for this operation is 100 calls per second. If you exceed this limit, API calls will be throttled, which may affect your business. Please call this operation reasonably. For more information, see [QPS limit](~~341645~~)."
  }
}