{
  "name": "PutRecords",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ProjectName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目名称",
        "en": "The project name."
      }
    },
    {
      "name": "Records",
      "position": "Query",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "需要写入的数据。",
        "en": "The data to be written."
      },
      "sub_parameters": [
        {
          "name": "Attributes",
          "position": "Query",
          "type": "Struct",
          "required": false,
          "description": {
            "zh": "Record的额外信息，如没有额外信息可不填写。",
            "en": "The additional information of the record. You can leave this parameter empty if no additional information is available."
          }
        },
        {
          "name": "Data",
          "position": "Query",
          "type": "RepeatList",
          "required": true,
          "description": {
            "zh": "Record的数据内容。",
            "en": "The data content of the record."
          }
        }
      ]
    },
    {
      "name": "ShardId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "待写入的shardId，如果不指定，则随机写入某一个Shard。",
        "en": "The ID of the shard to which data is written. If this parameter is not specified, data is randomly written to a shard."
      }
    },
    {
      "name": "TopicName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "topic名称",
        "en": "The topic name."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "发布数据",
    "en": "Publish data"
  },
  "descriptions": {
    "zh": "本接口主要是供用户调试使用，请勿使用该接口写入大量数据。",
    "en": "This operation is primarily intended for debugging. Do not use this operation to write large amounts of data."
  }
}