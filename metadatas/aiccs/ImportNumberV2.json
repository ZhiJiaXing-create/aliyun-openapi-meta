{
  "name": "ImportNumberV2",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Customers",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "必填！ 外呼客户具体用户信息，如手机号、姓名等。限制数量最多1000个",
        "en": "Required. The information about the outbound call customers, such as phone numbers and names. A maximum of 1000 entries are allowed."
      },
      "sub_parameters": [
        {
          "name": "ClientUrl",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "客户弹窗url，特殊字段",
            "en": "The client pop-up URL. This is a special field."
          }
        },
        {
          "name": "Number",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "号码",
            "en": "The phone number."
          }
        },
        {
          "name": "NumberMD5",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "加密号码，与号码字段两个必传一个",
            "en": "The encrypted phone number. Either this parameter or the Number parameter must be specified."
          }
        },
        {
          "name": "Properties",
          "position": "FormData",
          "type": "Struct",
          "required": false,
          "description": {
            "zh": "参数  需提前约定",
            "en": "The parameters. These must be agreed upon in advance."
          }
        },
        {
          "name": "Tag",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签",
            "en": "The tag."
          }
        }
      ]
    },
    {
      "name": "FailReturn",
      "position": "Body",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "可选值：0，1，默认1。如导入的数据中有部分验证不通过数据：0表示导入验证成功的，返回失败的数据；1表示全部数据（包括验证成功及失败的）都不导入；",
        "en": "Valid values:\n- 0: imports the data that passes validation and returns the data that fails validation.\n- 1: does not import any data (including data that passes and fails validation) if some data fails validation.\n\nDefault value: 1."
      }
    },
    {
      "name": "OutId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "必填！ 外部流水号。",
        "en": "Required. The external transaction ID."
      }
    },
    {
      "name": "TaskId",
      "position": "Body",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "必填！任务id",
        "en": "Required. The task ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "行业版-批量导入任务号码V2版本",
    "en": "Import task phone numbers in batches (industry edition V2)"
  }
}