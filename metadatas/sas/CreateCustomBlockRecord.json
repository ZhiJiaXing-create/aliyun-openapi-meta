{
  "name": "CreateCustomBlockRecord",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "BlockIp",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "指定需要进行阻断的单个IP地址，为服务器阻断该IP上面的流量访问。",
        "en": "The IP address that you want to specify in the policy."
      }
    },
    {
      "name": "Bound",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "自定义IP与服务器的流量禁用方向。\n取值：\n- **in**：入流量 \n- **out**：出流量",
        "en": "The traffic direction that you want to specify in the policy. Valid values:\n\n*   **in**: inbound\n*   **out**: outbound"
      }
    },
    {
      "name": "ExpireTime",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "该策略的到期时间。",
        "en": "The expiration time of the policy."
      }
    },
    {
      "name": "Uuids",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "资产实例的UUID列表。多个UUID之间使用半角逗号（,）分隔。",
        "en": "The UUIDs of the servers. Separate multiple UUIDs with commas (,)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "新增自定义IP拦截策略",
    "en": "CreateCustomBlockRecord"
  },
  "example": {
