{
  "name": "GetJMeterLogs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentIndex",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "非法Index直接返回第0台引擎的日志。",
        "en": "If you specify an invalid index, the logs of engine 0 are returned."
      }
    },
    {
      "name": "BeginTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "开始时间，单位秒。",
        "en": "The start time. This value is a UNIX timestamp in milliseconds."
      }
    },
    {
      "name": "EndTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "结束时间，单位秒。",
        "en": "The end time. This value is a UNIX timestamp in milliseconds."
      }
    },
    {
      "name": "Keyword",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "关键字。",
        "en": "The keyword to search for in the logs."
      }
    },
    {
      "name": "Level",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "日志等级。包括：\n\n- ERROR：错误\n- WARN：警告\n- INFO：信息，默认值\n- DEBUG：调试\n- TRACE：跟踪",
        "en": "The log level. Valid values:\n\n- ERROR\n- WARN\n- INFO: The default value.\n- DEBUG\n- TRACE"
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "请求第N页的日志信息。",
        "en": "The number of the page to return."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "请求N条记录。",
        "en": "The number of entries to return on each page."
      }
    },
    {
      "name": "ReportId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "报告ID。",
        "en": "The report ID."
      }
    },
    {
      "name": "Thread",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "线程名。",
        "en": "The thread name."
      }
    }
  ],
  "security": [
    "AK",
    "APP",
    "PrivateKey",
    "BearerToken"
  ],
  "title": {
    "zh": "获得JMeter运行日志",
    "en": "GetJMeterLogs"
  }
}