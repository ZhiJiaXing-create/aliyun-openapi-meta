{
  "name": "ModifyPolicyContent",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Content",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "策略内容。",
        "en": "The policy content."
      }
    },
    {
      "name": "Id",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "策略ID。",
        "en": "The policy ID."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "策略名称。",
        "en": "The policy name."
      }
    },
    {
      "name": "PortVersion",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "端口防护策略版本，取值：\n\n- **不填**：修改默认 surf 防护引擎策略。\n- **2**：修改新版 stream 防护引擎策略。\n> 仅端口防护策略支持。",
        "en": "The version of the port-specific mitigation policy. Valid values:\n\n- **Leave empty**: Modifies the policy for the default surf Deep Packet Inspection (DPI) engine.\n\n- **2**: Modifies the policy for the new stream DPI engine.\n\n> This parameter is supported only by port-specific mitigation policies."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "修改防护策略内容",
    "en": "ModifyPolicyContent"
  },
  "descriptions": {
    "zh": "请确保使用该接口时，参数是全量的，参数未填时，配置会被删除。",
    "en": "When you call this operation, you must specify all parameters. If you do not specify a parameter, its existing configuration is deleted."
  },
  "example": {
    "unifiedCli": "aliyun ddosbgp modify-policy-content --id 83967609-7ea5-4f6d-a6ea-380b09e0000 --name demo00 --content '{\"WhitenGfbrNets\":false,\"PortRuleList\":[{\"SrcPortEnd\":65535,\"SrcPortStart\":0,\"SeqNo\":1,\"DstPortStart\":0,\"DstPortEnd\":65535,\"Id\":\"412a7312-58ff-4e32-a202-0ab00000000\",\"MatchAction\":\"drop\",\"Protocol\":\"tcp\"}],\"RegionBlockCountryList\":[11],\"RegionBlockProvinceList\":[2],\"FingerPrintRuleList\":[{\"SrcPortEnd\":65535,\"SrcPortStart\":0,\"SeqNo\":1,\"PayloadBytes\":\"abcd\",\"RateValue\":100,\"DstPortStart\":0,\"MatchAction\":\"drop\",\"Offset\":0,\"MaxPktLen\":1500,\"DstPortEnd\":65535,\"MinPktLen\":1,\"Id\":\"83967609-7ea5-4f6d-a6ea-380b09e0000\",\"Protocol\":\"tcp\"}],\"SourceLimit\":{\"Pps\":64,\"SynBps\":2048,\"Bps\":2048,\"SynPps\":64},\"L4RuleList\":[{\"Action\":\"2\",\"ConditionList\":[{\"Pattern\":\"contain\",\"Position\":0,\"Content\":\"test00\",\"Arg\":\"abcd\",\"Encode\":\"str\",\"Depth\":1200,\"Offset\":{\"Start\":0,\"End\":1499}}],\"Priority\":1,\"Method\":\"char\",\"Limited\":0,\"Name\":\"test00\",\"Match\":\"0\"}],\"EnableIntelligence\":true,\"SourceBlockList\":[{\"Type\":3,\"ExceedLimitTimes\":5,\"EverySeconds\":60,\"BlockExpireSeconds\":120}],\"EnableDropIcmp\":true,\"IntelligenceLevel\":\"default\",\"ReflectBlockUdpPortList\":[123],\"EnableL4Defense\":true,\"BlackIpListExpireAt\":1716878000}' --port-version 2 --api-version 2018-07-20 --region cn-hangzhou",
