{
  "name": "BeeBotChat",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ChatBotInstanceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "机器人实例ID。",
        "en": "Indicates whether the answer is in plain text or rich text."
      }
    },
    {
      "name": "CustSpaceId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "ISV子客户的SpaceId",
        "en": "The metadata."
      }
    },
    {
      "name": "IntentName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "对话流中意图名称，若指定此名称，机器人会直接进入此意图做问答。",
        "en": "The source of the answer."
      }
    },
    {
      "name": "IsvCode",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Isv校验码，用于校验子账号是否由ISV授权。",
        "en": "The source of the answer."
      }
    },
    {
      "name": "KnowledgeId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "知识库中知识标题ID。",
        "en": "The hit statement."
      }
    },
    {
      "name": "Perspective",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "视角编码列表。",
        "en": "Beijing"
      }
    },
    {
      "name": "SenderId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "访问者ID。用于识别当前会话中的用户。",
        "en": "The information about the slot."
      }
    },
    {
      "name": "SenderNick",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "当前会话中访问的昵称。",
        "en": "Beijing"
      }
    },
    {
      "name": "SessionId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "会话ID, 用于标识一个访问者的会话和上下文信息。",
        "en": "The title of the related knowledge."
      }
    },
    {
      "name": "Utterance",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "机器人访问者输入。",
        "en": "The title of the hit question."
      }
    },
    {
      "name": "VendorParam",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户自定义参数集，一个JSON格式的用户自定义参数集，可以传入用户自定义的参数到各对话引擎。",
        "en": "The node name. When AnswerSource is set to BotFramework, a value is returned for this parameter."
      }
    }
  ],
  "security": [
    "AK",
    "APP"
  ],
  "title": {
    "zh": "机器人会话",
    "en": "BeeBotChat"
  },
  "descriptions": {
    "zh": "本接口的单用户QPS限制为100次/秒。超过限制，API调用会被限流，这可能会影响您的业务，请合理调用。",
    "en": "The ID of the session."
  }
}