{
  "name": "ModifyApplicationServerlessConf",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ApplicationId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用ID",
        "en": "The application ID."
      }
    },
    {
      "name": "ServerlessConfList",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "description": {
        "zh": "Serverless配置列表",
        "en": "The list of Serverless configurations."
      },
      "sub_parameters": [
        {
          "name": "ComponentType",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "应用子组件的类型\n\n对于 supabase，取值范围为\n\n- gateway\n- backend",
            "en": "The type of the application sub-component.\n\nFor Supabase, valid values are:\n\n- gateway\n\n- backend"
          }
        },
        {
          "name": "ScaleMax",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "单节点伸缩上限。取值范围：0 PCU~16 PCU。",
            "en": "The maximum number of PCUs for a single node. Valid values: 0 to 16."
          }
        },
        {
          "name": "ScaleMin",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "单节点伸缩下限。取值范围：0 PCU~16 PCU。",
            "en": "The minimum number of PolarDB Capacity Units (PCUs) for a single node. Valid values: 0 to 16."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "修改PolarDB应用Serverless配置",
    "en": "ModifyApplicationServerlessConf"
  },
  "example": {
    "unifiedCli": "aliyun polardb modify-application-serverless-conf --application-id pa-00000000000000 --serverless-conf-list ComponentType=gateway ScaleMin=1 ScaleMax=16 --region cn-hangzhou",
    "legacyCli": "aliyun polardb ModifyApplicationServerlessConf --region cn-hangzhou --ServerlessConfList.1.ComponentType gateway --ServerlessConfList.1.ScaleMin 1 --ServerlessConfList.1.ScaleMax 16 --ApplicationId 'pa-00000000000000'"
  }
}