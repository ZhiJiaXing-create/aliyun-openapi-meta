    "unifiedCli": "aliyun rai create-policy --biz-region-id cn-hangzhou --policy-name '测试策略' --harmful-category-config-info-list CategoryId=1 InputOutputType=0 IsEnabled=1 SecurityLevel=0 CategoryType=0 CategoryLabel=伦理道德 --word-group-info-list GroupName=测试分组 InputOutputType=0 GroupId=1 --prompt-attack-info IsEnabled=1 SecurityLevel=1 --prompt-attack-info-list CategoryId=1 IsEnabled=1 SecurityLevel=1 CategoryLabel=角色扮演 --topic-config-info-list InputOutputType=0 SecurityLevel=1 TopicId=4 CategoryType=0 TopicName=业务敏感 --workspace-id 608226 --enable-sensitive-input-check 1 --enable-sensitive-output-check 1 --scene-type 1 --input-safe-answer example-string --output-safe-answer example-string --input-safe-answer-switch 1 --output-safe-answer-switch 1 --is-sidecar-policy 1 --content-safe-model-instance-id 1 --prompt-attack-model-instance-id 1 --sensitive-topic-model-instance-id 1 --sensitive-word-list Word=example-string Label=example-string --sensitive-config-list SensitiveConfigId=1 ActionType=1 IsEnabled=1 --regular-express-list RegularExpressName=example-string ActionType=1 RegularExpress=example-string --sensitive-topic-list '[{\"TopicExampleInfoList\":[{\"Content\":\"example-string\",\"ExampleType\":1}],\"TopicDefinition\":\"example-string\",\"SecurityLevel\":1,\"CategoryType\":1,\"TopicName\":\"example-string\"}]' --region cn-hangzhou",
