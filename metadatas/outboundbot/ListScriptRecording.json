{
  "name": "ListScriptRecording",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "录音所属实例ID",
        "en": "Instance ID of the recording"
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "页号",
        "en": "Page number"
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "每页显示的条数",
        "en": "Number of entries per page"
      }
    },
    {
      "name": "RefIdsJson",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "录音ID列表（JSON格式），与UuidsJson相同",
        "en": "Recording ID list (JSON format), same as UuidsJson"
      }
    },
    {
      "name": "ScriptId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "录音所属场景ID",
        "en": "Scenario ID of the recording"
      }
    },
    {
      "name": "Search",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "搜索条件：可根据录音名称、录音内容查询",
        "en": "Search criteria: Search by recording name or content."
      }
    },
    {
      "name": "StatesJson",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "录音状态\n\n- 校验中：1\n- 校验未通过：2\n- 处理中：3\n- 处理失败：4\n- 审核中：5\n- 审核未通过：6\n- 发布失败：7\n- 已发布：8\n- 待发布：9",
        "en": "Recording status\n\n- Validating: 1\n\n- Validation failed: 2\n\n- Processing: 3\n\n- Processing failed: 4\n\n- Reviewing: 5\n\n- Review failed: 6\n\n- Publish failed: 7\n\n- Published: 8\n\n- Pending publish: 9"
      }
    },
    {
      "name": "UuidsJson",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "录音ID列表\n\n> 即录音唯一ID的列表，不填写则展示所有",
        "en": "Recording ID list\n\n> This is a list of unique recording IDs. If left blank, all recordings display."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "【小模型接口】查询录音文件列表",
    "en": "【Small Model API】Query Recording File List"
