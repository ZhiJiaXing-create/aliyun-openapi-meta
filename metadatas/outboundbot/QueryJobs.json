{
  "name": "QueryJobs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ContactName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "过滤条件，联系人名字。",
        "en": "The filter condition for the contact name."
      }
    },
    {
      "name": "EndTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "过滤条件，截止时间，缺省为0，代表截止到当前时间。",
        "en": "The filter condition for the end time. Default value: 0, which indicates the current time."
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "JobGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务组ID。",
        "en": "The job group ID."
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页序号。",
        "en": "The page number."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页大小。",
        "en": "The page size."
      }
    },
    {
      "name": "PhoneNumber",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "过滤条件，联系人电话号码。",
        "en": "The filter condition for the contact phone number."
      }
    },
    {
      "name": "ScenarioId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "场景ID。历史参数【已废弃】",
        "en": "The scenario ID. This is a legacy parameter and has been deprecated."
      }
    },
    {
      "name": "StartTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "过滤条件，开始时间，缺省为0， 代表从今天0时开始。",
        "en": "The filter condition for the start time. Default value: 0, which indicates the start of the current day."
      }
    },
    {
      "name": "TimeAlignment",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "时间条件按照开始时间还是结束时间查询，有效值为：start、end、job_create。",
        "en": "Specifies whether to query by start time, end time, or job creation time. Valid values: start, end, job_create."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询作业列表",
    "en": "Query job list"
  }
}