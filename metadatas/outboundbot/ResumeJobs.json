{
  "name": "ResumeJobs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "All",
      "position": "Query",
      "type": "Boolean",
      "required": true,
      "description": {
        "zh": "过滤条件，是否重启所有",
        "en": "Filter condition: Specifies whether to restart all jobs."
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID",
        "en": "Instance ID"
      }
    },
    {
      "name": "JobGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "过滤条件，任务组ID",
        "en": "Filter condition: Task group ID."
      }
    },
    {
      "name": "JobId",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "作业ID列表\n\n> 当All的值为false时，该参数必填",
        "en": "Job ID list.\n\n> This parameter is required when All is false."
      }
    },
    {
      "name": "JobReferenceId",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "作业的第三方id\n\n> 即为上传外呼名单时客户上传的ReferenceId",
        "en": "Third-party ID of the job.\n\n> This is the ReferenceId uploaded by the customer when uploading the outbound list."
      }
    },
    {
      "name": "ScenarioId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "过滤条件，场景id（历史参数，已废弃）",
        "en": "Filter condition: Scenario ID (historical parameter, deprecated)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "重启暂停的作业",
    "en": "Restart a paused job"
  }
