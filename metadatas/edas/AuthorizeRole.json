{
  "name": "AuthorizeRole",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE|POST|PUT",
  "pathPattern": "/pop/v5/account/authorize_role",
  "parameters": [
    {
      "name": "RoleIds",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "角色 ID，用“;”号分割，null 代表取消角色授权",
        "en": "The ID of the role to be assigned. If you want to assign multiple roles to the specified RAM user, separate the IDs of the roles with semicolons (;). If you leave this parameter empty, the roles assigned to the specified RAM user are revoked."
      }
    },
    {
      "name": "TargetUserId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待授权子账号 ID",
        "en": "The ID of the RAM user to which you want to assign the roles."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "授权角色",
    "en": "AuthorizeRole"
  },
  "example": {
    "unifiedCli": "aliyun edas authorize-role --target-user-id test@133000000 --role-ids 1_2 --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/v5/account/authorize_role --region cn-hangzhou --RoleIds 1_2 --TargetUserId 'test@133000000' --header \"Content-Type=application/json\""
  }
}