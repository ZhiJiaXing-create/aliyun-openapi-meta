    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "泳道名称。",
        "en": "The name of the swimming lane."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新泳道",
    "en": "UpdateSwimmingLane"
  },
  "example": {
    "unifiedCli": "aliyun edas update-swimming-lane --lane-id 224 --name test-swimlane --enable-rules true --app-infos appId_:_8e7689af-6ddd-4676-8ee6-5fbecdf20000_,_appId_:_f72deaac-26ba-429a-948d-5fa47c4a0000_,_appId_:_99a2d4b5-99a5-4e25-a964-1bd03a170000 --entry-rules priority_:1,_path_:_/traffictest_,_condition_:_AND_,_restItems_:_type_:_header_,_name_:_testheader_,_value_:_testheadervalue_,_cond_:_==_,_operator_:_rawvalue --region cn-hangzhou",
    "legacyCli": "aliyun edas PUT /pop/v5/trafficmgnt/swimming_lanes --region cn-hangzhou --EntryRules 'priority_:1,_path_:_/traffictest_,_condition_:_AND_,_restItems_:_type_:_header_,_name_:_testheader_,_value_:_testheadervalue_,_cond_:_==_,_operator_:_rawvalue' --AppInfos 'appId_:_8e7689af-6ddd-4676-8ee6-5fbecdf20000_,_appId_:_f72deaac-26ba-429a-948d-5fa47c4a0000_,_appId_:_99a2d4b5-99a5-4e25-a964-1bd03a170000' --EnableRules true --LaneId 224 --Name 'test-swimlane' --header \"Content-Type=application/json\""
