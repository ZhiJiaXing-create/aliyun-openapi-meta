{
  "name": "UpdateSwimmingLane",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/pop/v5/trafficmgnt/swimming_lanes",
  "parameters": [
    {
      "name": "AppInfos",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "流控泳道涉及应用列表。",
        "en": "A list of applications associated with the swimming lane."
      }
    },
    {
      "name": "EnableRules",
      "position": "Query",
      "type": "Boolean",
      "required": true,
      "description": {
        "zh": "流控规则是否开启。",
        "en": "Specifies whether the throttling rule is enabled."
      }
    },
    {
      "name": "EntryRules",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "流控规则配置。",
        "en": "The configuration of the throttling rule."
      }
    },
    {
      "name": "LaneId",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "泳道ID。",
        "en": "The ID of the swimming lane."
      }
