{
  "name": "ListConfigTemplates",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/pop/v5/config_template",
  "parameters": [
    {
      "name": "CurrentPage",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "页码，从1开始计数。",
        "en": "The number of the page to return. Pages start from Page 1."
      }
    },
    {
      "name": "Id",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "配置模板ID。",
        "en": "The ID of the configuration template."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "配置模板名称。",
        "en": "The name of the configuration template."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "页大小。",
        "en": "The number of entries to return on each page."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取配置模板列表",
    "en": "ListConfigTemplates"
  },
  "example": {
    "unifiedCli": "aliyun edas list-config-templates --current-page 1 --page-size 10 --id 1 --name config-tmpl-1 --region cn-hangzhou",
    "legacyCli": "aliyun edas GET /pop/v5/config_template --region cn-hangzhou --PageSize 10 --CurrentPage 1 --Id 1 --Name 'config-tmpl-1' --header \"Content-Type=application/json\""
  }
}