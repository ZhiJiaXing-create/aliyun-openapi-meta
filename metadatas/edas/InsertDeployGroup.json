{
  "name": "InsertDeployGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/pop/v5/deploy_group",
  "parameters": [
    {
      "name": "AppId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用ID",
        "en": "The ID of the application."
      }
    },
    {
      "name": "GroupName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "分组名称，支持的最大长度为64字符。",
        "en": "The name of the instance group. The name can be up to 64 characters in length."
      }
    },
    {
      "name": "InitPackageVersionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用分组关联的初始化部署包版本ID。可以调用接口ListHistoryDeployVersion获取，具体操作，请参见[ListHistoryDeployVersion](~~149392~~)。",
        "en": "The version of the initial deployment package associated with the instance group. You can call the ListHistoryDeployVersion operation to query the version. For more information, see [ListHistoryDeployVersion](~~149392~~)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "创建应用部署分组",
    "en": "InsertDeployGroup"
  },
  "example": {
    "unifiedCli": "aliyun edas insert-deploy-group --app-id 3616cdca-4f92-4413-00000000000 --group-name test --init-package-version-id 441beb18-da42-44dc-0000-0000 --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/v5/deploy_group --region cn-hangzhou --GroupName test --InitPackageVersionId '441beb18-da42-44dc-0000-0000' --AppId '3616cdca-4f92-4413-00000000000' --header \"Content-Type=application/json\""
  }
}