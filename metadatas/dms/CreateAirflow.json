{
  "name": "CreateAirflow",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AirflowName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Airflow实例名称。",
        "en": "The name of the Airflow instance."
      }
    },
    {
      "name": "AirflowVersion",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Airflow版本，支持3.1或2.10",
        "en": "The Airflow version. Supported versions: 2.10 and 3.1."
      }
    },
    {
      "name": "AppSpec",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Airflow实例的规格，取值为：**SMALL**、**MEDIUM**、**LARGE**、**XLARGE**或**X2LARGE**。",
        "en": "The compute specifications for the Airflow instance. Valid values: **SMALL**, **MEDIUM**, **LARGE**, **XLARGE**, or **X2LARGE**."
      }
    },
    {
      "name": "ClientToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "客户端Token，用于保证请求的幂等性。",
        "en": "A client token to ensure request idempotence."
      }
    },
    {
      "name": "DagsDir",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Airflow扫描的dag目录。",
        "en": "The path to the DAG directory for Airflow to scan."
      }
    },
    {
      "name": "DataMountInfoList",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "数据挂载信息列表",
        "en": "A list of data mount configurations."
      }
    },
    {
      "name": "Description",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Airflow实例描述。",
        "en": "The description of the Airflow instance."
      }
    },
    {
      "name": "EnableServerless",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否开启Worker弹性",
        "en": "Specifies whether to enable worker elasticity."
      }
    },
    {
      "name": "GracefulShutdownTimeout",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "Worker退出时的超时时间",
        "en": "The graceful shutdown timeout for workers, in seconds."
      }
    },
    {
      "name": "OssBucketName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "OSS Bucket名称。",
        "en": "The name of the OSS bucket."
      }
    },
    {
      "name": "OssPath",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "存放日志的OSS路径。",
        "en": "The OSS path for log storage."
      }
    },
    {
      "name": "PluginsDir",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Airflow实例扫描的插件目标。",
        "en": "The path to the plugin directory for the Airflow instance to scan."
      }
    },
    {
      "name": "RequirementFile",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "安装包的路径。",
        "en": "The path to the Python requirements file."
      }
    },
    {
      "name": "SecurityGroupId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "安全组ID。",
        "en": "The security group ID."
      }
    },
    {
      "name": "StartupFile",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Airflow容器的启动脚本。",
        "en": "The path to the startup script in the Airflow container."
      }
    },
    {
      "name": "VSwitchId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "交换机ID。",
        "en": "The vSwitch ID."
      }
    },
    {
      "name": "VpcId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "VPC ID。",
        "en": "The VPC ID."
      }
    },
    {
      "name": "WorkerServerlessReplicas",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "Worker节点扩展的数量。",
        "en": "The number of elastic worker nodes."
      }
    },
    {
      "name": "WorkspaceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "DMS工作空间ID。",
        "en": "The ID of the DMS workspace."
      }
    },
    {
      "name": "ZoneId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Region下的可用区ID。",
        "en": "The ID of the zone where the instance will be created."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "创建Airflow实例",
    "en": "CreateAirflow"
  },
  "descriptions": {
    "zh": "在工作空间下创建Airflow实例。",
    "en": "Creates an Airflow instance in a workspace."
  }
}