      "description": {
        "zh": "Data Agent标题（支持模糊查询）",
        "en": "The Data Agent title. Fuzzy match is supported."
      }
    },
    {
      "name": "WorkspaceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "协作空间 ID",
