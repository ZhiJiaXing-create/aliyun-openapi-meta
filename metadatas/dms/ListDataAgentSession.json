{
  "name": "ListDataAgentSession",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "CreateEndTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "会话创建结束时间",
        "en": "The end time of the session creation period."
      }
    },
    {
      "name": "CreateStartTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "会话创建开始时间",
        "en": "The start time of the session creation period."
      }
    },
    {
      "name": "CustomAgentId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "自定义Agent Id",
        "en": "The custom agent ID."
      }
    },
    {
      "name": "DMSUnit",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "当前 DMS 单元",
        "en": "The current DMS unit."
      }
    },
    {
      "name": "IsSaved",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否仅获取已收藏的会话",
        "en": "Specifies whether to retrieve only favorited sessions."
      }
    },
    {
      "name": "Mode",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页页码",
        "en": "The page number."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页记录数",
        "en": "The number of records per page."
      }
    },
    {
      "name": "QueryType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "会话类型，指定协作空间的情况下必传",
        "en": "The session type. This parameter is required if a workspace is specified."
