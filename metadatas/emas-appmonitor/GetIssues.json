{
  "name": "GetIssues",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppKey",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "项目AppKey",
        "en": "Project AppKey"
      }
    },
    {
      "name": "BizModule",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务模块\n- exception(异常分析)\n- lag(卡顿分析)\n- custom(自定义异常)\n- crash(崩溃分析)\n- h5JsError(h5-JS错误)\n- h5WhiteScreen(h5-白屏)",
        "en": "Business module\n- exception (exception analysis)\n- lag (lag analysis)\n- custom (custom exception)\n- crash (crash analysis)\n- h5JsError (H5 JS error)\n- h5WhiteScreen (H5 white screen)"
      }
    },
    {
      "name": "Filter",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "筛选条件",
        "en": "Filter conditions"
      }
    },
    {
      "name": "Name",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "错误名（用于模糊搜索）",
        "en": "Error name (for fuzzy search)"
      }
    },
    {
      "name": "OrderBy",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序键\n- ErrorDeviceRate(崩溃设备率)\n- ErrorDeviceCount(崩溃设备数)\n- ErrorCount(崩溃数)\n- ErrorRate(崩溃率)",
        "en": "Sort key\n- ErrorDeviceRate (error device rate)\n- ErrorDeviceCount (error device count)\n- ErrorCount (error count)\n- ErrorRate (error rate)"
      }
    },
    {
      "name": "OrderType",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方式\n- asc(升序)\n- desc(降序)",
        "en": "Sort order\n- asc (ascending)\n- desc (descending)"
      }
    },
    {
      "name": "Os",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "os类型\n- iphoneos(苹果)\n- android(安卓)\n- harmony(鸿蒙)\n- h5(H5)",
        "en": "OS type\n- iphoneos (iOS)\n- android (Android)\n- harmony (HarmonyOS)\n- h5 (H5)"
      }
    },
    {
      "name": "PageIndex",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页页号",
        "en": "Page number"
      }
    },
    {
      "name": "PageSize",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页页大小",
        "en": "Page size"
      }
    },
    {
      "name": "Status",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "错误状态\n- 1(NEW)\n- 2(OPEN)\n- 3(CLOSE)\n- 4(FIXED)",
        "en": "Error status\n- 1 (NEW)\n- 2 (OPEN)\n- 3 (CLOSE)\n- 4 (FIXED)"
      }
    },
    {
      "name": "TimeRange",
      "position": "Body",
      "type": "Struct",
      "required": true,
      "description": {
        "zh": "时间范围",
        "en": "Time range"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取错误聚合列表",
    "en": "Get the aggregated error list"
  },
  "descriptions": {
    "zh": "应用接入崩溃SDK后并上报对应崩溃，可以通过该接口获取对应的错误聚合列表。",
    "en": "After integrating the crash SDK into an application and reporting crashes, you can use this API to retrieve the corresponding aggregated error list."
  }
}