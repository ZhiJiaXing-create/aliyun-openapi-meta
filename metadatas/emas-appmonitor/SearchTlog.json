{
  "name": "SearchTlog",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppKey",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "应用appKey",
        "en": "Application AppKey."
      }
    },
    {
      "name": "BeginDate",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "查询结束时间，Unix 毫秒；必须 EndDate >= BeginDate",
        "en": "The start time of the query, in Unix milliseconds. EndDate must be greater than or equal to BeginDate."
      }
    },
    {
      "name": "DeviceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "设备id",
        "en": "Device ID."
      }
    },
    {
      "name": "EndDate",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "条件拉取筛选结束时间，Unix 毫秒，非 USER 模式使用。",
        "en": "The end time for conditional pull filtering, in Unix milliseconds. Used in non-USER mode."
      }
    },
    {
      "name": "Keyword",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "日志内容关键词",
        "en": "Log content keyword."
      }
    },
    {
      "name": "LevelJson",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "日志级别 JSON 数组字符串",
        "en": "JSON array string of log levels."
      }
    },
    {
      "name": "Os",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "os类型\n- iphoneos\n- android",
        "en": "OS type.\n- iphoneos\n- android"
      }
    },
    {
      "name": "PageIndex",
      "position": "Body",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页页号",
        "en": "Page number for pagination."
      }
    },
    {
      "name": "PageSize",
      "position": "Body",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "页大小",
        "en": "Page size."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询设备日志数据",
    "en": "SearchTlog"
  },
  "descriptions": {
    "zh": "应用需提前接入性能分析SDK",
    "en": "The application must integrate the Application Performance Monitoring SDK in advance."
  }
}