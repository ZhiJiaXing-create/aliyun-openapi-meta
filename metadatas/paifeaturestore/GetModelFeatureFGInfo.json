{
  "name": "GetModelFeatureFGInfo",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/instances/[InstanceId]/modelfeatures/[ModelFeatureId]/fginfo",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID，可从接口ListInstances获取。",
        "en": "The instance ID. Call the ListInstances operation to obtain the instance ID."
      }
    },
    {
      "name": "ModelFeatureId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "模型特征ID，可从接口ListModelFeatures获取。",
        "en": "The model feature ID. Call the ListModelFeatures operation to obtain the model feature ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取模型特征的fg.json文件配置信息",
    "en": "Obtain the configuration information of the fg.json file for a model feature"
  },
  "example": {
    "unifiedCli": "aliyun paifeaturestore get-model-feature-fg-info --instance-id fs-cn-00000000 --model-feature-id 3 --region cn-hangzhou",
    "legacyCli": "aliyun paifeaturestore GET /api/v1/instances/fs-cn-00000000/modelfeatures/3/fginfo --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}