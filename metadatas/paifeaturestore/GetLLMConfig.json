{
  "name": "GetLLMConfig",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/instances/[InstanceId]/llmconfigs/[LLMConfigId]",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID，可通过接口ListInstances获取。",
        "en": "The ID of the instance. You can get this ID by calling the ListInstances operation."
      }
    },
    {
      "name": "LLMConfigId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "大模型调用信息配置ID。",
        "en": "The ID of the LLM call configuration."
      }
    },
    {
      "name": "RegionId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "区域ID。",
        "en": "The region ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取大模型配置信息",
    "en": "Retrieve LLM Configuration Information"
  },
  "example": {
    "unifiedCli": "aliyun paifeaturestore get-llm-config --instance-id fs-00000000 --llm-config-id llm_config1 --biz-region-id cn-hangzhou --region cn-hangzhou",
    "legacyCli": "aliyun paifeaturestore GET /api/v1/instances/fs-00000000/llmconfigs/llm_config1 --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}