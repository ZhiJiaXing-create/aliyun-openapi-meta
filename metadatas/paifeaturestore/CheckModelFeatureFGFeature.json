{
  "name": "CheckModelFeatureFGFeature",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/api/v1/instances/[InstanceId]/modelfeatures/[ModelFeatureId]/action/checkfgfeature",
