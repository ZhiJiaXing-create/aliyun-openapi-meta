{
  "name": "GetModelFeatureFGFeature",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/instances/[InstanceId]/modelfeatures/[ModelFeatureId]/fgfeature",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID，可从接口ListInstances获取。",
        "en": "The ID of the instance. You can call the ListInstances operation to obtain the ID."
      }
    },
    {
      "name": "ModelFeatureId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "模型特征ID，可从接口ListModelFeatures获取。",
        "en": "The ID of the model feature. You can call the ListModelFeatures operation to obtain the ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取模型特征的FG特征配置信息",
    "en": "Obtain the FG feature configuration information of a model feature."
  },
  "example": {
    "unifiedCli": "aliyun paifeaturestore get-model-feature-fg-feature --instance-id fs-cn-00000000 --model-feature-id 3 --region cn-hangzhou",
    "legacyCli": "aliyun paifeaturestore GET /api/v1/instances/fs-cn-00000000/modelfeatures/3/fgfeature --region cn-hangzhou --header \"Content-Type=application/json\""
