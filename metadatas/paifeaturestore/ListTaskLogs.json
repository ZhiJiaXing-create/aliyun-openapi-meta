{
  "name": "ListTaskLogs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/instances/[InstanceId]/tasks/[TaskId]/logs",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID，可从接口ListInstances获取。",
        "en": "The instance ID. You can get it by calling the ListInstances API."
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，起始值为1，默认值为10。",
        "en": "The page number. The minimum value is 1. The default value is 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页大小，默认值为10。",
        "en": "The number of entries to return on each page. Default value: 10."
      }
    },
    {
      "name": "TaskId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务ID，可从接口ListTasks获取。",
        "en": "The task ID. You can get it by calling the ListTasks API."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取任务日志",
    "en": "Retrieve task logs"
  },
  "example": {
    "unifiedCli": "aliyun paifeaturestore list-task-logs --instance-id fs-cn-00000000 --task-id 4 --page-number 1 --page-size 10 --region cn-hangzhou",
    "legacyCli": "aliyun paifeaturestore GET /api/v1/instances/fs-cn-00000000/tasks/4/logs --region cn-hangzhou --PageSize 10 --PageNumber 1 --header \"Content-Type=application/json\""
  }
}