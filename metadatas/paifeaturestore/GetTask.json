{
  "name": "GetTask",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/instances/[InstanceId]/tasks/[TaskId]",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID，可从接口ListInstances获取。",
        "en": "The instance ID. Call the ListInstances API to obtain this ID."
      }
    },
    {
      "name": "TaskId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务ID，可从接口ListTasks获取。",
        "en": "The task ID. Call the ListTasks API to obtain this ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取任务详细信息",
    "en": "Obtain job details"
  },
  "example": {
    "unifiedCli": "aliyun paifeaturestore get-task --instance-id fs-cn-00000000 --task-id 3 --region cn-hangzhou",
    "legacyCli": "aliyun paifeaturestore GET /api/v1/instances/fs-cn-00000000/tasks/3 --region cn-hangzhou --header \"Content-Type=application/json\""
