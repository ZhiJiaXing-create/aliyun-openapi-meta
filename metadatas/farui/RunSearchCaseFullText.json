{
  "name": "RunSearchCaseFullText",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/[workspaceId]/farui/search/case/fulltext",
  "parameters": [
    {
      "name": "appId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用ID",
        "en": "The application ID."
      }
    },
    {
      "name": "filterCondition",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "过滤条件",
        "en": "The filter condition."
      }
    },
    {
      "name": "pageParam",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "分页参数",
        "en": "The paging parameters."
      }
    },
    {
      "name": "query",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待查询问题",
        "en": "The question to query."
      }
    },
    {
      "name": "queryKeywords",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "检索关键词数组",
        "en": "An array of search keywords."
      }
    },
    {
      "name": "referLevel",
      "position": "Body",
      "type": "String",
