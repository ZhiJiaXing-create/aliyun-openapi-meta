{
  "name": "ListTemplate",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Keyword",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "搜索模板名称关键字",
        "en": "A keyword for searching template names."
      }
    },
    {
      "name": "MaxResults",
      "position": "Body",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页大小",
        "en": "The number of entries per page."
      }
    },
    {
      "name": "NextToken",
      "position": "Body",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "页码",
        "en": "The page number."
      }
    },
    {
      "name": "OrderType",
      "position": "Body",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "排序字段：\n- 1：按更新时间排序\n- 2：按创建时间排序\n- 3：按系统推荐排序\n- 4：按使用次数排序\n- 不输入任何值或输入除了1，2，3，4之外的任意整数：按系统推荐排序",
        "en": "The field to sort by:\n\n- 1: Sort by update time.\n\n- 2: Sort by creation time.\n\n- 3: Sort by system recommendation.\n\n- 4: Sort by usage count.\n\n- If you do not specify this parameter or specify an integer other than 1, 2, 3, or 4, the results are sorted by system recommendation."
      }
    },
    {
      "name": "ResourceGroupId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源组ID",
        "en": "The resource group ID."
      }
    },
    {
      "name": "Tag",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "标签列表。",
        "en": "The list of tags."
      },
      "sub_parameters": [
        {
          "name": "Key",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键",
            "en": "The tag key."
          }
        },
        {
          "name": "Value",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值",
            "en": "The tag value."
          }
        }
      ]
    },
    {
      "name": "TagList",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "模板的标签",
        "en": "The tags of the template."
      }
    },
    {
      "name": "Type",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "“public”代表开放模板，“private”代表私有模板。",
        "en": "public indicates a public template. private indicates a private template."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询模板列表",
    "en": "ListTemplate"
  }
}