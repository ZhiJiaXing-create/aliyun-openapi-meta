{
  "name": "ListApplication",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Keyword",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用名称中的关键字",
        "en": "The keyword to search for in application names."
      }
    },
    {
      "name": "MaxResults",
      "position": "Body",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "结果值的分页大小不能小于最小值 1，也不能大于最大值 50。",
        "en": "The number of entries to return on each page. The value must be an integer from 1 to 50."
      }
    },
    {
      "name": "NextToken",
      "position": "Body",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "结果值的分页页码不能小于最小值 1，不能大于最大值 10000。",
        "en": "The page number for the returned results. The value must be an integer from 1 to 10000."
      }
    },
    {
      "name": "OrderType",
      "position": "Body",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "1 更新时间<br>2 创建时间",
        "en": "The sorting order. Valid values:1: Sort by update time.<br>2: Sort by creation time.<br>"
      }
    },
    {
      "name": "ResourceGroupId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源组的 ID。",
        "en": "The ID of the resource group."
      }
    },
    {
      "name": "ResourceId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源ID",
        "en": "The ID of the resource."
      }
    },
    {
      "name": "ShowHide",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否显示隐藏方案,默认为true,true显示,false不显示",
        "en": "Specifies whether to show hidden applications. Default value: \\`true\\`.- \\`true\\`: Shows hidden applications.- \\`false\\`: Does not show hidden applications."
      }
    },
    {
      "name": "Status",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用的状态。",
        "en": "The status of the application."
      }
    },
    {
      "name": "TemplateId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模板ID",
        "en": "The ID of the template."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取应用列表",
    "en": "ListApplication"
  }
}