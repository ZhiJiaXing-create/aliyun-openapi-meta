{
  "name": "CreateAsyncPredict",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Content",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "预测内容，最大长度：1024字节。",
        "en": "The prediction content. Maximum length: 1024 bytes."
      }
    },
    {
      "name": "DetailTag",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文本实体抽取类型模型，是否返回详细抽取结果。可选值：true/false。",
        "en": "Specifies whether to return detailed extraction results for text entity extraction models. Valid values: true and false."
      }
    },
    {
      "name": "FetchContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "返回预测文本",
        "en": "The prediction text to return."
      }
    },
    {
      "name": "FileContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文件内容Base64编码。",
        "en": "The Base64-encoded file content."
      }
    },
    {
      "name": "FileType",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文件类型",
        "en": "The file type."
      }
    },
    {
      "name": "FileUrl",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文件HTTP保存地址。",
        "en": "The HTTP URL where the file is stored."
      }
    },
    {
      "name": "ModelId",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "模型ID。根据服务名称和服务版本创建异步预测的时候，此参数不必传；否则必传。",
        "en": "The model ID. Not required when creating an asynchronous prediction by service name and service version. Required otherwise."
      }
    },
    {
      "name": "ModelVersion",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "要获取的物模型版本号。不传入此参数，则返回已发布的最新版本。根据模型ID调用异步预测接口的时候传此参数。",
        "en": "The version number of the model. If this parameter is not specified, the latest published version is returned. Specify this parameter when calling the asynchronous prediction operation by model ID."
      }
    },
    {
      "name": "ServiceName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "服务名称。",
        "en": "The service name."
      }
    },
    {
      "name": "ServiceVersion",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "服务版本。",
        "en": "The service version."
      }
    },
    {
      "name": "TopK",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "设置返回top结果数量。",
        "en": "The number of top results to return."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "创建一个异步预测",
    "en": "Create an asynchronous prediction"
  }
}