{
  "name": "ModifyFlowRule",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AhasRegionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "地域。",
        "en": "The region."
      }
    },
    {
      "name": "ControlBehavior",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "流控效果。0表示快速失败，1表示预热启动，2表示排队等待。",
        "en": "The flow control behavior. Valid values: 0: fast fail. 1: warm-up. 2: queue waiting."
      }
    },
    {
      "name": "LimitOrigin",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "来源应用。",
        "en": "The source application."
      }
    },
    {
      "name": "MaxQueueingTimeMs",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "超时时间。当controlBehavior值为2（排队等待）时，需要设置该字段。",
        "en": "The timeout period, in milliseconds. This parameter is required when ControlBehavior is set to 2 (queue waiting)."
      }
    },
    {
      "name": "Namespace",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "命名空间。",
        "en": "The namespace."
      }
    },
    {
      "name": "RefResource",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "关联接口名、入口资源名。当统计维度relationStrategy值为1（关联接口）或2（链路入口）时，需要设置该字段。",
        "en": "The name of the associated interface or the entrance resource name. This parameter is required when RelationStrategy is set to 1 (associated interface) or 2 (chain entrance)."
      }
    },
    {
      "name": "RelationStrategy",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "统计维度。0表示当前接口，1表示关联接口，2表示链路入口。",
        "en": "The statistical dimension. Valid values: 0: current interface. 1: associated interface. 2: chain entrance."
      }
    },
    {
      "name": "RuleId",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "规则ID。",
        "en": "The rule ID."
      }
    },
    {
      "name": "Threshold",
      "position": "Query",
      "type": "Float",
      "required": false,
      "description": {
        "zh": "流控阈值。",
        "en": "The flow control threshold."
      }
    },
    {
      "name": "ThresholdMode",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "流控阈值模式。",
        "en": "The flow control threshold mode."
      }
    },
    {
      "name": "WarmUpPeriodSec",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "预热时间。当controlBehavior值为1（预热启动）时，需要设置该字段。",
        "en": "The warm-up period, in seconds. This parameter is required when ControlBehavior is set to 1 (warm-up)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "修改流控规则",
    "en": "Modify a flow control rule"
  }
}