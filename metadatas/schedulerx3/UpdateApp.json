        "en": "The task execution queue size.\n\n> Sets the maximum number of concurrent task instances in the application group. Additional task instances are queued for execution and not discarded."
      }
    },
    {
      "name": "Title",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "标题内容。",
        "en": "The title."
      }
    },
    {
      "name": "WorkerId",
      "position": "Body",
      "type": "Integer",
      "required": false
