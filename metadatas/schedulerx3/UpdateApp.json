{
  "name": "UpdateApp",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AccessToken",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "登录态访问令牌。",
        "en": "The access token."
      }
    },
    {
      "name": "AppName",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称。",
        "en": "The application name."
      }
    },
    {
      "name": "ClusterId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "集群ID。",
        "en": "The cluster ID."
      }
    },
    {
      "name": "EnableLog",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否开启日志。\n\n- true：开启。\n\n- false：关闭。",
        "en": "Specifies whether to enable logging.\n\n- `true`: Enables logging.\n\n- `false`: Disables logging."
      }
    },
    {
      "name": "LabelRouteStrategy",
      "position": "Body",
      "type": "Integer",
      "required": false
    },
    {
      "name": "MaxConcurrency",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
