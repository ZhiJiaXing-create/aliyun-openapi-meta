{
  "name": "ListScheduleTimes",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称。",
        "en": "The application name."
      }
    },
    {
      "name": "Calendar",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "日历。",
        "en": "The name of the calendar to use for scheduling, such as a business day calendar."
      }
    },
    {
      "name": "ClusterId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "集群ID。",
        "en": "The cluster ID."
      }
    },
    {
      "name": "TimeExpression",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "时间表达式。",
        "en": "The time expression, such as a cron expression."
      }
    },
    {
      "name": "TimeType",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "时间类型，目前仅支持cron。\n- 1：cron。",
        "en": "The time type. The only supported type is cron.\n\n- 1: cron"
      }
    },
    {
      "name": "TimeZone",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "时区。",
        "en": "The time zone used to evaluate the time expression."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取指定时间类型和表达式未来5次调度时间",
    "en": "Obtain the next five scheduled times for the specified time type and expression"
  }
}