{
  "name": "QuickDeployCluster",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "CertManaged",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否自动生成证书。\n\n- true：是\n\n- false：否",
        "en": "Specifies whether to automatically generate a certificate.\n\n- true: Yes\n- false: No"
      }
    },
    {
      "name": "ClusterName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "集群名称。",
        "en": "The cluster name."
      }
    },
    {
      "name": "InstanceList",
      "position": "Query",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "密码机实例列表。",
        "en": "The list of HSM instances."
      }
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "地域ID。",
        "en": "The region ID."
      }
    },
    {
      "name": "VSwitchIdList",
      "position": "Query",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "集群配置的交换机列表。",
        "en": "The list of vSwitches for the cluster."
      }
    },
    {
      "name": "VpcId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "密码机实例所属VPC ID。",
        "en": "The ID of the VPC to which the HSM instance belongs."
      }
    },
    {
      "name": "WhiteList",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "集群访问白名单列表。",
        "en": "The access whitelist for the cluster."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "快速部署集群",
    "en": "QuickDeployCluster"
  },
  "descriptions": {
    "zh": "- 所选密码机实例至少包含两个可用区。\n\n- 虚拟交换机至少选择两个，且不包含重复可用区。",
    "en": "- You must select HSM instances from at least two zones.\n- You must select at least two vSwitches from different zones."
  }
}