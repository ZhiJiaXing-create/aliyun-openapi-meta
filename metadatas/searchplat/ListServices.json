{
  "name": "ListServices",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/platform/workspaces/[workspaceName]/services",
  "parameters": [
    {
      "name": "modelType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模型类型\n\n- system 系统内置模型\n- deployment 自定义部署模型",
        "en": "The model type. Valid values:\n\n- system: built-in model\n- deployment: custom deployment model."
      }
    },
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "服务名称",
        "en": "The service name."
      }
    },
    {
      "name": "serviceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "服务ID",
        "en": "The service ID."
      }
    },
    {
      "name": "serviceType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "服务类型",
        "en": "The service type."
      }
    },
    {
      "name": "workspaceName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作空间名称",
        "en": "The workspace name."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取所有服务列表",
    "en": "Retrieve all services"
  }
