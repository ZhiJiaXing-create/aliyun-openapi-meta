{
  "name": "ListFunctionInstances",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/platform/workspaces/[workspaceName]/functions/[functionName]/instances",
  "parameters": [
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "功能名称",
        "en": "The feature name."
      }
    },
    {
      "name": "functionType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "功能类型",
        "en": "The feature type."
      }
    },
    {
      "name": "modelType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模型类型",
        "en": "The model type."
      }
    },
    {
      "name": "output",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "控制返回信息的丰富度\n- simple：只显示基本信息\n- normal：显示createParameters, cron等信息（默认）\n- detail: 返回训练任务信息",
        "en": "The level of detail in the response. Valid values:\n- simple: displays only basic information\n- normal: displays information such as createParameters and cron (default)\n- detail: returns training task information."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码",
        "en": "The page number."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页大小",
        "en": "The number of entries per page."
      }
    },
    {
      "name": "source",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例来源\n- builtin 系统实例\n- user 用户实例 （默认）\n- all 全部实例",
        "en": "The instance source. Valid values:\n- builtin: system instance\n- user: user instance (default)\n- all: all instances."
      }
    },
    {
      "name": "workspaceName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作空间名称",
        "en": "The workspace name."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取服务/模型配置详情列表",
    "en": "Retrieve service or model configuration details list"
  }
}