{
  "name": "ListCredentials",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/platform/workspaces/[workspaceName]/credentials",
  "parameters": [
    {
      "name": "keyword",
