{
  "name": "ListFunctionRestrictions",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/platform/workspaces/[workspaceName]/functions/[functionName]/restrictions/[restrictionName]",
  "parameters": [
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "配置类型\n\n- deployment",
        "en": "The configuration type.\n\n- deployment."
      }
    },
    {
      "name": "modelType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模型类型",
        "en": "The model type."
      }
    },
    {
      "name": "region",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "地域ID。",
        "en": "The region ID."
      }
    },
    {
      "name": "restrictionName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "限制名称\n- model: 平台支持的模型名称\n- instance_type: 平台支持的资源类型",
        "en": "The restriction name. Valid values:\n- model: model names supported by the platform\n- instance_type: resource types supported by the platform."
      }
    },
    {
      "name": "source",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "来源",
        "en": "The source."
      }
    },
    {
      "name": "workspaceName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作空间名称",
        "en": "The workspace name."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取功能的限制项",
    "en": "Retrieve restriction items of a feature"
  }
}