{
  "name": "PublishWebApplicationRevision",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/pop/v2/api/web/application-revisions/[ApplicationId]/revisions",
  "parameters": [
    {
      "name": "ApplicationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用ID。",
        "en": "The application ID."
      }
    },
    {
      "name": "NamespaceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "命名空间ID。",
        "en": "The namespace ID."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "版本配置信息。",
        "en": "The configurations of the version."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "发布Web应用版本",
    "en": "PublishWebApplicationRevision"
  },
  "descriptions": {
    "zh": "发布Web应用版本，即修改版本上相关的配置，并新建一个版本。",
    "en": "Publish a web application version. You can change the configurations of the version and create a new version."
  },
  "example": {
    "unifiedCli": "aliyun sae publish-web-application-revision --namespace-id cn-shanghai --application-id 7e41aff0-9eca-45c9-ac48-675e09000000 --region cn-hangzhou",
    "legacyCli": "aliyun sae POST /pop/v2/api/web/application-revisions/7e41aff0-9eca-45c9-ac48-675e09000000/revisions --region cn-hangzhou --NamespaceId 'cn-shanghai' --header \"Content-Type=application/json\" --body \"example-string\""
  }
}