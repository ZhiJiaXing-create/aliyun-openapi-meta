{
  "name": "UpdateSecret",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/pop/v1/sam/secret/secret",
  "parameters": [
    {
      "name": "NamespaceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
