        "en": "The ID of the namespace where the Secret instance is located. If the instance is in the default namespace, specify only the region ID, such as `cn-beijing`."
      }
    },
    {
      "name": "SecretData",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Secret数据。",
        "en": "The Secret data."
      }
    },
    {
      "name": "SecretId",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "Secret实例ID。",
        "en": "The ID of the Secret instance."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "UpdateSecret",
    "en": "UpdateSecret"
  },
  "example": {
    "unifiedCli": "aliyun sae update-secret --namespace-id cn-beijing:test --secret-id 16 --secret-data SecretData=.dockerconfigjson_:_ --region cn-hangzhou",
    "legacyCli": "aliyun sae PUT /pop/v1/sam/secret/secret --region cn-hangzhou --SecretId 16 --NamespaceId 'cn-beijing:test' --SecretData '{\"SecretData\":\".dockerconfigjson_:_\"}' --header \"Content-Type=application/json\""
  }
}