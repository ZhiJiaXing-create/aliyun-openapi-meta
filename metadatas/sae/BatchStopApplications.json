    "legacyCli": "aliyun sae PUT /pop/v1/sam/app/batchStopApplications --region cn-hangzhou --Version '1.0' --NamespaceId 'cn-shanghai' --AppIds 'ebf491f0-c1a5-45e2-b2c4-710dbe2a0000' --header \"Content-Type=application/json\""
  }
