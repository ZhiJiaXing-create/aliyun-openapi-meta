{
  "name": "UpdateApplicationVswitches",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/pop/v1/sam/app/updateAppVswitches",
  "parameters": [
    {
      "name": "AppId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用ID。",
        "en": "The application ID."
      }
    },
    {
      "name": "Deploy",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否立即部署。取值说明如下：\n\n- **true**：默认值，立即部署。\n- **false**：稍后部署。",
        "en": "Indicates whether to deploy the application immediately. Valid values:\n\n- **true**: Deploys the application immediately. This is the default.\n\n- **false**: The application is not deployed."
      }
    },
    {
      "name": "MinReadyInstanceRatio",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "最小存活实例数百分比。",
        "en": "The minimum percentage of ready instances."
      }
    },
    {
      "name": "MinReadyInstances",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "最小存活实例数。",
        "en": "The minimum number of ready instances."
      }
    },
    {
      "name": "VSwitchId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "交换机ID。",
        "en": "The vSwitch ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新交换机配置",
    "en": "UpdateApplicationVswitches"
  },
  "example": {
    "unifiedCli": "aliyun sae update-application-vswitches --app-id 0099b7be-5f5b-4512-a7fc-56049ef10000 --vswitch-id vsw-2ze559r1z1bpwqxwp0000 --deploy true --min-ready-instances 1 --min-ready-instance-ratio 1 --region cn-hangzhou",
    "legacyCli": "aliyun sae PUT /pop/v1/sam/app/updateAppVswitches --region cn-hangzhou --AppId '0099b7be-5f5b-4512-a7fc-56049ef10000' --MinReadyInstances 1 --VSwitchId 'vsw-2ze559r1z1bpwqxwp0000' --Deploy true --MinReadyInstanceRatio 1 --header \"Content-Type=application/json\""
  }
}