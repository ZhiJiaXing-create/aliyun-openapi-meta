{
  "name": "RunHotword",
  "deprecated": false,
  "protocol": "HTTPS|SSE",
  "method": "POST",
  "pathPattern": "/miaodu/stream/runHotword",
  "parameters": [
    {
      "name": "DocId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文档ID",
        "en": "Document ID."
      }
    },
    {
      "name": "ModelName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户自定义模型名称",
        "en": "Name of the custom model."
      }
    },
    {
      "name": "Prompt",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "提示词",
        "en": "Prompt."
      }
    },
    {
      "name": "ReferenceContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "要从中提取热词的文档内容，不为空则按该内容提取，为空则按docId提取",
        "en": "Document content to extract hotwords from. If not empty, extract hotwords from this content. If empty, extract hotwords using the DocId."
      }
    },
    {
      "name": "SessionId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "会话ID。",
        "en": "Session ID."
      }
    },
    {
      "name": "WorkspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "阿里云百炼业务空间唯一标识：获取[业务空间ID（Workspace ID）](~~2782167~~)",
        "en": "Unique identifier of the Alibaba Cloud Model Studio workspace. To get this ID, see [Workspace ID](~~2782167~~)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "抽取关键词",
    "en": "Extract Keywords"
  }
