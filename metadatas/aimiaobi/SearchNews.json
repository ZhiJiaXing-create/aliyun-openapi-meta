      "type": "String",
      "required": true,
      "description": {
        "zh": "业务空间唯一标识：[AgentKey](~~3027170~~)",
        "en": "The unique ID of the workspace. For more information, see [AgentKey](~~3027170~~)."
      }
    },
    {
