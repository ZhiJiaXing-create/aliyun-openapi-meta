{
  "name": "SaveMaterialDocument",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentKey",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务空间唯一标识：[AgentKey](~~2587494~~)",
        "en": "Unique identifier for the workspace: [AgentKey](~~2587494~~)"
      }
    },
    {
      "name": "Author",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "作者",
        "en": "Author"
      }
    },
    {
      "name": "BothSavePrivateAndShare",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否同时将素材保存为私有库与共享库",
        "en": "Is the material saved to both the private library and the shared library?"
      }
    },
    {
      "name": "DocKeywords",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "文档标签用于分类等",
        "en": "Document tags used for classification, etc."
      }
    },
    {
      "name": "DocType",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "文档类型 (html: 网页, plainText: 纯文本, image: 图片, pdf: pdf, word: word, excel: excel, csv: csv, jsonLine: jsonLine)",
        "en": "Document type (html: web page, plainText: plain text, image: image, pdf: pdf, word: word, excel: excel, csv: csv, jsonLine: jsonLine)"
      }
    },
    {
      "name": "ExternalUrl",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "外部客户上传的URL，仅用作记录保存",
        "en": "URL uploaded by external customers, used only for record keeping"
      }
    },
    {
      "name": "HtmlContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "带格式的内容",
        "en": "Formatted content"
      }
    },
    {
      "name": "PubTime",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "发布时间,格式：yyyy-MM-dd HH:mm:ss",
        "en": "Publication time, format: yyyy-MM-dd HH:mm:ss"
      }
    },
    {
      "name": "ShareAttr",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "共享属性：0：个人私有，1：业务空间范围内共享",
        "en": "Sharing attribute: 0: private, 1: shared within the workspace"
      }
    },
    {
      "name": "SrcFrom",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文档来源 (UserUpload: 用户上传, IntellijSearch: 智搜, HotViewPoint: 热点视角)",
        "en": "Document source (UserUpload: User Upload, IntellijSearch: Intelligent Search, HotViewPoint: Hot Viewpoint)"
      }
    },
    {
      "name": "Summary",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "摘要",
        "en": "Summary"
      }
    },
    {
      "name": "TextContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "解析后的文本内容，对于图片来说为空",
        "en": "Parsed text content, empty for images"
      }
    },
    {
      "name": "Title",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文档标题",
        "en": "Document title"
      }
    },
    {
      "name": "Url",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "素材的URL",
        "en": "URL of the material"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "保存素材",
    "en": "Save Material"
  }
}