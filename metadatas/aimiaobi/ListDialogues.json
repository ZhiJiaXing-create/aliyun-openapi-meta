{
  "name": "ListDialogues",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentKey",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务空间唯一标识：[AgentKey](~~2587494~~)",
        "en": "Unique identifier for the workspace: [AgentKey](~~2587494~~)"
      }
    },
    {
      "name": "Current",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "当前页码",
        "en": "Page number of the current page."
      }
    },
    {
      "name": "DialogueType",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "生成类型：1：创作；2：智搜（默认）",
        "en": "Generation type. Valid values: 1 (creation) and 2 (intelligent search). Default value: 2."
      }
    },
    {
      "name": "EndTime",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "结束时间",
        "en": "End time."
      }
    },
    {
      "name": "Size",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页条数：默认10",
        "en": "Number of items per page. Default value: 10."
      }
    },
    {
      "name": "StartTime",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "开始时间",
        "en": "Start time."
      }
    },
    {
      "name": "TaskId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务唯一标识\n\n> \n> TaskId默认无需填写，系统将自动生成。当后续任务填写的TaskId相同时，表示这些任务属于同一组对话。",
        "en": "Unique identifier for the task.\n\n> You do not need to specify TaskId. The system generates it automatically. If you use the same TaskId in later tasks, those tasks belong to the same conversation group."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "生成历史列表",
    "en": "Generation History List"
  }
}