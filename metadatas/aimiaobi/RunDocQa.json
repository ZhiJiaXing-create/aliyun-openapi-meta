{
  "name": "RunDocQa",
  "deprecated": false,
  "protocol": "HTTPS|SSE",
  "method": "POST",
  "pathPattern": "/miaodu/stream/runDocQA",
  "parameters": [
    {
      "name": "CategoryIds",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "过滤目录Id数组，只在SearchSource为fromIndexLib时有效",
        "en": "Array of folder IDs for filtering. This parameter takes effect only when SearchSource is set to fromIndexLib."
      }
    },
    {
      "name": "ConversationContexts",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "历史上下文内容数组",
        "en": "Array of historical context content"
      },
      "sub_parameters": [
        {
          "name": "Content",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "问答内容",
            "en": "Q&A pair content"
          }
        },
        {
          "name": "Role",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "角色",
            "en": "Role"
          }
        }
      ]
    },
    {
      "name": "DocIds",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "多个文档Id数组",
        "en": "Array of multiple document IDs"
      }
    },
    {
      "name": "ModelName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户自定义模型名称",
        "en": "Custom model name defined by the User"
      }
    },
    {
      "name": "Query",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "问题",
        "en": "Question"
      }
    },
    {
      "name": "ReferenceContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "提问者主动提供的关联内容",
        "en": "Associated content actively provided by the questioner"
      }
    },
    {
      "name": "SearchSource",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "搜索源",
        "en": "Search source"
      }
    },
    {
      "name": "SessionId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "对话ID",
        "en": "Conversation ID"
      }
    },
    {
      "name": "WorkspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "阿里云百炼业务空间 ID。获取方式请参见[如何使用业务空间](~~2782167~~)。",
        "en": "Alibaba Cloud Model Studio workspace ID. For details on how to obtain it, see [How to Use Workspaces](~~2587495~~)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "文档问答（文章问答/多模态文件问答）",
    "en": "Document Q&A (Article Q&A / Multimodal File Q&A)"
  }
}