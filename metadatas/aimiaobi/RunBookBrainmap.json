    {
      "name": "WorkspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "阿里云百炼业务空间唯一标识：获取[业务空间ID（Workspace ID）](~~2782167~~)",
        "en": "The unique identifier for the Model Studio workspace. For more information, see [Workspace ID](~~2782167~~)."
      }
    }
