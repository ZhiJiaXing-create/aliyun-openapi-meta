{
  "name": "RunBookBrainmap",
  "deprecated": false,
  "protocol": "HTTPS|SSE",
  "method": "POST",
  "pathPattern": "/miaodu/stream/runBookBrainmap",
  "parameters": [
    {
      "name": "CleanCache",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否清理掉之前的缓存",
        "en": "Specifies whether to clear the cache. The default is `false`."
      }
    },
    {
      "name": "DocId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "文档ID",
        "en": "The document ID."
      }
    },
    {
      "name": "NodeNumber",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "第二级有几个节点",
        "en": "The number of nodes on the second level of the mind map."
      }
    },
    {
      "name": "Prompt",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "附加要求提示词",
        "en": "A prompt with additional instructions."
      }
    },
    {
      "name": "ResponseFormat",
      "position": "Body",
      "type": "Integer",
      "required": false
    },
    {
      "name": "SessionId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "会话ID。",
        "en": "The session ID."
      }
    },
    {
      "name": "WordNumber",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "节点文字的个数",
        "en": "The number of words per node."
      }
