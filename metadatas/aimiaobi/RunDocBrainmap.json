{
  "name": "RunDocBrainmap",
  "deprecated": false,
  "protocol": "HTTPS|SSE",
  "method": "POST",
  "pathPattern": "/miaodu/stream/runDocBrainmap",
  "parameters": [
    {
      "name": "CleanCache",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否清理掉之前的缓存",
        "en": "Indicates whether to clear the previous cache."
      }
    },
    {
      "name": "DocId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "文档ID",
        "en": "The document ID."
      }
    },
    {
      "name": "ModelName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户自定义模型名称",
        "en": "The name of the model to use."
      }
    },
    {
      "name": "NodeNumber",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "第二级有几个节点",
        "en": "The number of nodes to generate at the second level of the mind map."
      }
    },
    {
      "name": "Prompt",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "脑图自定义prompt要求",
        "en": "A custom prompt to guide the mind map generation."
      }
    },
    {
      "name": "ResponseFormat",
      "position": "Body",
      "type": "Integer",
      "required": false
    },
    {
      "name": "SessionId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "会话ID",
        "en": "The session ID."
      }
    },
    {
      "name": "WordNumber",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "节点文字的个数",
        "en": "The maximum number of words in each node."
      }
    },
    {
      "name": "WorkspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "阿里云百炼业务空间 ID。获取方式请参见[如何使用业务空间](~~2782167~~)",
        "en": "The ID of the Model Studio workspace. For more information, see [How to use a workspace](~~2782167~~)."
      }
    },
    {
      "name": "referenceContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "要生成脑图的内容，优先级高于docId",
        "en": "The source content for generating the mind map. This parameter takes precedence over `DocId`."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "全文脑图",
    "en": "Full-text mind map"
  }
}