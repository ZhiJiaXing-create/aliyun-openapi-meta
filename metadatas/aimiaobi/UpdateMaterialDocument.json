{
  "name": "UpdateMaterialDocument",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentKey",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务空间唯一标识：[AgentKey](~~2587494~~)",
        "en": "Unique identifier of the workspace: [AgentKey](~~2587494~~)"
      }
    },
    {
      "name": "Author",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "作者",
        "en": "Author"
      }
    },
    {
      "name": "DocKeywords",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "文档标签用于分类等",
        "en": "Document tags for categorization"
      }
    },
    {
      "name": "DocType",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "文档类型 (html: 网页, plainText: 纯文本, image: 图片, pdf: pdf, word: word, excel: excel, csv: csv, jsonLine: jsonLine)",
        "en": "Document type. Valid values: html, plainText, image, pdf, word, excel, csv, jsonLine"
      }
    },
    {
      "name": "ExternalUrl",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "外部客户上传的URL，仅用作记录保存",
        "en": "URL uploaded by an external customer. Used only for record keeping"
      }
    },
    {
      "name": "HtmlContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "带格式的内容",
        "en": "Formatted content"
      }
    },
    {
      "name": "Id",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "主键",
        "en": "Primary key"
      }
    },
    {
      "name": "PubTime",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "发布时间,格式：yyyy-MM-dd HH:mm:ss",
        "en": "Publication time in yyyy-MM-dd HH:mm:ss format"
      }
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ShareAttr",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "共享属性：0：个人私有，1：业务空间范围内共享",
        "en": "Sharing attribute. Valid values: 0 (private), 1 (shared within the workspace)"
      }
    },
    {
      "name": "SrcFrom",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文档来源 (UserUpload: 用户上传, IntellijSearch: 智搜, HotViewPoint: 热点视角)",
        "en": "Source of the document. Valid values: UserUpload, IntellijSearch, HotViewPoint"
      }
    },
    {
      "name": "Summary",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "摘要",
        "en": "Summary"
      }
    },
    {
      "name": "TextContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "解析后的文本内容，对于图片来说为空",
        "en": "Parsed text content. Empty for images"
      }
    },
    {
      "name": "Title",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文档标题",
        "en": "Document title"
      }
    },
    {
      "name": "Url",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "素材的URL",
        "en": "URL of the material"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新素材",
    "en": "Update Material"
