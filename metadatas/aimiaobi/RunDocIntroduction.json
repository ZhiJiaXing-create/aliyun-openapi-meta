{
  "name": "RunDocIntroduction",
  "deprecated": false,
  "protocol": "HTTPS|SSE",
  "method": "POST",
  "pathPattern": "/miaodu/stream/runDocIntroduction",
  "parameters": [
    {
      "name": "CleanCache",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "清除缓存",
        "en": "Purge cache"
      }
    },
    {
      "name": "DocId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "文档ID",
        "en": "Document ID"
      }
    },
    {
      "name": "IntroductionPrompt",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "导读内容自定义要求",
        "en": "Custom requirements for the document summary"
      }
    },
    {
      "name": "KeyPointPrompt",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "关键点自定义要求",
        "en": "Custom requirements for key points"
      }
    },
    {
      "name": "ModelName",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户自定义模型名称",
        "en": "User-defined model name"
      }
    },
    {
      "name": "SessionId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "对话ID",
        "en": "Conversation ID"
      }
    },
    {
      "name": "SummaryPrompt",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "总结内容自定义要求",
        "en": "Custom requirements for the summary content"
      }
    },
    {
      "name": "WorkspaceId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "阿里云百炼业务空间唯一标识：获取[业务空间ID（Workspace ID）](~~2782167~~)",
        "en": "Unique identifier (UUID) of the Alibaba Cloud Model Studio workspace. For more information, see [Workspace ID](~~2587495~~)."
      }
    },
    {
      "name": "referenceContent",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "要进行导读的内容，如果不为空，该值优先于docId",
        "en": "Content to generate the summary from. If not empty, this value takes precedence over docId."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "文档导读",
    "en": "Document Summary"
  }
}