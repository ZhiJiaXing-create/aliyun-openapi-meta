{
  "name": "SubmitDocClusterTask",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentKey",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "业务空间唯一标识：[AgentKey](~~2587494~~)",
        "en": "The unique ID of the workspace. For more information, see [AgentKey](~~2587494~~)."
      }
    },
    {
      "name": "Documents",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "文档列表",
        "en": "A list of documents."
      },
      "sub_parameters": [
        {
          "name": "Content",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "文档内容",
            "en": "The content of the document."
          }
        },
        {
          "name": "DocId",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "文档ID。用于在返回聚类文章时标识文章。如果文章列表中都不传则使用数组索引作为ID。如果部分传则会报错",
            "en": "The document ID. It is used to identify the document in the returned cluster results. If you do not provide an ID for any document, the array index is used instead. An error is reported if you provide IDs for only some of the documents."
          }
        },
        {
          "name": "Title",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "文档标题",
            "en": "The title of the document."
          }
        }
      ]
    },
    {
      "name": "SummaryLength",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "生成聚类的摘要字数限制",
        "en": "The character limit for the generated cluster summary."
      }
    },
    {
      "name": "TitleLength",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "生成聚类的标题字数限制",
        "en": "The character limit for the generated cluster title."
      }
    },
    {
      "name": "TopicCount",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "最大聚合总数",
        "en": "The maximum number of clusters."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "提交内容聚合任务",
    "en": "Submit a content aggregation job"
  }
}