{
  "name": "RebootECS",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/webapi/event/rebootEcs",
  "parameters": [
    {
      "name": "EventId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "系统事件ID。",
        "en": "The system event ID."
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例 ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "RebootTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "实例的重启时间。",
        "en": "The reboot time for the instance."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "重启集群ECS实例",
    "en": "RebootECS"
  },
  "descriptions": {
    "zh": "该接口为异步接口，实例的重启不是立即完成的，成功调用后，实例会先进入重启中（restarting）状态，当返回的状态为运行中（running）时代表重启成功。",
    "en": "This operation is asynchronous. The instance does not reboot immediately. After a successful call, the instance enters the Rebooting state. The reboot is complete when the instance status changes to Running."
  },
  "example": {
    "unifiedCli": "aliyun starrocks reboot-ecs --reboot-time 1772076782 --event-id 8c96a3fc8a0d4a48b5db5fdb9742fbbc --instance-id c-b25e21e243880000 --region cn-hangzhou",
    "legacyCli": "aliyun starrocks POST /webapi/event/rebootEcs --region cn-hangzhou --RebootTime 1772076782 --InstanceId 'c-b25e21e243880000' --EventId 8c96a3fc8a0d4a48b5db5fdb9742fbbc --header \"Content-Type=application/json\""
  }
}