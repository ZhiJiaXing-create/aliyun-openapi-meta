  "title": {
    "zh": "重启集群节点",
    "en": "RestartNodes"
  },
  "descriptions": {
    "zh": "该接口为异步接口，实例的重启不是立即完成的，成功调用后，实例会先进入重启中（restarting）状态，当返回的状态为运行中（running）时代表重启成功。",
    "en": "This API is asynchronous. The instance restart is not immediate. After a successful call, the instance enters the restarting state. The restart is complete when the returned status is running."
  },
  "example": {
    "unifiedCli": "aliyun starrocks restart-nodes --instance-id c-b25e21e243880000 --restart-node-groups '[{\"NodeGroupId\":\"ng-dcc7450e06a271b9\",\"NodeIds\":[\"fe-0\"],\"FastMode\":false}]' --region cn-hangzhou",
    "legacyCli": "aliyun starrocks POST /webapi/restart/restart --region cn-hangzhou --InstanceId 'c-b25e21e243880000' --header \"Content-Type=application/json\" --body {\"RestartNodeGroups\":[{\"NodeGroupId\":\"ng-dcc7450e06a271b9\",\"NodeIds\":[\"fe-0\"],\"FastMode\":false}]}"
  }
