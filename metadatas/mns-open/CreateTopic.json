{
  "name": "CreateTopic",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "EnableLogging",
      "position": "Body",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否开启日志管理功能。取值说明如下：\n\n- true：启用。\n\n- false：停用。\n默认值：false。",
        "en": "Specifies whether to enable the log management feature. Valid values:\n\n- true: Enabled.\n\n- false: Disabled.\nDefault value: false."
      }
    },
    {
      "name": "EnableSSE",
      "position": "Body",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "KmsKeyId",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "MaxMessageSize",
      "position": "Body",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "发送到该主题的消息体最大长度。\n取值范围：1024~ 65536，单位为Byte。\n默认值：65536。",
        "en": "The maximum length of the message body sent to the topic. Valid values: 1024 to 65536. Unit: bytes. Default value: 65536."
      }
    },
    {
      "name": "SseAlgorithm",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "SseType",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "资源标签列表。",
        "en": "The list of resource tags."
      },
      "sub_parameters": [
        {
          "name": "Key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签的key。",
            "en": "The key of the tag."
          }
        },
        {
          "name": "Value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值。",
            "en": "The value of the tag."
          }
        }
      ]
    },
    {
      "name": "TopicName",
      "position": "Body",
