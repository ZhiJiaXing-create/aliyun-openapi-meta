{
  "name": "SetOriginClientCertificateHostnames",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Hostnames",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "绑定的域名列表。",
        "en": "The hostnames to associate with the certificate."
      }
    },
    {
      "name": "Id",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "证书ID。",
        "en": "The ID of the certificate."
      }
    },
    {
      "name": "SiteId",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "站点ID。",
        "en": "The ID of the site."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "为域名粒度回源客户端证书绑定域名",
    "en": "Attach domain names to the origin fetch client certificate at the domain name granularity."
  },
  "example": {
    "unifiedCli": "aliyun esa set-origin-client-certificate-hostnames --site-id 1234567890000 --id babaabcd0000 --hostnames www.example.com --region cn-hangzhou",
    "legacyCli": "aliyun esa SetOriginClientCertificateHostnames --region cn-hangzhou --SiteId 1234567890000 --Id babaabcd0000 --Hostnames '[\"www.example.com\"]'"
  }
}