{
  "name": "ListABMetrics",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/abmetrics",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID，可通过接口[ListInstances](~~2411819~~)获取。",
        "en": "The instance ID. Call the [ListInstances](~~2411819~~) operation to obtain the ID."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "名称过滤。",
        "en": "The name to use for filtering metrics."
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码。",
        "en": "The page number."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页大小。",
        "en": "The number of entries to return per page."
      }
    },
    {
      "name": "Realtime",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否指标实时类型过滤。",
        "en": "Specifies whether to filter for real-time metrics."
      }
    },
    {
      "name": "SceneId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "场景ID，来源于[ListScenes](~~2402581~~)接口。",
        "en": "The scene ID. Call the [ListScenes](~~2402581~~) operation to obtain the ID."
      }
    },
    {
      "name": "TableMetaId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据表ID，可通过ListTableMetas获取。",
        "en": "The data table ID. Call the ListTableMetas operation to obtain the ID."
      }
    },
    {
      "name": "Type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "指标类型过滤。\n\n- Single-单一指标。\n\n- Derived-衍生指标。",
        "en": "The metric type. You can use this parameter to filter the results. Valid values:\n\n- `Single`: A single metric.\n\n- `Derived`: A derived metric."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取AB指标列表",
    "en": "Obtain the AB Metrics List"
  }
}