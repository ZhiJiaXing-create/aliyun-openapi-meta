{
  "name": "ListParams",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/params",
  "parameters": [
    {
      "name": "Encrypted",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "Environment",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "参数所属的环境。\n\n- Daily：日常环境\n- Pre：预发环境\n- Prod：生产环境",
        "en": "The environment to which the parameter belongs. Valid values:\n\n- Daily: A test environment for daily use.\n\n- Prepub: A staging environment that mirrors the production environment.\n\n- Product: The production environment."
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID，可通过接口ListInstances获取。",
        "en": "The instance ID. You can call the ListInstances operation to obtain it."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "参数名称。",
        "en": "The parameter name."
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码。",
        "en": "The page number."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页大小。",
        "en": "The number of entries to return on each page."
      }
    },
    {
      "name": "SceneId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "场景ID，可通过接口ListScenes获取。",
        "en": "The scene ID. You can call the ListScenes operation to obtain it."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取参数列表",
    "en": "Retrieve the parameter list"
  }
}