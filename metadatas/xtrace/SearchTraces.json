{
  "name": "SearchTraces",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用类型，取值为空或`XTRACE`，推荐设置为空。\n\n- 空：查询XTRACE和ARMS调用链。\n\n- `XTRACE`：只查询XTRACE调用链。",
        "en": "Application type. Valid values are empty or `XTRACE`. We recommend leaving this parameter empty.\n\n- Empty: Query traces from both XTRACE and ARMS.\n\n- `XTRACE`: Query only XTRACE traces."
      }
    },
    {
      "name": "EndTime",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "结束时间，精确到毫秒（ms）。",
        "en": "End time, in milliseconds (ms)."
      }
    },
    {
      "name": "MinDuration",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "大于某个时间跨度范围，单位为毫秒（ms）。例如，200表示大于200毫秒的数据。",
        "en": "Minimum duration threshold in milliseconds (ms). For example, 200 returns traces longer than 200 ms."
      }
    },
    {
      "name": "OperationName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Span名称，即某个跟踪点或埋点的名称。",
        "en": "Span name, which is the name of a trace point or instrumentation point."
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，例如，5表示第5页。",
        "en": "Page number. For example, 5 indicates page 5."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页的查询数据条数。",
        "en": "Number of trace records per page."
      }
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "地域ID。",
        "en": "Region ID."
      }
    },
    {
      "name": "Reverse",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "按照时间正序或者倒序排列。默认为`false`。取值：\n\n- `true`：倒序。\n\n- `false` ：顺序。",
        "en": "Sort order by time. Default value: `false`. Valid values:\n\n- `true`: Descending order.\n\n- `false`: Ascending order."
      }
    },
    {
      "name": "ServiceIp",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Span对应主机的IP地址。",
        "en": "IP address of the host where the span resides."
      }
    },
    {
      "name": "ServiceName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "微服务名称，又称为应用名称。",
        "en": "Microservice name, also known as application name."
      }
    },
    {
      "name": "StartTime",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "开始时间，精确到毫秒（ms）。",
        "en": "Start time, in milliseconds (ms)."
      }
    },
    {
      "name": "StatusCode",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "标签列表。",
        "en": "List of tags."
      },
      "sub_parameters": [
        {
          "name": "Key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键。",
            "en": "Tag key."
          }
        },
        {
          "name": "Value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值。",
            "en": "Tag value."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询调用链列表",
    "en": "SearchTraces"
  }
}