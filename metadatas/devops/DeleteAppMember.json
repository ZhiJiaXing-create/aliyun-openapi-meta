{
  "name": "DeleteAppMember",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/appstack/apps/[appName]/members",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用名",
        "en": "The application name."
      }
    },
    {
      "name": "organizationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "企业标识，也称企业id",
        "en": "The organization ID."
      }
    },
    {
      "name": "subjectId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "成员id，类型为User时为成员的阿里云UID",
        "en": "The member ID. If the member type is User, this value is the member's Alibaba Cloud UID."
      }
    },
    {
      "name": "subjectType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "成员类型，目前只支持User",
        "en": "The member type. The only supported value is User."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "删除应用成员",
    "en": "Delete an application member"
  }
}