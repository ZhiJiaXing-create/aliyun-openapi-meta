{
  "name": "PassReleaseStagePipelineValidate",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/appstack/apps/[appName]/releaseWorkflows/[releaseWorkflowSn]/releaseStages/[releaseStageSn]/executions/[executionNumber]:passPipelineValidate",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
