      "required": true,
      "description": {
        "zh": "应用名",
        "en": "The application name."
      }
    },
    {
      "name": "executionNumber",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段的执行记录编号",
        "en": "The execution number for the release stage."
      }
    },
    {
      "name": "jobId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务Id，可通过API https://help.aliyun.com/document_detail/2839080.html 获取任务Id",
        "en": "The job ID. To obtain this ID, call the API operation described at https\\://help.aliyun.com/document\\_detail/2839080.html."
      }
    },
    {
      "name": "organizationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "企业标识，也称企业id",
        "en": "The organization ID."
      }
    },
    {
      "name": "releaseStageSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段sn",
        "en": "The unique ID of the release stage."
      }
    },
    {
      "name": "releaseWorkflowSn",
      "position": "Path",
