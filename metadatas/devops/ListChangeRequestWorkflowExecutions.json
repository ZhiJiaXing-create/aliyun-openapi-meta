{
  "name": "ListChangeRequestWorkflowExecutions",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/appstack/apps/[appName]/changeRequests/[sn]/executions",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名",
        "en": "The application name."
      }
    },
    {
      "name": "orderBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "分页排序属性，决定根据何种属性进行记录排序；推荐在实现严格遍历时，使用 id 属性",
        "en": "The attribute to use for sorting records. For consistent traversal, use the `id` attribute."
      }
    },
    {
      "name": "organizationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "企业标识，也称企业id",
        "en": "The organization ID."
      }
    },
    {
      "name": "page",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "页面分页时使用，用于获取下一页内容，默认第1页",
        "en": "The page number to retrieve. The default is `1`."
      }
    },
    {
      "name": "perPage",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页尺寸参数，决定一页最多返回多少对象",
        "en": "Specifies the maximum number of records to return per page."
      }
    },
    {
      "name": "releaseStageSn",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发流程阶段唯一标识",
        "en": "The unique identifier of the release workflow stage."
      }
    },
    {
      "name": "releaseWorkflowSn",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发流程唯一标识",
        "en": "The unique identifier of the release workflow."
      }
    },
    {
      "name": "sn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "变更唯一标识",
        "en": "The unique change identifier."
      }
    },
    {
      "name": "sort",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "分页排序升降序，asc 为升序，desc 为降序；推荐在实现严格遍历时，使用升序",
        "en": "The sort order. For consistent traversal, use `asc`."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询变更研发流程运行记录",
    "en": "Query the Execution History of a Change Request Development Flow"
  }
}