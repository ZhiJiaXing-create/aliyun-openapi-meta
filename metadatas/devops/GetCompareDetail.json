{
  "name": "GetCompareDetail",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/repository/[repositoryId]/commits/compare/detail",
  "parameters": [
    {
      "name": "from",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "起始版本（指commitId）",
        "en": "The start version (commit ID)."
      }
    },
    {
      "name": "maxDiffByte",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "返回的最大diff字节数\n\n> 限制最大返回的字节数为24MB",
        "en": "The maximum size of the diff to return, in bytes.\n\n> The maximum value for this parameter is 24 MB (25,165,824 bytes)."
      }
    },
    {
      "name": "maxDiffFile",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "返回的最大文件数量\n\n> 限制最大安全返回的文件数量为5000",
        "en": "The maximum number of files to return.\n\n> The maximum value for this parameter is 5,000."
      }
    },
    {
      "name": "mergeBase",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否使用merge-base进行比较",
        "en": "Specifies whether to use the merge base for the comparison."
      }
    },
    {
      "name": "organizationId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "企业标识，也称企业id，字符串形式，可在云效访问链接中获取，如https://devops.aliyun.com/organization/【OrganizationId】",
        "en": "The organization ID. You can find this ID in the URL of the Alibaba Cloud DevOps console, for example, `https://devops.aliyun.com/organization/{OrganizationId}`."
      }
    },
    {
      "name": "repositoryId",
      "position": "Path",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "代码库ID",
        "en": "The repository ID."
      }
    },
    {
      "name": "to",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "截止版本（指commitId）",
        "en": "The end version (commit ID)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "Compare接口",
    "en": "Compare API"
  }
}