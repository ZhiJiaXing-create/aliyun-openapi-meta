{
  "name": "CancelExecutionReleaseStage",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/appstack/apps/[appName]/releaseWorkflows/[releaseWorkflowSn]/releaseStages/[releaseStageSn]/executions/[executionNumber]:cancel",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名",
        "en": "The application name."
      }
    },
    {
      "name": "executionNumber",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段的执行记录编号",
        "en": "The execution number of the release stage."
      }
    },
    {
      "name": "organizationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "企业标识，也称企业id",
        "en": "The organization ID."
      }
    },
    {
      "name": "releaseStageSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段sn",
        "en": "The serial number of the release stage."
      }
    },
    {
      "name": "releaseWorkflowSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发流程sn",
        "en": "The serial number of the release workflow."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "取消执行研发阶段流水线",
    "en": "Cancel the execution of a development-phase pipeline"
  }
}