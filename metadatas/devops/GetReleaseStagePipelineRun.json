{
  "name": "GetReleaseStagePipelineRun",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/appstack/apps/[appName]/releaseWorkflows/[releaseWorkflowSn]/releaseStages/[releaseStageSn]/executions/[executionNumber]:getPipelineRun",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名",
        "en": "The application name."
      }
    },
    {
      "name": "executionNumber",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段的执行记录编号",
        "en": "The execution number."
      }
    },
    {
      "name": "organizationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "企业标识，也称企业id",
        "en": "The organization ID."
      }
    },
    {
      "name": "releaseStageSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段sn",
        "en": "The release stage ID."
      }
    },
    {
      "name": "releaseWorkflowSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发流程sn",
        "en": "The release workflow ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取研发阶段流水线运行实例",
    "en": "Obtain R&D stage pipeline run instance"
