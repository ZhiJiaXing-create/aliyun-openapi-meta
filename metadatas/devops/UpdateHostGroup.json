{
  "name": "UpdateHostGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/organization/[organizationId]/hostGroups/[id]",
  "parameters": [
    {
      "name": "aliyunRegion",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "阿里云区域",
        "en": "Alibaba Cloud region"
      }
    },
    {
      "name": "ecsLabelKey",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "ecs标签Key",
        "en": "ECS label key"
      }
    },
    {
      "name": "ecsLabelValue",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "ecs标签value",
        "en": "ECS label value"
      }
    },
    {
      "name": "ecsType",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "暂只支持ECS_ALIYUN",
        "en": "Currently supports only ECS_ALIYUN"
      }
    },
    {
      "name": "envId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "环境id",
        "en": "Environment ID"
      }
    },
    {
      "name": "id",
      "position": "Path",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "主机组id",
        "en": "Host group ID"
      }
    },
    {
      "name": "machineInfos",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "机器信息，aliyunRegionId 机器所在aliyun region，machineSn 机器的sn, instanceName,主机名，ip主机ip",
        "en": "Machine information: aliyunRegionId is the Alibaba Cloud region where the machine resides; machineSn is the machine's serial number; instanceName is the hostname; ip is the host IP address."
      }
    },
    {
      "name": "name",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "主机组名称",
        "en": "Host group name"
      }
    },
    {
      "name": "organizationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "企业标识，也称企业id，字符串形式，可在云效访问链接中获取，如https://devops.aliyun.com/organization/【OrganizationId】",
        "en": "Organization identifier, also known as organization ID, in string format. It can be obtained from the Alibaba Cloud DevOps access URL, for example: https://devops.aliyun.com/organization/【OrganizationId】"
      }
    },
    {
      "name": "serviceConnectionId",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "服务连接id",
        "en": "Service connection ID"
      }
    },
    {
      "name": "tagIds",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "标签id，多个逗号分割",
        "en": "Tag IDs, separated by commas if multiple"
      }
    },
    {
      "name": "type",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "暂只支持ECS",
        "en": "Currently supports only ECS"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新主机组",
    "en": "Update Host Group"
  }
}