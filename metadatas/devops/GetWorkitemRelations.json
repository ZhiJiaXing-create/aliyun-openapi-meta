{
  "name": "GetWorkitemRelations",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/organization/[organizationId]/workitems/[workitemId]/getRelations",
  "parameters": [
    {
      "name": "organizationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "企业id",
        "en": "Organization ID"
      }
    },
    {
      "name": "relationType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "一共有BLOCKING，BLOCKED，ASSOCIATED， DUPLICATED，SUB， PARENT，一共6个待选值，只会获得工作项类型的关系项",
        "en": "There are six possible values: BLOCKING, BLOCKED, ASSOCIATED, DUPLICATED, SUB, and PARENT. Only relationships of work item type will be retrieved."
      }
    },
    {
      "name": "workitemId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作项id，同workitemidentifier，工作项唯一标识",
        "en": "Work item ID, same as workitemidentifier, the UUID of the work item"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获得工作项关联项",
    "en": "Obtain work item associations"
  },
  "descriptions": {
    "zh": "获得工作项关联项。",
    "en": "Obtain associated work items."
  }
}