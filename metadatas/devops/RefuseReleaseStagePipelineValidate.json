{
  "name": "RefuseReleaseStagePipelineValidate",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/appstack/apps/[appName]/releaseWorkflows/[releaseWorkflowSn]/releaseStages/[releaseStageSn]/executions/[executionNumber]:refusePipelineValidate",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名",
        "en": "The name of the application."
      }
    },
    {
      "name": "executionNumber",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段的执行记录编号",
        "en": "The execution number of the release stage."
      }
    },
    {
      "name": "jobId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务Id，可通过API https://help.aliyun.com/document_detail/2839080.html 获取任务Id",
        "en": "The job ID. You can call the `ListReleaseStageJobs` operation to get the job ID."
      }
    },
    {
      "name": "organizationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "企业标识，也称企业id",
        "en": "The ID of the organization."
      }
    },
    {
      "name": "releaseStageSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段sn",
        "en": "The serial number (sn) of the release stage."
      }
    },
    {
      "name": "releaseWorkflowSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发流程sn",
        "en": "The serial number (sn) of the release workflow."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "拒绝研发阶段流水线人工卡点",
    "en": "Deny a Manual Checkpoint in the R&D Pipeline"
  }
}