{
  "name": "ListAppReleaseStageExecutionIntegratedMetadata",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/appstack/apps/[appName]/releaseWorkflows/[releaseWorkflowSn]/releaseStages/[releaseStageSn]/executions/[executionNumber]/integratedMetadata",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名",
        "en": "The name of the application."
      }
    },
    {
      "name": "executionNumber",
      "position": "Path",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "研发阶段的执行记录编号",
        "en": "The execution number of the release stage."
      }
    },
    {
      "name": "organizationId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "企业标识，也称企业id",
        "en": "The ID of the organization."
      }
    },
    {
      "name": "releaseStageSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发阶段sn",
        "en": "The unique identifier of the release stage."
      }
    },
    {
      "name": "releaseWorkflowSn",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "研发流程sn",
        "en": "The unique identifier of the release workflow."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询研发阶段执行记录集成变更信息",
    "en": "Query Integration Change Information of Execution Records in the R&D Stage"
  }
}