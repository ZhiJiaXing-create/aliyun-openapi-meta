{
  "name": "CreateHostGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/organization/[organizationId]/hostGroups",
  "parameters": [
    {
      "name": "aliyunRegion",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "阿里云region",
        "en": "Alibaba Cloud region"
      }
    },
    {
      "name": "ecsLabelKey",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "ecs标签key",
        "en": "ECS label key"
      }
    },
    {
      "name": "ecsLabelValue",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "ecs标签value",
        "en": "ECS label value"
      }
    },
    {
      "name": "ecsType",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "ECS类型，暂支持ECS_ALIYUN",
        "en": "ECS type. Only ECS_ALIYUN is supported for now."
      }
    },
    {
      "name": "envId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "环境id",
        "en": "Environment ID"
      }
    },
    {
      "name": "machineInfos",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "aliyunRegionId 机器所在aliyun region，machineSn 机器的sn, instanceName,主机名，ip主机ip",
        "en": "aliyunRegionId: the Alibaba Cloud region where the machine is located; machineSn: the serial number of the machine; instanceName: hostname; ip: host IP address"
      }
    },
    {
      "name": "name",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "主机组名称",
        "en": "Host group name"
      }
    },
    {
      "name": "organizationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "企业标识，也称企业id，字符串形式，可在云效访问链接中获取，如https://devops.aliyun.com/organization/【OrganizationId】",
        "en": "Organization identity, also known as organization ID, in string format. It can be obtained from the Alibaba Cloud DevOps access URL, for example: https://devops.aliyun.com/organization/【OrganizationId】"
      }
    },
    {
      "name": "serviceConnectionId",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "服务连接id",
        "en": "Service connection ID"
      }
    },
    {
      "name": "tagIds",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "标签id，多个逗号分割",
        "en": "Tag IDs, separated by commas if multiple"
      }
    },
    {
      "name": "type",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "主机组类型，暂只支持ECS",
        "en": "Host group type. Only ECS is supported for now."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "创建主机组",
    "en": "Create a host group"
  }
}