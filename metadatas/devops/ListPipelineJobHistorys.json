{
  "name": "ListPipelineJobHistorys",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/organization/[organizationId]/pipeline/[pipelineId]/job/historys",
  "parameters": [
    {
      "name": "category",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务分类，暂时只支持DEPLOY",
        "en": "Job category; currently only DEPLOY is supported"
      }
    },
    {
      "name": "identifier",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务标识",
        "en": "Job identifier"
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "每页最大数据，最多支持50",
        "en": "Maximum number of data entries per page, up to 50 supported"
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "下一页token",
        "en": "Next page token"
      }
    },
    {
      "name": "organizationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "企业标识，也称企业id，字符串形式，可在云效访问链接中获取，如https://devops.aliyun.com/organization/【OrganizationId】",
        "en": "Organization identity, also known as organization ID, in string format. It can be obtained from the Alibaba Cloud DevOps access link, for example: https://devops.aliyun.com/organization/【OrganizationId】"
      }
    },
    {
      "name": "pipelineId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "流水线Id",
        "en": "Pipeline ID"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取流水线任务的执行历史",
    "en": "Retrieve Execution History of Pipeline Jobs"
  }
}