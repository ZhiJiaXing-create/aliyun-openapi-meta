{
  "name": "OrderList",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/airticket/v1/trade/order-list",
  "parameters": [
    {
      "name": "book_time_end",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "查询结束时间 13位时间戳",
        "en": "The query end time. The value is a 13-digit UNIX timestamp."
      }
    },
    {
      "name": "book_time_start",
      "position": "Query",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "查询开始时间 13位时间戳",
        "en": "The query start time. The value is a 13-digit UNIX timestamp."
      }
    },
    {
      "name": "page_index",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页索引,取值从1开始",
        "en": "The page index. The value starts from 1."
      }
    },
    {
      "name": "page_size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页大小",
        "en": "The page size."
      }
    },
    {
      "name": "status",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "订单状态 2:生单预定成功; 3:订单已支付; 4:订单成功; 5:订单关闭",
        "en": "The order status. Valid values:\n- 2: order creation succeeded.\n- 3: order paid.\n- 4: order succeeded.\n- 5: order closed."
      }
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "The access_token."
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "The language. Default value: the language configured for the buyer account."
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "OrderList",
    "en": "OrderList"
  }
}