{
  "name": "ChangeApply",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/airticket/v1/change/action-apply",
  "parameters": [
    {
      "name": "change_passenger_list",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "改签乘机人列表",
        "en": "The list of passengers for the change."
      },
      "sub_parameters": [
        {
          "name": "document",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "证件号",
            "en": "The document number."
          }
        },
        {
          "name": "first_name",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "乘机人名",
            "en": "The first name of the passenger."
          }
        },
        {
          "name": "last_name",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "乘机人姓",
            "en": "The last name of the passenger."
          }
        }
      ]
    },
    {
      "name": "changed_journeys",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "改签目标航程",
        "en": "The target journey for the change."
      },
      "sub_parameters": [
        {
          "name": "segment_list",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "改签目标航段列表",
            "en": "The list of target segments for the change."
          }
        }
      ]
    },
    {
      "name": "contact",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "改签联系人信息",
        "en": "The contact information for the change."
      }
    },
    {
      "name": "order_num",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "订单号",
        "en": "The order number."
      }
    },
    {
      "name": "remark",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "买家备注",
        "en": "The buyer remarks."
      }
    },
    {
      "name": "type",
      "position": "Body",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "改期类型0:自愿改期; 1:航班变动/航班取消",
        "en": "The change type. Valid values:\n- 0: voluntary change\n- 1: flight schedule change or flight cancellation."
      }
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "The access_token."
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "The language setting. Defaults to the buyer account configuration."
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "ChangeApply",
    "en": "ChangeApply"
  }
}