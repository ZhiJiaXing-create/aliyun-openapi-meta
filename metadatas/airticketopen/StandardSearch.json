{
  "name": "StandardSearch",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/airticket/v1/trade/action-standardsearch",
  "parameters": [
    {
      "name": "adults",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "成人乘客数 1-9",
        "en": "Number of adult passengers, range 1-9"
      }
    },
    {
      "name": "air_legs",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "行程数组 departure_city,departure_airport_list 二者至少一个不为空,departure_airport_list 有值时必须属于同一个城市; arrival_city,arrival_airport_list 二者至少一个不为空,arrival_airport_list 有值时必须属于同一个城市",
        "en": "Journey array. At least one of departure_city and departure_airport_list must be non-empty; when departure_airport_list has values, they must belong to the same city. At least one of arrival_city and arrival_airport_list must be non-empty; when arrival_airport_list has values, they must belong to the same city."
      },
      "sub_parameters": [
        {
          "name": "arrival_airport_list",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "到达机场三字码",
            "en": "Arrival airport three-letter code"
          }
        },
        {
          "name": "arrival_city",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "到达城市三字码",
            "en": "Arrival city three-letter code"
          }
        },
        {
          "name": "departure_airport_list",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "出发机场三字码",
            "en": "Departure airport three-letter code"
          }
        },
        {
          "name": "departure_city",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "出发城市三字码",
            "en": "Departure city three-letter code"
          }
        },
        {
          "name": "departure_date",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "起飞日期 (eg: yyyyMMdd)",
            "en": "Departure date (e.g.: yyyyMMdd)"
          }
        }
      ]
    },
    {
      "name": "cabin_class",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "不填写默认为 ALL_CABIN。舱等 ALL_CABIN:不限舱等; Y:经济舱; FC:头等舱和商务舱; S:超级经济舱; YS:经济舱和超级经济舱; YSC:经济舱、超级经济舱和商务舱;",
        "en": "Defaults to ALL_CABIN if not specified. Cabin class ALL_CABIN: All cabin classes; Y: Economy class; FC: First class and Business class; S: Premium Economy class; YS: Economy class and Premium Economy class; YSC: Economy class, Premium Economy class, and Business class;"
      }
    },
    {
      "name": "children",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "儿童乘客数 0-9",
        "en": "Number of child passengers, range 0-9"
      }
    },
    {
      "name": "infants",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "婴儿乘客数 0-9",
        "en": "Number of infant passengers, range 0-9"
      }
    },
    {
      "name": "search_control_options",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "搜索控制项，可选",
        "en": "Search control options, optional"
      }
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "access_token"
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "Language setting, defaults to buyer account configuration"
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "StandardSearch",
    "en": "StandardSearch"
  }
}