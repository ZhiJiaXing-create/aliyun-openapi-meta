{
  "name": "RefundApply",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/airticket/v1/refund/action-apply",
  "parameters": [
    {
      "name": "order_num",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "订单号",
        "en": "The order number."
      }
    },
    {
      "name": "refund_journeys",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "申请提退的行程",
        "en": "The journeys for the refund application."
      },
      "sub_parameters": [
        {
          "name": "segment_list",
          "position": "FormData",
          "type": "RepeatList",
          "required": true,
          "description": {
            "zh": "航段信息",
            "en": "The segment information."
          }
        }
      ]
    },
    {
      "name": "refund_passenger_list",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "申请退票的乘机人列表",
        "en": "The list of passengers for the refund application."
      },
      "sub_parameters": [
        {
          "name": "document",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "证件号",
            "en": "The document number of the passenger."
          }
        },
        {
          "name": "first_name",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "乘机人名",
            "en": "The first name of the passenger."
          }
        },
        {
          "name": "last_name",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "乘机人姓",
            "en": "The last name of the passenger."
          }
        }
      ]
    },
    {
      "name": "refund_type",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "退票类型 非自愿退票申请，要上传附件",
        "en": "The refund type. Attachments are required for involuntary refund applications."
      }
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "The access_token."
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "The language setting. Defaults to the buyer account configuration."
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "RefundApply",
    "en": "RefundApply"
  }
}