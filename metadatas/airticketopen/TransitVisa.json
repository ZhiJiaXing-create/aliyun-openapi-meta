{
  "name": "TransitVisa",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/airticket/v1/flight-data/transit-visa",
  "parameters": [
    {
      "name": "flight_segment_param_list",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "航段列表，列表中航段构成一个航程。size<=2。",
        "en": "The list of flight segments that constitute an itinerary. Maximum size: 2."
      },
      "sub_parameters": [
        {
          "name": "arrival_airport",
          "position": "Query",
          "type": "String",
          "required": true,
          "description": {
            "zh": "到达机场三字码",
            "en": "The three-letter IATA code of the arrival airport."
          }
        },
        {
          "name": "arrival_terminal",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "到达航站楼",
            "en": "The arrival terminal."
          }
        },
        {
          "name": "arrival_time",
          "position": "Query",
          "type": "Long",
          "required": true,
          "description": {
            "zh": "到达时间，13位时间戳",
            "en": "The arrival time. A 13-digit UNIX timestamp."
          }
        },
        {
          "name": "code_share",
          "position": "Query",
          "type": "Boolean",
          "required": true,
          "description": {
            "zh": "是否共享",
            "en": "Indicates whether the flight is a codeshare flight."
          }
        },
        {
          "name": "departure_airport",
          "position": "Query",
          "type": "String",
          "required": true,
          "description": {
            "zh": "出发机场三字码",
            "en": "The three-letter IATA code of the departure airport."
          }
        },
        {
          "name": "departure_terminal",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "出发航站楼",
            "en": "The departure terminal."
          }
        },
        {
          "name": "departure_time",
          "position": "Query",
          "type": "Long",
          "required": true,
          "description": {
            "zh": "出发时间，13位时间戳",
            "en": "The departure time. A 13-digit UNIX timestamp."
          }
        },
        {
          "name": "marketing_airline",
          "position": "Query",
          "type": "String",
          "required": true,
          "description": {
            "zh": "市场方航司",
            "en": "The marketing airline."
          }
        },
        {
          "name": "marketing_flight_no",
          "position": "Query",
          "type": "String",
          "required": true,
          "description": {
            "zh": "航班号",
            "en": "The flight number."
          }
        },
        {
          "name": "operating_airline",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "承运方航司",
            "en": "The operating airline."
          }
        },
        {
          "name": "stop_city_list",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "经停城市三字码",
            "en": "The three-letter IATA codes of stopover cities."
          }
        },
        {
          "name": "ticketing_airline",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "出票方航司",
            "en": "The ticketing airline."
          }
        }
      ]
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "The access token."
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "The language. Defaults to the buyer account configuration."
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "TransitVisa",
    "en": "TransitVisa"
  },
  "descriptions": {
    "zh": "航程过境签信息查询，接口输入航程信息，返回乘坐该航程是否存在过境签要求。只有中转/经停才是有效入参(中转/经停经过第三国)，当前支持的乘客默认为中国大陆旅客。",
    "en": "Queries transit visa requirements for a flight itinerary. You provide flight information, and the API returns whether a transit visa is required for the itinerary. Only transfer or stopover segments are valid input parameters (transfers or stopovers passing through a third country). The supported passenger type defaults to Chinese mainland travelers."
  }
}