{
  "name": "Enrich",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/airticket/v1/trade/action-enrich",
  "parameters": [
    {
      "name": "adults",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "成人乘客数 1-9",
        "en": "Number of adult passengers 1-9"
      }
    },
    {
      "name": "cabin_class",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "舱等 ALL_CABIN:不限舱等; Y:经济舱; FC:头等舱和商务舱; S:超级经济舱; YS:经济舱和超级经济舱; YSC:经济舱、超级经济舱和商务舱;",
        "en": "Cabin class ALL_CABIN: all cabin classes; Y: economy; FC: first class and business class; S: premium economy; YS: economy and premium economy; YSC: economy, premium economy, and business class;"
      }
    },
    {
      "name": "children",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "儿童乘客数 0-9",
        "en": "Number of child passengers 0-9"
      }
    },
    {
      "name": "infants",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "婴儿乘客数 0-9",
        "en": "Number of infant passengers 0-9"
      }
    },
    {
      "name": "journey_param_list",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "行程信息",
        "en": "Journey information"
      },
      "sub_parameters": [
        {
          "name": "arrival_city",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "到达城市三字码(大写)",
            "en": "Arrival city code (3-letter uppercase)"
          }
        },
        {
          "name": "departure_city",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "起飞城市三字码(大写)",
            "en": "Departure city code (3-letter uppercase)"
          }
        },
        {
          "name": "departure_date",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "起飞日期(yyyyMMdd)",
            "en": "Departure date (yyyyMMdd)"
          }
        },
        {
          "name": "segment_param_list",
          "position": "FormData",
          "type": "RepeatList",
          "required": true,
          "description": {
            "zh": "该程指定航段信息",
            "en": "Specified segment information for this journey"
          }
        }
      ]
    },
    {
      "name": "solution_id",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Search 返回的solution_id",
        "en": "solution_id returned by Search"
      }
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "access_token"
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "Multilingual, defaults to buyer account configuration"
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "Enrich",
    "en": "Enrich"
  },
  "descriptions": {
    "zh": "入参中 solution\\_id 和  journey\\_param\\_list 二选一，solution\\_id 需要从 Search 接口获取。",
    "en": "In the input parameters, choose either solution\\_id or journey\\_param\\_list. solution\\_id must be obtained from the Search API."
  }
}