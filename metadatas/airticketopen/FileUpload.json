{
  "name": "FileUpload",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/airticket/v1/attachment/action-upload",
  "parameters": [
    {
      "name": "file_content",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "附件图片形式文件上传，对图片进行 Base64编码，图片类型支持 .jpg|.png|.jpeg",
        "en": "The Base64-encoded string of the attachment image file. Supported image types: .jpg, .png, and .jpeg."
      }
    },
    {
      "name": "order_num",
      "position": "Body",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "正向订单号",
        "en": "The forward order number."
      }
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "The access_token."
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "The language setting. Uses the buyer account configuration by default."
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "FileUpload",
    "en": "FileUpload"
  }
}