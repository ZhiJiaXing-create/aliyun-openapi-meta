{
  "name": "CollectFlightLowestPrice",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/airticket/v1/data-collect/flight-lowest-price",
  "parameters": [
    {
      "name": "lowest_price_flight_info_list",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "低价的航班信息",
        "en": "The lowest-price flight information."
      },
      "sub_parameters": [
        {
          "name": "arrival_city",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "到达城市",
            "en": "The arrival city."
          }
        },
        {
          "name": "departure_city",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "出发城市",
            "en": "The departure city."
          }
        },
        {
          "name": "departure_date",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "出发日期 格式：yyyy-MM-dd",
            "en": "The departure date. Format: yyyy-MM-dd."
          }
        },
        {
          "name": "departure_flight_number",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "去程的航班号列表，多航段用,分割",
            "en": "The list of outbound flight numbers. Multiple segments are split by commas (,)."
          }
        },
        {
          "name": "market_total_price",
          "position": "FormData",
          "type": "Double",
          "required": true,
          "description": {
            "zh": "市场上竞品最低价,价格+税费(币种为美元)",
            "en": "The lowest competitor price in the market, including fare and taxes. The currency is USD."
          }
        },
        {
          "name": "request_id",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "请求id",
            "en": "The request ID."
          }
        },
        {
          "name": "return_date",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "往返场景下，返程日期，格式：yyyy-MM-dd",
            "en": "The return date for round-trip scenarios. Format: yyyy-MM-dd."
          }
        },
        {
          "name": "return_flight_number",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
            "zh": "返程的航班号列表，多航段用,分割",
            "en": "The list of return flight numbers. Multiple segments are split by commas (,)."
          }
        },
        {
          "name": "solution_id",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "Search/Enrich 返回的solution_id",
            "en": "The solution_id returned by Search/Enrich."
          }
        },
        {
          "name": "suez_total_price",
          "position": "FormData",
          "type": "Double",
          "required": true,
          "description": {
            "zh": "Suez 的报价,价格+税费(币种为美元)",
            "en": "The Suez quoted price, including fare and taxes. The currency is USD."
          }
        },
        {
          "name": "trip_type",
          "position": "FormData",
          "type": "Integer",
          "required": true,
          "description": {
            "zh": "航程类型:1表示单程；2表示往返",
            "en": "The trip type. Valid values:\n- 1: one-way\n- 2: round-trip."
          }
        }
      ]
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "The access_token."
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "The language. Defaults to the buyer account configuration."
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "CollectFlightLowestPrice",
    "en": "CollectFlightLowestPrice"
  },
  "descriptions": {
    "zh": "数据收集-低价航班信息。",
    "en": "Collects lowest-price flight information."
  }
}