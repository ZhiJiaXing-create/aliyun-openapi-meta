{
  "name": "Search",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/airticket/v1/trade/action-search",
  "parameters": [
    {
      "name": "adults",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "成人乘客数 1-9",
        "en": "The number of adult passengers. Valid values: 1 to 9."
      }
    },
    {
      "name": "air_legs",
      "position": "Body",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "行程数组",
        "en": "The journey array."
      },
      "sub_parameters": [
        {
          "name": "arrival_airport_list",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "到达机场三字码列表",
            "en": "The list of three-letter codes of arrival airports."
          }
        },
        {
          "name": "arrival_city",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "到达城市三字码",
            "en": "The three-letter code of the arrival city."
          }
        },
        {
          "name": "departure_airport_list",
          "position": "FormData",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "出发机场三字码列表",
            "en": "The list of three-letter codes of departure airports."
          }
        },
        {
          "name": "departure_city",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "出发城市三字码",
            "en": "The three-letter code of the departure city."
          }
        },
        {
          "name": "departure_date",
          "position": "FormData",
          "type": "String",
          "required": true,
          "description": {
            "zh": "起飞日期 (eg: yyyyMMdd)",
            "en": "The departure date (for example, yyyyMMdd)."
          }
        }
      ]
    },
    {
      "name": "cabin_class",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "舱等 ALL_CABIN:不限舱等; Y:经济舱; FC:头等舱和商务舱; S:超级经济舱; YS:经济舱和超级经济舱; YSC:经济舱、超级经济舱和商务舱;",
        "en": "The cabin class. Valid values: ALL_CABIN: all cabin classes. Y: economy class. FC: first class and business class. S: premium economy class. YS: economy class and premium economy class. YSC: economy class, premium economy class, and business class."
      }
    },
    {
      "name": "children",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "儿童乘客数 0-9",
        "en": "The number of child passengers. Valid values: 0 to 9."
      }
    },
    {
      "name": "infants",
      "position": "Body",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "婴儿乘客数 0-9",
        "en": "The number of infant passengers. Valid values: 0 to 9."
      }
    },
    {
      "name": "search_control_options",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "搜索控制项，可选",
        "en": "The search control options. This parameter is optional."
      }
    },
    {
      "name": "x-acs-airticket-access-token",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "access_token",
        "en": "The access token."
      }
    },
    {
      "name": "x-acs-airticket-language",
      "position": "Header",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言 默认取买家账号配置",
        "en": "The language. The default value is the language configured for the buyer account."
      }
    }
  ],
  "security": [
    "accessTokenAuth"
  ],
  "title": {
    "zh": "Search",
    "en": "Search"
  }
}