      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "业务类型",
        "en": "The business type."
      }
    },
    {
      "name": "contents",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "待分析的内容列表（contents、url二选一）",
        "en": "A list of content items to be analyzed. You must specify either the contents or url parameter."
      }
    },
    {
      "name": "extraInfo",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "额外信息",
        "en": "Additional information."
      }
    },
    {
