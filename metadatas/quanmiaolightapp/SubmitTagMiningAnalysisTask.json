        "en": "The output format."
      }
    },
    {
      "name": "tags",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "标签体系列表",
        "en": "A list of tag systems."
      },
      "sub_parameters": [
        {
          "name": "tagDefinePrompt",
          "position": "FormData",
          "type": "String",
          "required": false,
          "description": {
