    {
      "name": "workspaceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "阿里云百炼业务空间唯一标识：[获取workspaceId](~~2782167~~)",
        "en": "The unique identifier of the Alibaba Cloud Model Studio workspace. For more information, see [Get workspaceId](~~2782167~~)."
