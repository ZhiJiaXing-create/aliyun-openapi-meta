  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/[workspaceId]/quanmiao/lightapp/submitTagMiningAnalysisTask",
  "parameters": [
    {
      "name": "apiKey",
      "position": "Body",
      "type": "String",
