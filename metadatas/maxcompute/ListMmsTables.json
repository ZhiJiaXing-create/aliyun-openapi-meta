{
  "name": "ListMmsTables",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/mms/datasources/[sourceId]/tables",
  "parameters": [
    {
      "name": "dbId",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "库ID",
        "en": "The ID of the database."
      }
    },
    {
      "name": "dbName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "库名",
        "en": "The name of the database."
      }
    },
    {
      "name": "dstName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "目标MaxCompute table",
        "en": "The name of the destination MaxCompute table."
      }
    },
    {
      "name": "dstProjectName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "目标MaxCompute项目名",
        "en": "The name of the destination MaxCompute project."
      }
    },
    {
      "name": "dstSchemaName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "目标MaxCompute schema名，目标MaxCompute项目没有开启schema层时，该值为null",
        "en": "The name of the destination MaxCompute schema. This parameter is null if the destination MaxCompute project does not have a schema layer."
      }
    },
    {
      "name": "hasPartitions",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "分区表",
        "en": "The partitioned table."
      }
    },
    {
      "name": "lastDdlTimeEnd",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "lastDdlTime结束时间",
        "en": "The end of the time range for lastDdlTime."
      }
    },
    {
      "name": "lastDdlTimeStart",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "lastDdlTime开始时间",
        "en": "The start of the time range for lastDdlTime."
      }
    },
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "表名",
        "en": "The name of the table."
      }
    },
    {
      "name": "onlyName",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "只获取表的名字",
        "en": "Specifies whether to return only the names of the tables."
      }
    },
    {
      "name": "pageNum",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码",
        "en": "The page number."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页大小。",
        "en": "The number of entries to return on each page."
      }
    },
    {
      "name": "sorter.lastDdlTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "根据lastddltime排序",
        "en": "The sort order for lastDdlTime."
      }
    },
    {
      "name": "sorter.numRows",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "根据行数排序",
        "en": "The sort order for the number of rows."
      }
    },
    {
      "name": "sorter.size",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "根据数据大小排序",
        "en": "The sort order for the data size."
      }
    },
    {
      "name": "sourceId",
      "position": "Path",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "数据源ID",
        "en": "The ID of the data source."
      }
    },
    {
      "name": "status",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "迁移状态",
        "en": "The migration status."
      }
    },
    {
      "name": "type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "表类型",
        "en": "The table type."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出数据源内的表",
    "en": "ListMmsTables"
  },
  "example": {
    "unifiedCli": "aliyun maxcompute list-mms-tables --source-id 2000015 --only-name false --db-id 197 --db-name mms_test --name test --dst-project-name mms_test --dst-schema-name default --dst-name test --type MANAGED_TABLE --has-partitions true --status DONE --last-ddl-time-start 2024-12-17_15:44:42 --last-ddl-time-end 2024-12-19_15:44:42 --page-num 1 --page-size 10 --sorter-num-rows desc --sorter-size asc --sorter-last-ddl-time desc --region cn-hangzhou",
    "legacyCli": "aliyun maxcompute GET /api/v1/mms/datasources/2000015/tables --region cn-hangzhou --dstProjectName mms_test --hasPartitions true --dstName test --dbName mms_test --pageSize 10 --type MANAGED_TABLE --pageNum 1 --sorter.numRows desc --lastDdlTimeEnd '2024-12-19_15:44:42' --sorter.lastDdlTime desc --sorter.size asc --dbId 197 --name test --lastDdlTimeStart '2024-12-17_15:44:42' --onlyName false --dstSchemaName default --status '[\"DONE\"]' --header \"Content-Type=application/json\""
  }
}