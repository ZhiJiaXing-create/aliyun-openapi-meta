    "legacyCli": "aliyun maxcompute GET /api/v1/quotas/%E9%BB%98%E8%AE%A4%E9%A2%84%E4%BB%98%E8%B4%B9Quota_p_#_Chinese_name_needs_to_be_UTF-8_URL-encoded/query --region cn-hangzhou --tenantId 483212237127906 --AkProven 'example-string' --mock false --region 'cn-chengdu' --header \"Content-Type=application/json\""
