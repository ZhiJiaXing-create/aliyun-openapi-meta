{
  "name": "GetPackage",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/projects/[projectName]/packages/[packageName]",
  "parameters": [
    {
      "name": "packageName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "package名称",
        "en": "The name of the package."
      }
    },
    {
      "name": "projectName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "MaxCompute项目名称",
        "en": "The name of the MaxCompute project."
      }
    },
    {
      "name": "sourceProject",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "package所属项目。如果package 是install 的，此参数必填。",
        "en": "The project to which the package belongs. This parameter is required if the package is installed in the MaxCompute project."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取Package信息",
    "en": "GetPackage"
  },
  "example": {
    "unifiedCli": "aliyun maxcompute get-package --project-name projectA --package-name test_package --source-project projectB --region cn-hangzhou",
    "legacyCli": "aliyun maxcompute GET /api/v1/projects/projectA/packages/test_package --region cn-hangzhou --sourceProject projectB --header \"Content-Type=application/json\""
  }
}