{
  "name": "CreateDBInstance",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AddVPCIPs",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "是否将VPC网段加入到白名单中。取值说明：\n- 1：是\n- 0：否",
        "en": "Specifies whether to add the VPC CIDR block to the whitelist. Valid values:\n- 1: yes.\n- 0: no."
      }
    },
    {
      "name": "CacheSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "预留缓存大小。",
        "en": "The reserved cache size."
      }
    },
    {
      "name": "ChargeType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例的付费类型。取值：\n\n- **Postpaid**：后付费（按量付费）。\n\n- **Prepaid**：预付费（包年包月）。",
        "en": "The billing method of the instance. Valid values:\n\n- **Postpaid**: pay-as-you-go.\n\n- **Prepaid**: subscription."
      }
    },
    {
      "name": "ClientToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用于保证请求的幂等性，防止重复提交请求。由客户端生成该参数值，要保证在不同请求间唯一，最大值不超过64个ASCII字符，且该参数值中不能包含非ASCII字符。",
        "en": "The client token that is used to ensure the idempotency of the request and prevent repeated submissions. The value is generated by the client, must be unique across different requests, can contain a maximum of 64 ASCII characters, and cannot contain non-ASCII characters."
      }
    },
    {
      "name": "ClusterNodeCount",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "ClusterNodeType",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigPatternType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例应用的配置模板",
        "en": "The configuration template applied to the instance."
      }
    },
    {
      "name": "ConnectionString",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据库连接地址。",
        "en": "The database endpoint."
      }
    },
    {
      "name": "DBInstanceClass",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例规格，您可以通过调用[DescribeAllDBInstanceClass](~~2853363~~)接口查询实例规格。",
        "en": "The instance specifications. You can call the [DescribeAllDBInstanceClass](~~2853363~~) operation to query available instance specifications."
      }
    },
    {
      "name": "DBInstanceDescription",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例备注信息。",
        "en": "The description of the instance."
      }
    },
    {
      "name": "DeployScheme",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例部署模式",
        "en": "The deployment mode of the instance."
      }
    },
    {
      "name": "Engine",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据库类型，默认值为**selectdb**。",
        "en": "The database type. Default value: **selectdb**."
      }
    },
    {
      "name": "EngineVersion",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据库版本，默认值为**4.1**。取值说明：\n\n- 4.0。\n\n- 4.1。",
        "en": "The database engine version. Default value: **4.1**. Valid values:\n\n- 4.0.\n\n- 4.1."
      }
    },
    {
      "name": "MultiZone",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "多可用区配置。\n\n> \n> - 当DeployScheme为multi_az时，该参数生效，且为必填。",
        "en": "The multi-zone configuration.\n\n> \n> - This parameter takes effect and is required when DeployScheme is set to multi_az."
      },
      "sub_parameters": [
        {
          "name": "VSwitchIds",
          "position": "Query",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "交换机ID列表。",
            "en": "The list of vSwitch IDs."
          }
        },
        {
          "name": "ZoneId",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "可用区ID。",
            "en": "The zone ID."
          }
        }
      ]
    },
    {
      "name": "Period",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "指定预付费集群为包年或包月类型。取值说明：\n\n- **Year**：包年类型。\n- **Month**：包月类型。\n> 仅当**ChargeType**为**Prepaid**时，该参数才生效且为必填参数。",
        "en": "The unit of the subscription duration for the subscription cluster. Valid values:\n\n- **Year**: yearly upfront.\n- **Month**: monthly upfront.\n> This parameter takes effect and is required only when **ChargeType** is set to **Prepaid**."
      }
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "地域ID。",
        "en": "The region ID."
      }
    },
    {
      "name": "ResourceGroupId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源组ID。",
        "en": "The resource group ID."
      }
    },
    {
      "name": "ScaleMax",
      "position": "Query",
      "type": "Double",
      "required": false
    },
    {
      "name": "ScaleMin",
      "position": "Query",
      "type": "Double",
      "required": false
    },
    {
      "name": "SecurityIPList",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例的IP白名单，多个IP地址请用英文逗号（,）分隔。",
        "en": "The IP address whitelist of the instance. Separate multiple IP addresses with commas (,)."
      }
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "实例标签列表信息。",
        "en": "The list of instance tags."
      },
      "sub_parameters": [
        {
          "name": "Key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键。",
            "en": "The tag key."
          }
        },
        {
          "name": "Value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值。",
            "en": "The tag value."
          }
        }
      ]
    },
    {
      "name": "UsedTime",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "指定预付费实例的购买时长。取值说明：\n- 当Period为Year时，UsedTime取值范围为：1、2、3、4、5（整数）。\n- 当Period为Month时，UsedTime取值范围为：1~12（整数）。\n>仅当**ChargeType**为**Prepaid**时，该参数才生效且为必填参数。",
        "en": "The subscription duration of the instance. Valid values:\n- If Period is set to Year, valid values of UsedTime are 1, 2, 3, 4, and 5.\n- If Period is set to Month, valid values of UsedTime are 1 to 12.\n>This parameter takes effect and is required only when **ChargeType** is set to **Prepaid**."
      }
    },
    {
      "name": "VSwitchId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "交换机ID。",
        "en": "The vSwitch ID."
      }
    },
    {
      "name": "VpcId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "VPC ID。",
        "en": "The VPC ID."
      }
    },
    {
      "name": "ZoneId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "可用区ID。",
        "en": "The zone ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "创建实例",
    "en": "Create an instance"
  },
  "descriptions": {
    "zh": "不支持删除包年包月实例。",
    "en": "Subscription instances cannot be deleted."
  }
}