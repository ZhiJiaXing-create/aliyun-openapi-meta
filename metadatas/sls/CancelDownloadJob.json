{
  "name": "CancelDownloadJob",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/downloadjobs/[downloadJobName]?action=STOP",
  "parameters": [
    {
      "name": "downloadJobName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "日志下载任务名称",
        "en": "Log download job name"
      }
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Project名称",
        "en": "Project name"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "取消日志下载任务",
    "en": "Cancel Log Download Job"
  },
  "descriptions": {
    "zh": "当前支持区域：河源",
    "en": "Currently supported region: Heyuan"
  },
  "example": {
    "unifiedCli": "aliyun sls cancel-download-job --project ali-test-project --download-job-name download-123 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /downloadjobs/download-123?action=STOP --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}