{
  "name": "ListAnnotationData",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/ml/annotationdataset/[datasetId]/annotationdata",
  "parameters": [
    {
      "name": "datasetId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "数据集唯一标识",
        "en": "The unique ID of the dataset."
      }
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "起始行",
        "en": "The starting position of the paged query."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页查询时，设置的每页行数。",
        "en": "The number of entries to return on each page."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取数据列表",
    "en": "ListAnnotationData"
  },
  "descriptions": {
    "zh": "该接口服务地址只能是华东 2（上海）、新加坡。",
    "en": "This operation is available only in the China (Shanghai) and Singapore regions."
  },
  "example": {
    "unifiedCli": "aliyun sls list-annotation-data --offset 0 --size 100 --dataset-id cb8cc4eb51a85e823471cdb368fae9be --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /ml/annotationdataset/cb8cc4eb51a85e823471cdb368fae9be/annotationdata --region cn-hangzhou --offset 0 --size 100 --header \"Content-Type=application/json\""
  }
}