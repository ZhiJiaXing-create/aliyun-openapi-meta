{
  "name": "ListOSSIngestions",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/ossingestions",
  "parameters": [
    {
      "name": "logstore",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "查询开始行。默认值为0。",
        "en": "The number of entries to skip for pagination. The default value is 0."
      }
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Project名称",
        "en": "The name of the Project."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "单次查询需要获取的OSS导入任务数量",
        "en": "The maximum number of OSS import tasks to return in a single request."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出OSS导入任务",
    "en": "ListOSSIngestions"
  },
  "example": {
    "unifiedCli": "aliyun sls list-oss-ingestions --project ali-test-project --offset 0 --size 10 --logstore example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /ossingestions --project ali-test-project --region cn-hangzhou --offset 0 --size 10 --logstore 'example-string' --header \"Content-Type=application/json\""
  }
}