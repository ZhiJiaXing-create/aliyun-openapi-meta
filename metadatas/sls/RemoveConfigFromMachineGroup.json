{
  "name": "RemoveConfigFromMachineGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/machinegroups/[machineGroup]/configs/[configName]",
  "parameters": [
    {
      "name": "configName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Logtail配置名称。",
        "en": "The name of the Logtail configuration."
      }
    },
    {
      "name": "machineGroup",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "机器组名称。",
        "en": "The name of the machine group."
      }
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Project名称。",
        "en": "The name of the project."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "删除机器组Logtail配置",
    "en": "RemoveConfigFromMachineGroup"
  },
  "descriptions": {
    "zh": "Host由Project名称和日志服务Endpoint构成，您需要在Host中指定Project。",
    "en": "Host consists of a project name and a Simple Log Service endpoint. You must specify a project in Host."
  },
  "example": {
    "unifiedCli": "aliyun sls remove-config-from-machine-group --project ali-test-project --machine-group test-group --config-name test-logtail --region cn-hangzhou",
    "legacyCli": "aliyun sls DELETE /machinegroups/test-group/configs/test-logtail --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}