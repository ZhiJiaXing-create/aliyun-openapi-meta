{
  "name": "StopOSSExport",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/ossexports/[ossExportName]?action=STOP",
  "parameters": [
    {
      "name": "ossExportName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "已存在的唯一任务名称",
        "en": "The unique name of the job. Make sure that the job exists."
      }
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Project名称",
        "en": "The name of the project."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "停止OSS投递任务",
    "en": "StopOSSExport"
  },
  "example": {
    "unifiedCli": "aliyun sls stop-oss-export --project my-project --oss-export-name export-oss-1234567890-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /ossexports/export-oss-1234567890-123456?action=STOP --project my-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}