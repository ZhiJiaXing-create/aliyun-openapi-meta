{
  "name": "ListOSSExports",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/ossexports",
  "parameters": [
    {
      "name": "logstore",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "en": "The number of entries to return. The default value is 10."
      }
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "查询开始行，默认值为0。",
        "en": "The line number from which to start the query. The default value is 0."
      }
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Project名称",
        "en": "The name of the project."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "指定查询数量，默认值为10。",
        "en": "The number of jobs to return. The default value is 10."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出OSS投递任务",
    "en": "ListOSSExports"
  },
  "example": {
    "unifiedCli": "aliyun sls list-oss-exports --project my-project --offset 0 --size 10 --logstore example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /ossexports --project my-project --region cn-hangzhou --offset 0 --size 10 --logstore 'example-string' --header \"Content-Type=application/json\""
  }
}