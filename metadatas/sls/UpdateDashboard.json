    "legacyCli": "aliyun sls PUT /dashboards/dashboard-1609294922657-434834 --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"charts\":[\"example-string\"],\"displayName\":\"Method_pv\",\"description\":\"test_dashboard.\",\"attribute\":{\"key\":\"example-string\"},\"dashboardName\":\"dashboard-1609294922657-434834\"}"
