{
  "name": "ListAzureBlobIngestion",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/azureblobingestions",
  "parameters": [
    {
      "name": "logstore",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "en": "The name of the logstore. If specified, the operation returns only tasks from this logstore."
      }
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "en": "The number of tasks to skip before returning results. Default: 0."
      }
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "en": "The name of the project."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "en": "The number of tasks to return per page. Range: 0 to 500. Default: 100."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出AzureBlob导入任务",
    "en": "ListAzureBlobIngestion"
  },
  "example": {
    "unifiedCli": "aliyun sls list-azure-blob-ingestion --project example-string --offset 1 --size 1 --logstore example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /azureblobingestions --project example-string --region cn-hangzhou --offset 1 --size 1 --logstore 'example-string' --header \"Content-Type=application/json\""
  }
}