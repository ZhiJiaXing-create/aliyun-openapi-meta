    "legacyCli": "aliyun sls PUT /logging --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"loggingDetails\":[{\"type\":\"consumergroup_log\",\"logstore\":\"my-logstore\"}],\"loggingProject\":\"my-project\"}"
