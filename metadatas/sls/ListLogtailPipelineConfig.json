{
  "name": "ListLogtailPipelineConfig",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/pipelineconfigs",
  "parameters": [
    {
      "name": "configName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "流水线配置名称",
        "en": "The name of the pipeline configuration."
      }
    },
    {
      "name": "configType",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "logstoreName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "logstore名称",
        "en": "The name of the Logstore."
      }
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "起始行",
        "en": "The line from which to start the query."
      }
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Project名称",
        "en": "The name of the project."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "每页的流水线配置数量",
        "en": "The number of pipeline configurations to return on each page."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "罗列Logtail流水线配置",
    "en": "ListLogtailPipelineConfig"
  },
  "example": {
    "unifiedCli": "aliyun sls list-logtail-pipeline-config --project test-project --offset 0 --size 20 --logstore-name test-logstore --config-name logtail-config-sample --config-type example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /pipelineconfigs --project test-project --region cn-hangzhou --configName 'logtail-config-sample' --offset 0 --size 20 --logstoreName 'test-logstore' --configType 'example-string' --header \"Content-Type=application/json\""
  }
}