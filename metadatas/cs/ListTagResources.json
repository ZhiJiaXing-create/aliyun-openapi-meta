{
  "name": "ListTagResources",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/tags",
  "parameters": [
    {
      "name": "next_token",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "下一个查询开始的令牌。",
        "en": "The token that determines the start point of the next query."
      }
    },
    {
      "name": "region_id",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "地域ID。",
        "en": "The region ID."
      }
    },
    {
      "name": "resource_ids",
      "position": "Query",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "要查询的资源ID列表。",
        "en": "The list of resource IDs to query."
      }
    },
    {
      "name": "resource_type",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "资源类型。\n\nCLUSTER：集群。",
        "en": "The resource type.\n\nCLUSTER: cluster."
      }
    },
    {
      "name": "tags",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "要查询的标签列表，限制最多包含20个子项。",
        "en": "The list of tags to query. A maximum of 20 items can be specified."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询集群的标签列表",
    "en": "Query the tag list of a cluster"
  },
  "example": {
    "unifiedCli": "aliyun cs list-tag-resources --resource-ids c71cf3d796c374bf48644482cb0c30000 --resource-type CLUSTER --biz-region-id cn-beijing --tags example-string --next-token 000 --region cn-hangzhou",
    "legacyCli": "aliyun cs GET /tags --region cn-hangzhou --resource_type CLUSTER --region_id 'cn-beijing' --resource_ids '[\"c71cf3d796c374bf48644482cb0c30000\"]' --next_token 000 --tags '[\"example-string\"]' --header \"Content-Type=application/json\""
  }
}