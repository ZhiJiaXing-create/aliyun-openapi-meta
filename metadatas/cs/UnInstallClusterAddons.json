{
  "name": "UnInstallClusterAddons",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/clusters/[ClusterId]/components/uninstall",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "集群ID。",
        "en": "The cluster ID."
      }
    },
    {
      "name": "addons",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "组件列表。",
        "en": "The list of components."
      },
      "sub_parameters": [
        {
          "name": "cleanup_cloud_resources",
          "position": "Body",
          "type": "Boolean",
          "required": false,
          "description": {
            "zh": "卸载组件时是否清理相关的云资源。\n-  true：清理。\n- false：保留。",
            "en": "Specifies whether to clean up associated cloud resources when uninstalling the component. Valid values:\n- true: Clean up.\n- false: Retain."
          }
        },
        {
          "name": "name",
          "position": "Body",
          "type": "String",
          "required": false,
          "description": {
            "zh": "待卸载的组件名称。您可以调用[ListClusterAddonInstances](~~2667940~~)接口查询集群中已安装的组件。",
            "en": "The name of the component to uninstall. You can call the [ListClusterAddonInstances](~~2667940~~) operation to query the components installed in a cluster."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "卸载集群组件",
    "en": "Uninstall cluster components"
  },
  "example": {
    "unifiedCli": "aliyun cs un-install-cluster-addons --cluster-id c5b5e80b0b64a4bf6939d2d8fbbc50000 --region cn-hangzhou",
    "legacyCli": "aliyun cs POST /clusters/c5b5e80b0b64a4bf6939d2d8fbbc50000/components/uninstall --region cn-hangzhou --header \"Content-Type=application/json\" --body [{\"cleanup_cloud_resources\":true,\"name\":\"ack-node-problem-detector\"}]"
  }
}