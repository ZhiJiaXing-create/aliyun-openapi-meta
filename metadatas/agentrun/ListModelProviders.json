{
  "name": "ListModelProviders",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/2025-09-10/agents/model-providers",
  "parameters": [
    {
      "name": "modelName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模型名称",
        "en": "The name of the model to filter by."
      }
    },
    {
      "name": "modelType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模型类型\n\n- system 系统内置模型\n- deployment 自定义部署模型",
        "en": "The model type to filter by. Valid values:\n\n- `system`: A system model.\n\n- `deployment`: A custom deployment model."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "页码",
        "en": "The page number to retrieve."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "页面大小",
        "en": "The number of results to return per page."
      }
    },
    {
      "name": "provider",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "云厂商，目前只支持Aliyun。",
        "en": "The cloud provider. To specify Alibaba Cloud, use the value 'Aliyun'."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出全部模型供应商",
    "en": "ListModelProviders"
  },
  "descriptions": {
    "zh": "获取当前用户的所有沙箱列表，支持按模板名称过滤，支持分页查询。",
    "en": "Lists the available model providers. This operation supports filtering and pagination."
  }
}