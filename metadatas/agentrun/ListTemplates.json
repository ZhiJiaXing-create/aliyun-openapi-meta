{
  "name": "ListTemplates",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/2025-09-10/templates",
  "parameters": [
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码",
        "en": "The number of the page to return."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页面大小",
        "en": "The number of entries to return on each page."
      }
    },
    {
      "name": "status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
