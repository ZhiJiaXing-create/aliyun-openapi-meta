        "en": "The status of the template. Use this parameter to filter templates."
      }
    },
    {
      "name": "templateName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模板名称",
        "en": "The name of the template. Use this parameter to filter templates."
      }
    },
    {
      "name": "templateType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模板类型",
        "en": "The type of the template. Use this parameter to filter templates."
      }
    },
    {
      "name": "workspaceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作空间 Id",
