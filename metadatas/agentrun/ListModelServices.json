{
  "name": "ListModelServices",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/2025-09-10/agents/model-services",
  "parameters": [
    {
      "name": "modelType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "模型类型\n\n- system 系统内置模型\n- deployment 自定义部署模型",
        "en": "The model type. Valid values:\n\n- `system`: A built-in model.\n\n- `deployment`: A model from a custom deployment."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码",
        "en": "The page number."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页面大小",
        "en": "The page size."
      }
    },
    {
      "name": "provider",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "云厂商，目前只支持Aliyun。",
        "en": "The cloud provider. Currently, only Alibaba Cloud is supported."
      }
    },
    {
      "name": "providerType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "供应商类型",
        "en": "The provider type."
      }
    },
    {
      "name": "workspaceId",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "workspaceIds",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出全部模型",
    "en": "ListModelServices"
  },
  "descriptions": {
    "zh": "获取当前用户的所有模板列表，支持按模板类型过滤，支持分页查询。",
    "en": "Retrieves a list of all models for the current user. You can filter the models by type and paginate the results."
  }
}