{
  "name": "ListSandboxes",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/2025-09-10/sandboxes",
  "parameters": [
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码",
        "en": "The maximum number of results to return."
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "分页游标。 说明 该字段不为空，表示有更多数据。",
        "en": "The pagination token for the next set of results. A non-empty value indicates that more data is available."
      }
    },
    {
      "name": "sandboxId",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "状态",
        "en": "Filters the results by status."
      }
    },
    {
      "name": "templateName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模板名称",
        "en": "Filters the results by template name."
      }
    },
    {
      "name": "templateType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模板类型",
        "en": "Filters the results by template type."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出 Sandbox",
    "en": "ListSandboxes"
  },
  "descriptions": {
    "zh": "获取当前用户的所有沙箱列表，支持按模板名称过滤，支持分页查询。",
    "en": "Retrieves a list of sandboxes for the current user. You can filter the results by template name, template type, or status. This operation supports pagination."
  }
}