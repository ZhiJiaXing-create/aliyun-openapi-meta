{
  "name": "ListCredentials",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/2025-09-10/agents/credentials",
  "parameters": [
    {
      "name": "credentialAuthType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "凭证类型",
        "en": "Filters the results by credential type."
      }
    },
    {
      "name": "credentialName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "凭证名称",
        "en": "Filters the results by credential name."
      }
    },
    {
      "name": "credentialSourceType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "凭证来源类型",
        "en": "Filters the results by credential source type."
      }
    },
    {
      "name": "enabled",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否启用",
        "en": "Filters the results based on the credential's enabled status."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码",
        "en": "The page number of the results to return."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页面大小",
        "en": "The number of credentials to return per page."
      }
    },
    {
      "name": "provider",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "第三方凭证提供商",
        "en": "Filters the results by provider."
      }
    },
    {
      "name": "workspaceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作空间唯一标识",
        "en": "Unique identifier of the workspace"
      }
    },
    {
      "name": "workspaceIds",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多个工作空间标识",
        "en": "Multiple workspace identifiers"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列出全部凭证",
    "en": "ListCredentials"
  },
  "descriptions": {
    "zh": "获取当前用户的所有沙箱列表，支持按模板名称过滤，支持分页查询。",
    "en": "Lists the credentials in your account. This operation supports filtering and pagination."
  }
}