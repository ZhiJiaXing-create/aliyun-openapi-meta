{
  "name": "CreateImageCache",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AcrRegistryInfos",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "ACR 企业版实例信息。",
        "en": "The Container Registry Enterprise instance information."
      },
      "sub_parameters": [
        {
          "name": "InstanceId",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "ACR 企业版实例 ID。",
            "en": "The Container Registry Enterprise instance ID."
          }
        },
        {
          "name": "RegionId",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "ACR 企业版实例所属地域。",
            "en": "The region where the Container Registry Enterprise instance resides."
          }
        }
      ]
    },
    {
      "name": "ClientToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "幂等Token。",
        "en": "The idempotency token."
      }
    },
    {
      "name": "ImageCacheName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "镜像缓存名称。",
        "en": "The name of the image cache."
      }
    },
    {
      "name": "ImageRegistryCredentials",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "镜像仓库秘钥信息。",
        "en": "The image registry credential information."
      },
      "sub_parameters": [
        {
          "name": "Password",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "镜像仓库密码。",
            "en": "The password of the image registry."
          }
        },
        {
          "name": "Server",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "不带 http:// 或 https:// 前缀的镜像仓库地址。",
            "en": "The image registry address without the http:// or https:// prefix."
          }
        },
        {
          "name": "SkipCertVerification",
          "position": "Query",
          "type": "Boolean",
          "required": false,
          "description": {
            "zh": "使用自签发证书的自建镜像仓库中的镜像创建镜像缓存时，需配置该参数来跳过证书认证，避免因证书认证失败而导致镜像拉取失败。\n默认值：`false`。",
            "en": "Specifies whether to skip certificate verification when creating an image cache from a self-managed image registry that uses a self-signed certificate. This prevents image pull failures caused by certificate verification failures.\nDefault value: `false`."
          }
        },
        {
          "name": "UsePlainHttp",
          "position": "Query",
          "type": "Boolean",
          "required": false,
          "description": {
            "zh": "服务使用 HTTP 协议拉取镜像，避免因协议不同而导致镜像拉取失败。\n默认值：`false`。",
            "en": "Specifies whether to use HTTP to pull images, which prevents image pull failures caused by protocol mismatch.\nDefault value: `false`."
          }
        },
        {
          "name": "Username",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "镜像仓库用户名。",
            "en": "The username of the image registry."
          }
        }
      ]
    },
    {
      "name": "Images",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "description": {
        "zh": "用于制作镜像缓存的容器镜像，目前仅支持一个。",
        "en": "The container images used to create the image cache. Currently, only one image is supported."
      }
    },
    {
      "name": "NetworkConfig",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "创建镜像缓存拉取镜像的网络配置。",
        "en": "The network configuration for pulling images when creating the image cache."
      }
    },
    {
      "name": "Platform",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "地域ID。",
        "en": "The region ID."
      }
    },
    {
      "name": "ResourceGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源组ID。",
        "en": "The resource group ID."
      }
    },
    {
      "name": "Tags",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "镜像缓存标签信息，最多 20 个。",
        "en": "The tag information of the image cache. A maximum of 20 tags are supported."
      },
      "sub_parameters": [
        {
          "name": "Key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "镜像缓存标签键。",
            "en": "The tag key of the image cache."
          }
        },
        {
          "name": "Value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "镜像缓存标签值。",
            "en": "The tag value of the image cache."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "创建镜像缓存",
    "en": "Create an image cache"
  }
}