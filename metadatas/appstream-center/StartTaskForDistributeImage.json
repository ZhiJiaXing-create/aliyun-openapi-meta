{
  "name": "StartTaskForDistributeImage",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DestinationRegionList",
      "position": "Body",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "需要复制的目标地域列表。",
        "en": "The list of destination regions to which the image is copied."
      }
    },
    {
      "name": "ImageId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "镜像id",
        "en": "The image ID."
      }
    },
    {
      "name": "ProductType",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "产品类型。",
        "en": "The product type."
      }
    },
    {
      "name": "RetryType",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "该参数暂不对外透出。",
        "en": "This parameter is not publicly available."
      }
    },
    {
      "name": "SourceRegion",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "指定复制镜像的源地域，不设置则随机选择。",
        "en": "The source region from which the image is copied. If this parameter is not specified, a random region is selected."
      }
    },
    {
      "name": "VersionId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "镜像版本ID，不填默认使用最新的镜像版本。",
        "en": "The image version ID. If this parameter is not specified, the latest image version is used."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "发起镜像地域复制任务",
    "en": "Initiate image cross-region copy task"
  }
}