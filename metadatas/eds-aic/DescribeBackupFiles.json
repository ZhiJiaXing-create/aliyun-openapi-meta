  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询备份文件列表",
    "en": "Query backup files"
  },
  "descriptions": {
    "zh": "目前仅支持云手机生成的备份文件保存在OSS对象存储服务。",
    "en": "Currently, only backup files generated by cloud phones can be stored in Object Storage Service (OSS)."
