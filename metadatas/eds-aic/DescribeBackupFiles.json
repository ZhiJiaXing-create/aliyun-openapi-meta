    {
      "name": "SaleMode",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StartTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "查询当前时间之后的备份文件。",
        "en": "Queries backup files created after the specified time."
