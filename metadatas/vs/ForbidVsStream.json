{
  "name": "ForbidVsStream",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称",
        "en": "The application name."
      }
    },
    {
      "name": "ControlStreamAction",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "DomainName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "您的加速域名",
        "en": "The accelerated domain name."
      }
    },
    {
      "name": "LiveStreamType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "目前仅支持”publisher”",
        "en": "Only \"publisher\" is supported."
      }
    },
    {
      "name": "Oneshot",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "是否只断流不加入黑名单，取值：yes，表示只断流不加黑名单",
        "en": "Specifies whether to only interrupt the stream without adding it to the blacklist. A value of \\`yes\\` indicates that the stream is only interrupted."
      }
    },
    {
      "name": "ResumeTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "恢复流的时间 UTC时间格式",
        "en": "The time to resume the stream. The time is in UTC format."
      }
    },
    {
      "name": "StreamName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "流名称",
        "en": "The stream name."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "禁止某条流的推送",
    "en": "Prohibit the push of a specific stream"
