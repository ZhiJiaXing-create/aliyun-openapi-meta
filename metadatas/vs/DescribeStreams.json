{
  "name": "DescribeStreams",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "App",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按应用查询。",
        "en": "Filter by application."
      }
    },
    {
      "name": "DeviceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按设备ID查询。",
        "en": "Filter by device ID."
      }
    },
    {
      "name": "Domain",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按域名查询。",
        "en": "Filter by domain name."
      }
    },
    {
      "name": "GroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按空间ID查询。",
        "en": "The ID of the space to query."
      }
    },
    {
      "name": "Id",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "流ID。\n> 支持多个，用英文逗号（,）分隔。",
        "en": "Stream ID.\n\n> Enter multiple IDs separated by commas (,)."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按名称查询。\n> 支持多个，用英文逗号（,）分隔。",
        "en": "Filter by stream name.\n\n> Enter multiple names separated by commas (,)."
      }
    },
    {
      "name": "PageNum",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "第几个分页，默认值：1。",
        "en": "Page number. Default value: 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页大小，默认值：20。",
        "en": "Number of items per page. Default value: 20."
      }
    },
    {
      "name": "ParentId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "流所在设备的父设备ID。",
        "en": "Parent device ID of the device that hosts this stream."
      }
    },
    {
      "name": "SortBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按给定字段排序，取值范围：\n- Id（默认）\n- GroupId\n- Name\n- DeviceId\n- Protocol\n> 不支持填入多个字段。",
        "en": "Sort results by a field. Valid values:\n\n- Id (default)\n\n- GroupId\n\n- Name\n\n- DeviceId\n\n- Protocol\n\n> You can specify only one field."
      }
    },
    {
      "name": "SortDirection",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方式。取值范围：\n- asc（升序）（默认）\n- desc（降序）",
        "en": "Sort order. Valid values:\n\n- asc (ascending, default)\n\n- desc (descending)"
      }
    }
