{
  "name": "DescribeGroups",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Id",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "空间ID。",
        "en": "The space ID."
      }
    },
    {
      "name": "InProtocol",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "空间使用的接入协议。取值范围：\n- gb28181\n- rtmp",
        "en": "Ingest protocol used by the group. Valid values:\n\n- gb28181\n\n- rtmp"
      }
    },
    {
      "name": "IncludeStats",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否返回空间设备统计信息。默认值：false。",
        "en": "Whether to return device statistics for the group. Default: false."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "空间名称。",
        "en": "Space name."
      }
    },
    {
      "name": "PageNum",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "第几页。默认：1。",
        "en": "Page number. Default: 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页大小。",
        "en": "Number of entries per page."
      }
    },
    {
      "name": "Region",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "空间所属区域，即服务中心。",
        "en": "The service region where the group is located."
      }
    },
    {
      "name": "SortBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按字段排序。取值范围：\n- Id（默认）",
        "en": "Field to sort by. Valid values:\n\n- Id (default)"
      }
    },
    {
      "name": "SortDirection",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方式。取值范围：\n- asc（升序）（默认值）\n- desc（降序）",
        "en": "Sort order. Valid values:\n\n- asc (ascending, default)\n\n- desc (descending)"
      }
    },
    {
      "name": "Status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "空间状态。取值范围：\n- on（已启用）\n- off（已停用）",
        "en": "Group status. Valid values:\n\n- on (enabled)\n\n- off (disabled)"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询空间列表",
    "en": "Query space list"
  }
}