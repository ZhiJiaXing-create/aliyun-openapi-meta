{
  "name": "DescribeDevices",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DirectoryId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按设备所属目录ID查询。",
        "en": "The ID of the directory to which the device belongs."
      }
    },
    {
      "name": "Dsn",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备序列号，唯一标识。",
        "en": "The serial number of the device. The value must be unique."
      }
    },
    {
      "name": "GbId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按设备国标ID查询。",
        "en": "You can query by device national standard ID."
      }
    },
    {
      "name": "GroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按设备所属空间ID查询。",
        "en": "Query by device Space ID."
      }
    },
    {
      "name": "Id",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备ID。\n> 支持多个，用英文逗号（,）分隔。",
        "en": "The device ID.\n\n> Specify multiple IDs. Separate them with commas (,)."
      }
    },
    {
      "name": "IncludeDirectory",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否返回目录信息，默认值：false。",
        "en": "Specifies whether to return directory information. Default value: false."
      }
    },
    {
      "name": "IncludeStats",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否返回流统计信息，默认值：false。",
        "en": "Specifies whether to return stream statistics. Default value: false."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备名称。\n> 支持多个，用英文逗号（,）分隔。",
        "en": "The device name.\n\n> Specify multiple names. Separate them with commas (,)."
      }
    },
    {
      "name": "PageNum",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "第几个分页，默认值：1。",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页大小，默认值：20。",
        "en": "The number of entries per page. Default value: 20."
      }
    },
    {
      "name": "ParentId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按设备所属上级设备ID查询。",
        "en": "The ID of the parent device."
      }
    },
    {
      "name": "SortBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按给定字段排序。取值：\n> id（默认）",
        "en": "The field by which to sort the results. Valid value:\n\n> id (default)"
      }
    },
    {
      "name": "SortDirection",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方式。取值范围：\n- asc（升序）（默认）\n- desc（降序）",
        "en": "The sort order. Valid values:\n\n- asc (ascending) (default)\n\n- desc (descending)"
      }
    },
    {
      "name": "Status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按设备状态查询。",
        "en": "Query devices by status."
      }
    },
    {
      "name": "Type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按设备类型查询。取值范围：\n- ipc（摄像头）\n- platform（平台）\n- ied（智能设备）",
        "en": "The device type. Valid values:\n\n- ipc (camera)\n\n- platform\n\n- ied (intelligent edge device)"
      }
    },
    {
      "name": "Vendor",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按设备厂商查询。",
        "en": "Query by device manufacturer."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询设备列表",
    "en": "Query device list"
  }
}