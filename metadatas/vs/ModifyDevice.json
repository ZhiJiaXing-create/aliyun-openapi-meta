{
  "name": "ModifyDevice",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AlarmMethod",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "订阅的国标报警方式。取值范围：\n- 0（全部）\n- 5（视频报警）\n- 7（其他报警）\n> - 空值表示不订阅。\n> - 支持多个，用英文逗号（,）分隔。",
        "en": "GB-compliant alarm method to subscribe to. Valid values:\n\n- 0 (all)\n\n- 5 (video alarm)\n\n- 7 (other alarms)\n\n> * An empty value means no subscription.\n>\n> * Multiple values are supported. Separate them with commas."
      }
    },
    {
      "name": "AutoPos",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否启用设备位置订阅，默认值：false。",
        "en": "Whether to enable location subscription for the device. Default value: false."
      }
    },
    {
      "name": "AutoStart",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否自动启动流，默认值：false。",
        "en": "Whether to automatically start the stream. Default value: false."
      }
    },
    {
      "name": "Description",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备描述。",
        "en": "Device description."
      }
    },
    {
      "name": "DirectoryId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备所属目录ID。",
        "en": "Directory ID for the device."
      }
    },
    {
      "name": "GbId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备国标ID。\n> 仅适用于国标协议。",
        "en": "GB-compliant device ID.\n\n> This parameter applies only to GB-compliant protocols."
      }
    },
    {
      "name": "GroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "空间ID。",
        "en": "Space ID."
      }
    },
    {
      "name": "Id",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "设备ID。",
        "en": "Device ID."
      }
    },
    {
      "name": "Ip",
      "position": "Query",
      "type": "String",
      "required": false,
