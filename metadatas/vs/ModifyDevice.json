    {
      "name": "Username",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备用户名。",
        "en": "Username for the device."
      }
    },
    {
      "name": "Vendor",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备厂商。",
        "en": "Device vendor."
      }
