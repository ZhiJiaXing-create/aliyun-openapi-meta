    {
      "name": "Longitude",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备经度。",
        "en": "Longitude of the device."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备名称。",
        "en": "Device name."
      }
    },
    {
      "name": "Params",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备其他参数，格式为JSON序列化的字符串。",
        "en": "Additional device parameters, formatted as a JSON-serialized string."
