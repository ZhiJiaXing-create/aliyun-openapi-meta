{
  "name": "DescribeDirectories",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "GroupId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "目录所属空间ID。",
        "en": "ID of the group to which the directory belongs."
      }
    },
    {
      "name": "NoPagination",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否禁用分页，默认false",
        "en": "Disable paging. Default is false."
      }
    },
    {
      "name": "PageNum",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "第几个分页，默认为1",
        "en": "Page number. Default is 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页大小，默认为20",
        "en": "Page size. Default is 20."
      }
    },
    {
      "name": "ParentId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按上级目录ID查询。",
        "en": "Query by parent directory ID."
      }
    },
    {
      "name": "SortBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按给定字段排序，默认按ID排序。",
        "en": "Sort by the specified field. Default is by ID."
      }
    },
    {
      "name": "SortDirection",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方式，默认升序。取值：\n- asc（升序）\n- desc（降序）",
        "en": "Sort order. Default is ascending. Values:\n\n- asc (ascending)\n\n- desc (descending)"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询目录列表",
    "en": "Query the folder list"
  }
}