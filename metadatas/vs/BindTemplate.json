{
  "name": "BindTemplate",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ApplyAll",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否强制应用到范围内的所有流，默认false。",
        "en": "Whether to apply the template to all streams in the scope. Default value: false."
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The ID of the instance."
      }
    },
    {
      "name": "InstanceType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例类型。取值：\n- group（空间）\n- stream（流）",
        "en": "The type of the instance. Valid values:\n\n- group\n\n- stream"
      }
    },
    {
      "name": "Replace",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否强制替换已有绑定，默认false。",
        "en": "Whether to replace an existing binding. Default value: false."
      }
    },
    {
      "name": "TemplateId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "模板ID。",
        "en": "The ID of the template."
      }
    },
    {
      "name": "TemplateType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模板类型。取值：\n- record（录制）\n- snapshot（截图）",
        "en": "The type of the template. Valid values:\n\n- record\n\n- snapshot"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "绑定模板到指定实例",
    "en": "Attach template to specified instance"
  }
}