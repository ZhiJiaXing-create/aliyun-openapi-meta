{
  "name": "ModifyDBInstanceSSL",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ConnectionString",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "加密的连接串，对于ECS实例，该参数默认采用泛域名，会加密所有的连接串。",
        "en": "The encrypted endpoint. By default, the wildcards are used for instances that are hosted on ECS instances. This way, the endpoints that can be resolved to the same IP address are encrypted."
      }
    },
    {
      "name": "DBInstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。\n\n> 您可以调用[DescribeDBInstances](~~86911~~)接口查看目标地域下所有的AnalyticDB PostgreSQL实例的详情，包括实例ID。",
        "en": "The ID of the instance."
      }
    },
    {
      "name": "SSLEnabled",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "SSL状态：\n\n- 0：关闭 \n- 1：开启\n- 2：更新",
        "en": "The status of SSL encryption. Valid values:\n\n*   0: disables SSL encryption.\n*   1: enables SSL encryption.\n*   2: updates SSL encryption."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "修改SSL加密状态",
    "en": "ModifyDBInstanceSSL"
  },
  "example": {
    "unifiedCli": "aliyun gpdb modify-db-instance-ssl --db-instance-id gp-xxxxxxxxxxx --connection-string gp-xxxxxxxxxxx-master.gpdbmaster.singapore.rds.aliyuncs.com --ssl-enabled 1 --region cn-hangzhou",
    "legacyCli": "aliyun gpdb ModifyDBInstanceSSL --region cn-hangzhou --SSLEnabled 1 --DBInstanceId 'gp-xxxxxxxxxxx' --ConnectionString 'gp-xxxxxxxxxxx-master.gpdbmaster.singapore.rds.aliyuncs.com'"
  }
}