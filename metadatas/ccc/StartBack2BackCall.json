{
  "name": "StartBack2BackCall",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "CallCenterNumber",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "背靠背代理所用电话号码。\n\n该电话号码需要归属于**instanceId**指定的呼叫中心实例，若不指定，则会随机选一个指定实例下可用于外呼的号码。"
      }
    },
    {
      "name": "Callee",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "被叫号码。"
      }
    },
    {
      "name": "Caller",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "主叫号码。"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "呼叫中心实例ID。\n\n背靠背代理所用电话号码需要归属于该呼叫中心实例。"
      }
    },
    {
      "name": "WorkflowId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "联系流ID。\n\n此联系流用来辅助建立双方通话，该字段是扩展用，请留空。"
      }
    }
  ],
  "security": [
    "AK",
    "BearerToken"
  ],
  "title": {
    "zh": "发起双呼"
  },
  "descriptions": {
    "zh": "双呼和传统的双方通话不同，主叫并不直接呼叫对方，而是通过一个背靠背代理(Back to Back Agent)， 背靠背代理首先呼叫主叫方，接通后，再呼叫被叫方，然后把二者拉进一个会场。在这种方式下，由于每个呼叫的所有消息流经背靠背代理，因此服务提供商可以据此提供增值服务，比如计时、录音、隐藏真实号码等等。"
  }
}