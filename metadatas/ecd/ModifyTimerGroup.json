{
  "name": "ModifyTimerGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ConfigTimers",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "定时任务的配置信息。",
        "en": "The scheduled task configurations."
      },
      "sub_parameters": [
        {
          "name": "AllowClientSetting",
          "position": "Query",
          "type": "Boolean",
          "required": false,
          "description": {
            "zh": "是否允许终端用户自行配置定时任务。",
            "en": "Specifies whether to allow end users to configure scheduled tasks."
          }
        },
        {
          "name": "CronExpression",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "定时任务Cron表达式。\n\n> 需要传入UTC标准时间，即北京时间每天0点应该传入0 0 16 ? * 1,2,3,4,5,6,7。",
            "en": "The Cron expression for the scheduled task.\n\n> The Cron expression must be in UTC. For example, to schedule a task for 00:00 daily in China Standard Time (UTC+8), set this parameter to `0 0 16 ? * 1,2,3,4,5,6,7`."
          }
        },
        {
          "name": "Enforce",
          "position": "Query",
          "type": "Boolean",
          "required": false,
          "description": {
            "zh": "是否强制执行。为true表示忽略桌面及连接状态检测，强制执行定时任务。",
            "en": "Specifies whether to force execution. If this parameter is set to `true`, the scheduled task runs regardless of the desktop and connection status."
          }
        },
        {
          "name": "Interval",
          "position": "Query",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "时间间隔，单位为分钟。",
            "en": "The interval, in minutes."
          }
        },
        {
          "name": "NotificationTime",
          "position": "Query",
          "type": "Integer",
          "required": false
        },
        {
          "name": "OperationType",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "定时任务操作类型，目前仅断连定时任务支持。",
            "en": "The operation to perform. This parameter applies only if `TimerType` is set to `NoConnect`."
          }
        },
        {
          "name": "ProcessWhitelist",
          "position": "Query",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "无操作定时任务智能判断的进程白名单，如果指定的进程正在运行则不支持无操作定时任务。",
            "en": "The process whitelist for advanced inactivity detection. The scheduled task is not triggered if a process from this list is running."
          }
        },
        {
          "name": "ResetType",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "重置类型，决定是否重置，以及要重置的磁盘范围。",
            "en": "Specifies which disks to reset."
          }
        },
        {
          "name": "SegmentTimers",
          "position": "Query",
          "type": "RepeatList",
          "required": false
        },
        {
          "name": "TimerType",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "定时任务类型。",
            "en": "The type of the scheduled task."
          }
        },
        {
          "name": "TriggerType",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "无操作定时任务触发配置类型。",
            "en": "The method for detecting inactivity."
          }
        }
      ]
    },
    {
      "name": "Description",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "配置组描述信息。",
        "en": "The description of the configuration group."
      }
    },
    {
      "name": "GroupId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "配置组ID。",
        "en": "The configuration group ID."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "配置组名称。",
        "en": "The name of the configuration group."
      }
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "地域ID。该功能无地域属性，该字段固定填写`cn-shanghai`。",
        "en": "The region ID. This feature is not tied to a specific region, but you must set this parameter to `cn-shanghai`."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "修改配置组设置",
    "en": "Modify Configuration Group Settings"
  }
}