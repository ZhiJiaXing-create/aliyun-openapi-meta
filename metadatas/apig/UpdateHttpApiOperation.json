{
  "name": "UpdateHttpApiOperation",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/v1/http-apis/[httpApiId]/operations/[operationId]",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求体参数。",
        "en": "The request body parameters."
      }
    },
    {
      "name": "httpApiId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待更新接口所属的HTTP API ID。",
        "en": "The ID of the HTTP API to which the operation to be updated belongs."
      }
    },
    {
      "name": "operationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待更新的接口ID。",
        "en": "The ID of the operation to update."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新接口",
    "en": "Update an API operation"
  },
  "example": {
    "unifiedCli": "aliyun apig update-http-api-operation --http-api-id api-xxx --operation-id op-xxx --operation example-string --region cn-hangzhou",
    "legacyCli": "aliyun apig POST /v1/http-apis/api-xxx/operations/op-xxx --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"operation\":\"example-string\"}"
  }
}