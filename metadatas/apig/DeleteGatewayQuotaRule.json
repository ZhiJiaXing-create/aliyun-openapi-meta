{
  "name": "DeleteGatewayQuotaRule",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "DELETE",
  "pathPattern": "/v1/gateways/[gatewayId]/quota-rules/[ruleId]",
  "parameters": [
    {
      "name": "gatewayId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关ID",
        "en": "The gateway ID."
      }
    },
    {
      "name": "ruleId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "规则ID",
        "en": "The rule ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "删除消费者配额规则",
    "en": "Delete a consumer quota rule"
  },
  "descriptions": {
    "zh": "该接口用于对 AI 网关删除某条基于消费者的配额规则。注意，只针对于版本大于 2.1.19 的 AI 网关生效。",
    "en": "Deletes a consumer-based quota rule from an AI gateway. This operation takes effect only for AI gateways of version 2.1.19 or later."
  },
  "example": {
    "unifiedCli": "aliyun apig delete-gateway-quota-rule --gateway-id gw-123456 --rule-id qr-d8j7fpmm1hks65kxxxxx --region cn-hangzhou",
    "legacyCli": "aliyun apig DELETE /v1/gateways/gw-123456/quota-rules/qr-d8j7fpmm1hks65kxxxxx --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}