    "legacyCli": "aliyun apig GET /v1/consumers/cs-d8kkaium1hks607xxxxx/quota-rules --region cn-hangzhou --pageNumber 1 --pageSize 10 --keyword daily --gatewayId 'gw-123456' --header \"Content-Type=application/json\""
