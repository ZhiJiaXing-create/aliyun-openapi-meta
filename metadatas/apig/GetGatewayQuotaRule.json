{
  "name": "GetGatewayQuotaRule",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/gateways/[gatewayId]/quota-rules/[ruleId]",
  "parameters": [
    {
      "name": "consumerPageNumber",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "消费者页数",
        "en": "The page number of the consumer list."
      }
    },
    {
      "name": "consumerPageSize",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "消费者页大小",
        "en": "The number of consumers per page."
      }
    },
    {
      "name": "gatewayId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关ID",
        "en": "The gateway ID."
      }
    },
    {
      "name": "ruleId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "策略ID",
        "en": "The policy ID."
      }
    },
    {
      "name": "withConsumers",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否输出消费者列表",
        "en": "Specifies whether to include the consumer list in the response."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询消费者配额规则详情",
    "en": "Query consumer quota rule details"
  },
  "descriptions": {
    "zh": "该接口用于查询 AI 网关上某条消费者配额规则。",
    "en": "Queries the details of a consumer quota rule on an AI gateway."
  },
  "example": {
    "unifiedCli": "aliyun apig get-gateway-quota-rule --gateway-id gw-123456 --rule-id qr-d8j7fpmm1hks65xxxxx --with-consumers true --consumer-page-number 1 --consumer-page-size 10 --region cn-hangzhou",
    "legacyCli": "aliyun apig GET /v1/gateways/gw-123456/quota-rules/qr-d8j7fpmm1hks65xxxxx --region cn-hangzhou --withConsumers true --consumerPageSize 10 --consumerPageNumber 1 --header \"Content-Type=application/json\""
  }
}