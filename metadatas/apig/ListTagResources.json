{
  "name": "ListTagResources",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/tags",
  "parameters": [
    {
      "name": "NextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "下一个查询开始Token",
        "en": "The token for the next query."
      }
    },
    {
      "name": "ResourceId",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "资源ID,最多 50个子项",
        "en": "The resource ID. You can specify up to 50 subkeys."
      }
    },
    {
      "name": "ResourceType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源类型",
        "en": "The resource type."
      }
    },
    {
      "name": "Tag",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "对应新增标签列表，最多包含20个子项",
        "en": "The list of labels to add. You can specify up to 20 subkeys."
      },
      "sub_parameters": [
        {
          "name": "Key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键",
            "en": "The label key."
          }
        },
        {
          "name": "Value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值",
            "en": "The label value."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取资源标签列表",
    "en": "Retrieve resource label list"
  },
  "example": {
    "unifiedCli": "aliyun apig list-tag-resources --resource-type Gateway --resource-id gw-xxx --tag Value=prod Key=env --next-token caeb235b-xxx --region cn-hangzhou",
    "legacyCli": "aliyun apig GET /v1/tags --region cn-hangzhou --NextToken 'caeb235b-xxx' --ResourceId '[\"gw-xxx\"]' --ResourceType Gateway --Tag '[{\"Value\":\"prod\",\"Key\":\"env\"}]' --header \"Content-Type=application/json\""
  }
}