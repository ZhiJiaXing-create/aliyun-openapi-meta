      "description": {
        "zh": "备份周期。可取值：Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday",
        "en": "The backup cycle. Valid values: Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday."
      }
    },
    {
      "name": "BackupTime",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "每天开始备份的时间，UTC 通用标准时，以Z来标识。",
        "en": "The time when the backup starts each day. The time is in UTC and is indicated by the Z suffix."
