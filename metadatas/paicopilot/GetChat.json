{
  "name": "GetChat",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/sessions/[SessionId]/chats/[ChatId]",
  "parameters": [
    {
      "name": "ChatId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "对话的ID。",
        "en": "The ID of the conversation."
      }
    },
    {
      "name": "SessionId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Session的ID。",
        "en": "The ID of the session."
      }
    },
    {
      "name": "Verbose",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "是否显示某些字段，目前支持\n- QuestionAndAnswer（默认不显示，代表问题与回复）",
        "en": "Specifies whether to display certain fields. Currently supported values:\n- QuestionAndAnswer (not displayed by default, represents questions and answers)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取对话详情",
    "en": "Retrieve conversation details"
  }
}