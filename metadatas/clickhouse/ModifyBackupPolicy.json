      "description": {
        "zh": "备份周期。",
        "en": "The backup cycle."
      }
    },
    {
      "name": "PreferredBackupTime",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "备份时间。",
        "en": "The backup time."
      }
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "地域ID。",
        "en": "The region ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "修改备份策略",
    "en": "ModifyBackupPolicy"
