    "legacyCli": "aliyun clickhouse ModifyBackupPolicy --region cn-hangzhou --PreferredBackupPeriod Monday --DBInstanceId 'cc-xxxxx' --PreferredBackupTime '15:00Z-16:00Z' --RegionId 'cn-hangzhou' --BackupRetentionPeriod 7"
