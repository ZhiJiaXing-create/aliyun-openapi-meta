    "legacyCli": "aliyun onsmqtt SetSniConfig --region cn-hangzhou --DefaultCertificate '1533xxxx-cn-hangzhou' --SniConfig '0.mqtt.aliyuncs.com#15xxxxx-cn-hangzhou_mqtt-test.mqtt.aliyuncs.com#15xxxx9-cn-hangzhou' --MqttInstanceId 'mqtt-cn-5yd3xxx'"
