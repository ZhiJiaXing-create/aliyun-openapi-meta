      "name": "FaceGroupCode",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "人脸库编码。",
        "en": "The face library code."
      }
    },
    {
      "name": "FacePicture",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "注册人脸图片base64",
        "en": "The Base64-encoded face image to register."
      }
    },
    {
      "name": "FacePictureFile",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "注册人脸图片文件流",
        "en": "The file stream of the face image to register."
      }
    },
    {
      "name": "FacePictureUrl",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "注册人脸图片URL",
        "en": "The URL of the face image to register."
      }
    },
    {
      "name": "FaceQualityCheck",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "是否检测人脸图片质量\n- Y：开启\n- N：关闭（默认）",
