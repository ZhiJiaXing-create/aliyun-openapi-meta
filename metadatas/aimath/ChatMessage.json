{
  "name": "ChatMessage",
  "deprecated": false,
  "protocol": "HTTPS|SSE",
  "method": "POST",
  "pathPattern": "/conversation/message",
  "parameters": [
    {
      "name": "Content",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "对话内容",
        "en": "The conversation content."
      }
    },
    {
      "name": "ConversationId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "会话ID",
        "en": "The conversation ID."
      }
    },
    {
      "name": "UserId",
      "position": "Body",
      "type": "String",
      "required": true,
      "description": {
        "zh": "用户id，获取其他用于隔离的对话归属的id，调用方定义，与创建对话的userId保持一致",
        "en": "The user ID, which is used for conversation isolation. This value is defined by the caller and must be the same as the userId used when the conversation was created."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "对话消息",
    "en": "Conversation message"
  }
}