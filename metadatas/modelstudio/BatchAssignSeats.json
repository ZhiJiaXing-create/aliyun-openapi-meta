{
  "name": "BatchAssignSeats",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/tokenplan/subscription/seat-assignments",
  "parameters": [
    {
      "name": "AccountIds",
      "position": "Query",
      "type": "Array",
      "required": false,
      "description": {
        "zh": "目标成员 id 列表",
        "en": "The list of target member IDs."
      }
    },
    {
      "name": "Locale",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "多语言信息 zh-CN/en-US",
        "en": "The language. Valid values: zh-CN and en-US."
      }
    },
    {
      "name": "SeatType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "席位类型\n- standard - 标准席位\n- pro - 高级席位\n- max - 尊享席位",
        "en": "The seat type. Valid values:\n- standard: standard seat\n- pro: pro seat\n- max: premium seat"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "分配席位",
    "en": "Assign seats"
