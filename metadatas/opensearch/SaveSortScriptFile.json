{
  "name": "SaveSortScriptFile",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/v4/openapi/app-groups/[appGroupIdentity]/apps/[appVersionId]/sort-scripts/[scriptName]/files/src/[fileName]",
  "parameters": [
    {
      "name": "appGroupIdentity",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用的名称或者是应用id",
        "en": "The name or ID of the application."
      }
    },
    {
      "name": "appVersionId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用下的版本id",
        "en": "The version number of the application."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "scriptContent",
        "en": "The information about the script content."
      }
    },
    {
      "name": "fileName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "文件名。",
        "en": "The file name."
      }
    },
    {
      "name": "scriptName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "需要更新内容的脚本名称",
        "en": "The name of the script whose content you want to update."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "保存排序脚本文件",
    "en": "SaveSortScriptFile"
  }
}