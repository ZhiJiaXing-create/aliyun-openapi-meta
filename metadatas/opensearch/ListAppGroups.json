{
  "name": "ListAppGroups",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v4/openapi/app-groups",
  "parameters": [
    {
      "name": "instanceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例ID（精确匹配）",
        "en": "The ID of the instance. An exact match is performed."
      }
    },
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用名称",
        "en": "The application name."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认 pageNumber=1",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页返回数目，默认 pageSize=10",
        "en": "The number of entries to return on each page. Default value: 10."
      }
    },
    {
      "name": "resourceGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源id",
        "en": "The ID of the resource group."
      }
    },
    {
      "name": "sortBy",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "排列顺序\n\n- 0：按创建时间降序排列\n- 1：按修改时间降序排列\n\n默认 sortBy=0",
        "en": "The sort order. Valid values:\n\n- 0: Sorts applications by creation time in descending order.\n\n- 1: Sorts applications by modification time in descending order.\n\nDefault value: 0."
      }
    },
    {
      "name": "tags",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "标签列表",
        "en": "A list of tags."
      },
      "sub_parameters": [
        {
          "name": "key",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签键",
            "en": "The tag key."
          }
        },
        {
          "name": "value",
          "position": "Query",
          "type": "String",
          "required": false,
          "description": {
            "zh": "标签值",
            "en": "The tag value."
          }
        }
      ]
    },
    {
      "name": "type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用类型\n\n- standard 标准版\n- enhanced 新高级版",
        "en": "The type of the application. Valid values:\n\n- standard: a Standard Edition application.\n\n- enhanced: a Premium Edition application."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取应用列表",
    "en": "ListAppGroups"
  },
  "descriptions": {
    "zh": "- 支持按照 name、instanceId、type 进行过滤\n- 支持按照应用的创建时间排序\n- 支持分页参数",
    "en": "- Filters applications by name, instance ID, and type.\n\n- Sorts applications by their creation time.\n\n- Supports paging."
  }
}