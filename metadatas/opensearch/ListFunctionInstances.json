{
  "name": "ListFunctionInstances",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v4/openapi/app-groups/[appGroupIdentity]/functions/[functionName]/instances",
  "parameters": [
    {
      "name": "appGroupIdentity",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称",
        "en": "The name of the application."
      }
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "功能名称",
        "en": "The name of the feature."
      }
    },
    {
      "name": "functionType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "功能类型",
        "en": "The type of the feature."
      }
    },
    {
      "name": "modelType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模型类型",
        "en": "The type of the model."
      }
    },
    {
      "name": "output",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "返回信息的丰富度\n - normal：显示createParameters, cron等信息（默认）\n- simple：只显示基本信息\n- detail：返回训练任务详细信息",
        "en": "The level of detail for the returned information. Valid values:\n\n- normal: Displays information such as createParameters and cron. This is the default value.\n\n- simple: Displays only basic information.\n\n- detail: Returns the details of the training task."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认值为1",
        "en": "The page number. The default value is 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页大小，默认值为10",
        "en": "The number of entries per page. The default value is 10."
      }
    },
    {
      "name": "source",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例来源\n\n- builtin 系统实例\n- user 用户实例 （默认）\n- all 全部实例",
        "en": "The source of the instance. Valid values:\n\n- builtin: The instance is created by the system.\n\n- user: The instance is created by the user. This is the default value.\n\n- all: All instances."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取实例列表",
    "en": "ListFunctionInstances"
  }
}