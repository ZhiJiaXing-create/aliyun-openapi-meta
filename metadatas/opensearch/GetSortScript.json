{
  "name": "GetSortScript",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v4/openapi/app-groups/[appGroupIdentity]/apps/[appVersionId]/sort-scripts/[scriptName]",
  "parameters": [
    {
      "name": "appGroupIdentity",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用的名称、应用id",
        "en": "The name or ID of the application."
      }
    },
    {
      "name": "appVersionId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用下的版本id",
        "en": "The ID of the application version."
      }
    },
    {
      "name": "scriptName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "脚本名称",
        "en": "The name of the script."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取排序脚本详情",
    "en": "GetSortScript"
  }
}