{
  "name": "ListScheduledTasks",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v4/openapi/app-groups/[appGroupIdentity]/scheduled-tasks",
  "parameters": [
    {
      "name": "appGroupIdentity",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称",
        "en": "The application name."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认 pageNumber = 1",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页返回数目，默认 pageSize = 10",
        "en": "The number of entries per page. Default value: 10."
      }
    },
    {
      "name": "type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "定时任务类型\n\n- wipe 数据清理\n- fork 索引重建\n- check-status 检查应用状态\n- index 索引重建",
        "en": "The type of the scheduled task. Valid values:\n\n- wipe: data cleaning\n\n- fork: reindexing\n\n- check-status: application status check\n\n- index: reindexing"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取应用定时任务列表",
    "en": "ListScheduledTasks"
  }
}