{
  "name": "ListUserAnalyzerEntries",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v4/openapi/user-analyzers/[name]/entries",
  "parameters": [
    {
      "name": "name",
      "position": "Path",
      "type": "String",
