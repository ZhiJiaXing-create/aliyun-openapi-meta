      "description": {
        "zh": "分析器名称。",
        "en": "The name of the analyzer."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认 pageNumber=1。",
        "en": "The page number. The default value is 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页返回数目，默认 pageSize=10。",
        "en": "The number of entries to return on each page. The default value is 10."
