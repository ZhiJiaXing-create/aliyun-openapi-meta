      "required": true,
      "description": {
        "zh": "组ID",
        "en": "The ID of the group."
      }
    },
    {
      "name": "sceneId",
      "position": "Path",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "场景ID",
        "en": "The ID of the scene."
      }
    }
  ],
