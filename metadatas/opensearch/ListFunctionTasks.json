{
  "name": "ListFunctionTasks",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v4/openapi/app-groups/[appGroupIdentity]/functions/[functionName]/instances/[instanceName]/tasks",
  "parameters": [
    {
      "name": "appGroupIdentity",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称",
        "en": "The name of the application."
      }
    },
    {
      "name": "endTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "结束时间小于设定时间，单位毫秒",
        "en": "Returns tasks that ended before the specified time. The time is a UNIX timestamp in milliseconds."
      }
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "功能名称",
        "en": "The name of the feature."
      }
    },
    {
      "name": "instanceName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例名称",
        "en": "The name of the instance."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码（默认为1）",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页大小（默认为1）",
        "en": "The number of entries to return on each page. Default value: 1."
      }
    },
    {
      "name": "startTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "起始时间大于设定时间，单位毫秒",
        "en": "Returns tasks that started after the specified time. The time is a UNIX timestamp in milliseconds."
      }
    },
    {
      "name": "status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务状态：\n\n- success\n- failed\n- running",
        "en": "The status of the task. Valid values:\n\n- success\n\n- failed\n\n- running"
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取训练记录",
    "en": "ListFunctionTasks"
  }
}