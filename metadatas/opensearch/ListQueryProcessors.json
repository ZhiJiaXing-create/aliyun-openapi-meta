{
  "name": "ListQueryProcessors",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v4/openapi/app-groups/[appGroupIdentity]/apps/[appId]/query-processors",
  "parameters": [
    {
      "name": "appGroupIdentity",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称",
        "en": "The application name."
      }
    },
    {
      "name": "appId",
      "position": "Path",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "版本号",
        "en": "The application version number."
      }
    },
    {
      "name": "isActive",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "是否已设置为默认规则，默认值为0\n\n- 0 表示查询所有\n- 1 表示查询已设置为默认的规则\n- 2 表示查询未设置为默认的规则",
        "en": "Specifies whether to return default rules. The default value is 0. Valid values:\n\n- 0: Returns all query analysis rules.\n\n- 1: Returns only default query analysis rules.\n\n- 2: Returns only non-default query analysis rules."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "取某版本的查询分析规则列表",
    "en": "ListQueryProcessors"
  }
}