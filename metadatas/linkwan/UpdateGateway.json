{
  "name": "UpdateGateway",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Address",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关所在详细地址。",
        "en": "The detailed address where the gateway resides."
      }
    },
    {
      "name": "AddressCode",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "网关所在地区ID，由`http://lbs.amap.com/api/javascript-api/download`定义。",
        "en": "The ID of the region where the gateway resides, as defined by `http://lbs.amap.com/api/javascript-api/download`."
      }
    },
    {
      "name": "City",
      "position": "Query",
      "type": "String",
