    {
      "name": "Longitude",
      "position": "Query",
      "type": "Float",
      "required": false,
      "description": {
        "zh": "网关经度。",
        "en": "The longitude of the gateway."
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "自定义网关名称。",
        "en": "The custom name of the gateway."
      }
    }
  ],
  "security": [
    "AK"
  ],
