        "en": "The name of the city where the gateway resides."
      }
    },
    {
      "name": "CommunicationMode",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关通信模式。可取值为FULL_DUPLEX(全双工）、HALF_DUPLEX(半双工)。",
        "en": "The communication mode of the gateway. Valid values:\n- FULL_DUPLEX: full-duplex.\n- HALF_DUPLEX: half-duplex."
      }
    },
    {
      "name": "Description",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "自定义网关描述。",
        "en": "The custom description of the gateway."
      }
    },
    {
      "name": "District",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关所在城区名称。",
        "en": "The name of the district where the gateway resides."
      }
    },
    {
      "name": "FreqBandPlanGroupId",
      "position": "Query",
      "type": "Long",
