{
  "name": "ListApps",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/es-serverless/instances",
  "parameters": [
    {
      "name": "appName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用名称。",
        "en": "Application name."
      }
    },
    {
      "name": "createTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用创建时间。过滤出大于等于输入值的应用，时间格式为YYYY-MM-DDThh:mm:ssZ。",
        "en": "The application creation time. Filter applications created at or after the specified time. The time format is YYYY-MM-DDThh:mm:ssZ."
      }
    },
    {
      "name": "description",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用描述信息。",
        "en": "Application description."
      }
    },
    {
      "name": "orderType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按照应用创建时间的排序方式。默认desc。\n\n- **asc**：升序\n- **desc**：降序",
        "en": "The sorting method for application creation time. Default is desc.\n\n- **asc**: Ascending\n\n- **desc**: Descending"
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页查询时设置的页码。",
        "en": "The page number for paged query."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页大小。",
        "en": "The number of entries per page."
      }
    },
    {
      "name": "status",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用状态：\n\n- **ACTIVE**：正常\n- **INIT**：创建中\n- **INACTIVE**：冻结",
        "en": "Application status:\n\n- **ACTIVE**: Normal\n\n- **INIT**: Initializing\n\n- **INACTIVE**: Frozen"
      }
    },
    {
      "name": "tags",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "应用列表",
    "en": "Application List"
  }
}