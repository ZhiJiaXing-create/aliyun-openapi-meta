{
  "name": "CreateSnapshot",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/openapi/es-serverless/instances/[appName]/snapshot-repositories/[repository]/snapshots",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称。",
        "en": "The application name."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "body参数。",
        "en": "The body parameter."
      }
    },
    {
      "name": "dryRun",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否校验入参数据合法性，默认false。\n\n取值：\n\n- **true**：只校验参数合法性。\n\n- **false**：校验参数合法性，创建快照。",
        "en": "Validate input parameter data. The default is false.\n\nValues:\n\n- **true**: Only validate parameter data.\n\n- **false**: Validate parameter data and create a snapshot."
      }
    },
    {
      "name": "repository",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "快照仓库名称。目前默认aliyun_auto_snapshot。",
        "en": "The snapshot repository name. The default is aliyun\\_auto\\_snapshot."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "创建快照",
    "en": "Create Snapshot"
  }
}