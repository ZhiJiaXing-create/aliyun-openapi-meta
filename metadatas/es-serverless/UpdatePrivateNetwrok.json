{
  "name": "UpdatePrivateNetwrok",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/openapi/es-serverless/instances/[appName]/private-networks",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称。",
        "en": "The application name."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "body参数",
        "en": "The body parameter."
      },
      "sub_parameters": [
        {
          "name": "domain",
          "position": "Body",
          "type": "String",
          "required": false,
          "description": {
            "zh": "域名信息。（暂不支持修改）",
            "en": "The domain name information. (Modification is not supported currently)"
          }
        },
        {
          "name": "enabled",
          "position": "Body",
          "type": "Boolean",
          "required": false,
          "description": {
            "zh": "是否开启私网访问。",
            "en": "Enable internal-facing access."
          }
        },
        {
          "name": "port",
          "position": "Body",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "端口号。（暂不支持修改）",
            "en": "The port number. (Modification is not supported currently)"
          }
        },
        {
          "name": "pvlEndpointId",
          "position": "Body",
          "type": "String",
          "required": false,
          "description": {
            "zh": "终端节点ID。",
            "en": "The endpoint ID."
          }
        },
        {
          "name": "type",
          "position": "Body",
          "type": "String",
          "required": false,
          "description": {
            "zh": "IP白名单的类型：\n\nPRIVATE_ES：Elasticsearch私网访问白名单\nPRIVATE_KIBANA：Kibana私网访问白名单",
            "en": "PRIVATE\\_ES: Elasticsearch internal-facing whitelist\n\nPRIVATE\\_KIBANA: Kibana internal-facing whitelist"
          }
        },
        {
          "name": "vpcId",
          "position": "Body",
          "type": "String",
          "required": false,
          "description": {
            "zh": "专有网络实例ID",
            "en": "The virtual private cloud (VPC) instance ID."
          }
        },
        {
          "name": "whiteIpGroup",
          "position": "Body",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "白名单具体结构。",
            "en": "The whitelist structure."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新应用私网配置",
    "en": "Update application internal-facing configuration"
  },
  "descriptions": {
    "zh": "系统将自动创建服务关联角色，允许访问OSS等其他云产品服务。\nOSS地址要求：目录名称需包含es-serverless，或为OSS Bucket添加es-serverless:es-serverless标签。",
    "en": "The system automatically creates a service-linked role to grant access to OSS and other cloud services. To access OSS, the directory name must contain es-serverless, or the es-serverless:es-serverless tag must be added to the OSS Bucket."
  }
}