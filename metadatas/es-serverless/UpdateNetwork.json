{
  "name": "UpdateNetwork",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/openapi/es-serverless/instances/[appName]/networks",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例 ID。",
        "en": "Instance ID."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "body参数。",
        "en": "Request body."
      },
      "sub_parameters": [
        {
          "name": "domain",
          "position": "Body",
          "type": "String",
          "required": false,
          "description": {
            "zh": "域名信息。（暂不支持修改）",
            "en": "Domain name. You cannot modify this value."
          }
        },
        {
          "name": "enabled",
          "position": "Body",
          "type": "Boolean",
          "required": false,
          "description": {
            "zh": "是否开启公网访问。",
            "en": "Enable public network access."
          }
        },
        {
          "name": "port",
          "position": "Body",
          "type": "Integer",
          "required": false,
          "description": {
            "zh": "端口号。（暂不支持修改）",
            "en": "Port number. You cannot modify this value."
          }
        },
        {
          "name": "type",
          "position": "Body",
          "type": "String",
          "required": false,
          "description": {
            "zh": "IP白名单的类型：\n\nPUBLIC_ES：Elasticsearch公网访问白名单\nPUBLIC_KIBANA：Kibana公网访问白名单",
            "en": "Type of IP address whitelist:\n\nPUBLIC\\_ES: Elasticsearch public network access whitelist\nPUBLIC\\_KIBANA: Kibana public network access whitelist"
          }
        },
        {
          "name": "whiteIpGroup",
          "position": "Body",
          "type": "RepeatList",
          "required": false,
          "description": {
            "zh": "白名单列表。",
            "en": "Whitelist."
          }
        }
      ]
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新应用公网配置",
    "en": "Update application Internet configuration"
  }
}