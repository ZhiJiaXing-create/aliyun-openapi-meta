{
  "name": "ListSnapshots",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/es-serverless/instances/[appName]/snapshots",
  "parameters": [
    {
      "name": "appName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用名称。",
        "en": "Name of the application."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认值：1。",
        "en": "Page number. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页记录数，默认值：10。",
        "en": "Number of records per page. Default value: 10."
      }
    },
    {
      "name": "repository",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "快照仓库名称。",
        "en": "Name of the snapshot repository."
      }
    },
    {
      "name": "snapshot",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "快照备份名称。",
        "en": "Name of the snapshot backup."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取快照列表",
    "en": "Obtain Snapshot List"
  }
}