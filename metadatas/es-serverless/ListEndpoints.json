{
  "name": "ListEndpoints",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/es-serverless/endpoints",
  "parameters": [
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认值：1。",
        "en": "Page number. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页记录数，默认值：10。",
        "en": "Number of entries per page. Default value: 10."
      }
    },
    {
      "name": "resourceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源ID，VPC类型资源ID对应为privatelink实例ID。",
        "en": "Resource ID. For VPC-type resources, this is the PrivateLink instance ID."
      }
    },
    {
      "name": "type",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "节点类型， 默认VPC。",
        "en": "Endpoint type. Default value: VPC."
      }
    },
    {
      "name": "vpcId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "VPC网络ID。",
        "en": "VPC ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取终端节点列表",
    "en": "List endpoints"
  }
}