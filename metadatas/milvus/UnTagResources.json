{
  "name": "UnTagResources",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/webapi/tags",
  "parameters": [
    {
      "name": "All",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否全部删除，只针对tags为空时有效。取值范围： true  false True False   默认是 false",
        "en": "Specifies whether to remove all tags from the resources. This parameter takes effect only when the TagKey parameter is left empty. Valid values: true and false (default)."
      }
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "地域",
        "en": "The region ID."
      }
    },
    {
      "name": "ResourceId",
      "position": "Query",
      "type": "Json",
      "required": true,
      "description": {
        "zh": "资源ID,最多 50个子项",
        "en": "The resource IDs. A maximum of 50 resource IDs are supported."
      }
    },
    {
      "name": "ResourceType",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "资源类型",
        "en": "The resource type."
      }
    },
    {
      "name": "TagKey",
      "position": "Query",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "对应标签键列表，最多包含20个子项",
        "en": "The tag keys to remove. A maximum of 20 tag keys are supported."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "删除资源标签",
    "en": "UnTagResources"
  }
}