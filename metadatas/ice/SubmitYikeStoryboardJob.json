{
  "name": "SubmitYikeStoryboardJob",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AspectRatio",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "成片视频宽高比",
        "en": "The aspect ratio of the output video."
      }
    },
    {
      "name": "ExecMode",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "故事板生成执行模式\n\n- FullPipeline：全链路生成（包含故事板生成以及分镜视频生成）\n\n- StoryboardOnly：仅生成故事板",
        "en": "The storyboard generation execution mode.\n\n- `FullPipeline`: Executes the full generation pipeline, including both storyboard creation and shot video generation.\n\n- `StoryboardOnly`: Generates only the storyboard."
      }
    },
    {
      "name": "FileURL",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文件 OSS 地址。",
        "en": "The OSS address of the file."
      }
    },
    {
      "name": "ModelParams",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "模型功能参数，Json 格式",
        "en": "Parameters for the model, in JSON format."
      }
    },
    {
      "name": "NarrationVoiceId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "旁白音色ID",
        "en": "The narration voice ID."
      }
    },
    {
      "name": "Resolution",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "成片视频分辨率",
        "en": "The resolution of the output video."
      }
    },
    {
      "name": "ShotPromptMode",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "故事板分镜生成模式",
        "en": "The storyboard shot generation mode."
      }
    },
    {
      "name": "ShotSplitMode",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "拆分镜模式",
        "en": "The shot split mode."
      }
    },
    {
      "name": "SkipFailureShot",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否跳过失败分镜，默认True",
        "en": "Specifies whether to skip a failed shot. The default value is `true`."
      }
    },
    {
      "name": "SourceType",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "源类型",
        "en": "The source type."
      }
    },
    {
      "name": "StyleId",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "故事板风格ID",
        "en": "The storyboard style ID."
      }
    },
    {
      "name": "Title",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "任务标题。若不提供，根据日期自动生成默认title  长度不超过128字节  UTF8编码",
        "en": "The job title. It must be a UTF-8 encoded string of up to 128 bytes. If you do not specify a title, the system generates a default one based on the date."
      }
    },
    {
      "name": "UserData",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "自定义设置，Json 格式。其中：\n- NotifyAddress 为任务完成的回调，支持设置MNS回调以及Http回调。",
        "en": "Custom settings in JSON format. This parameter can contain the following field:\n\n- The `NotifyAddress` field specifies the callback URL that is invoked when the job is complete. Both MNS and HTTP callbacks are supported."
      }
    },
    {
      "name": "VideoModel",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "视频模型",
        "en": "The video model."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "提交故事板生成任务",
    "en": "Submit a storyboard generation job"
  }
}