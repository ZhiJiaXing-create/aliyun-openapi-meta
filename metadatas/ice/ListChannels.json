{
  "name": "ListChannels",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/",
  "parameters": [
    {
      "name": "ChannelName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "频道名称。",
        "en": "The name of the channel."
      }
    },
    {
      "name": "ChannelTier",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "频道等级。",
        "en": "The tier of the channel. Valid values: basic and standard."
      }
    },
    {
      "name": "PageNo",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "当前页码。默认值为1。",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页大小，每页显示条数。默认值为10，最大值为100。",
        "en": "The number of entries per page. Valid values: 1 to 100. Default value: 10."
      }
    },
    {
      "name": "PlaybackMode",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "播放模式。",
        "en": "The playback mode. Valid values: loop and linear."
      }
    },
    {
      "name": "SortBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "创建时间排序。",
        "en": "The sorting order by creation time. Valid values: asc and desc."
      }
    },
    {
      "name": "SortByModifiedTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按修改时间排序。",
        "en": "The sorting order by modification time. Valid values: asc and desc."
      }
    },
    {
      "name": "State",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "频道状态，0，停止；1，开启。",
        "en": "The channel status. A value of 0 specifies stopped. A value of 1 specifies started."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列举频道组装频道",
    "en": "ListChannels"
  },
  "descriptions": {
    "zh": "调用ListChannels接口列举频道组装频道列表。"
  }
}