{
  "name": "ListSources",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/",
  "parameters": [
    {
      "name": "FilterState",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否过滤删除状态。",
        "en": "Specifies whether to ignore sources marked as deleted."
      }
    },
    {
      "name": "PageNo",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "当前页码。默认值为 1。",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "分页大小",
        "en": "The number of entries per page."
      }
    },
    {
      "name": "SortBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序参数，默认根据创建时间倒序",
        "en": "The sorting order. By default, the query results are sorted by creation time in descending order. Valid values: asc and desc."
      }
    },
    {
      "name": "SortByModifiedTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按照修改时间排序。",
        "en": "The sorting order by modification time. Valid values: asc and desc."
      }
    },
    {
      "name": "SourceLocationName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "源位置名称。",
        "en": "The name of the source location."
      }
    },
    {
      "name": "SourceName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "源名称。",
        "en": "The name of the source."
      }
    },
    {
      "name": "SourceType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "源类型。",
        "en": "The source type. Valid values: vodSource and liveSource."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "列举频道组装源信息",
    "en": "ListSources"
  },
  "descriptions": {
    "zh": "调用ListSources接口列举源信息。"
  }
}