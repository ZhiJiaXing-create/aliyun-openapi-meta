{
  "name": "ListUsers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/api/v1/tenants/[TenantId]/users",
  "parameters": [
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页查询时设置的每页显示的标注成员数量，默认为20。",
        "en": "The number of annotated members displayed per page in a paged query. Default value: 20."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "标注成员列表的页码。起始值为1，默认为1。",
        "en": "Page number of the annotate member list. The starting value is 1. The default value is 1."
      }
    },
    {
      "name": "TenantId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "租户ID。如何获取租户ID，请参见[ListTenants](~~454649~~)。",
        "en": "Tenant ID. For information about how to obtain a tenant ID, see [ListTenants](~~454649~~)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "展示标注成员",
    "en": "Display Annotate Members"
  },
  "example": {
    "unifiedCli": "aliyun openitag list-users --tenant-id GA000W134 --page-size 1 --page-number 20 --region cn-hangzhou",
    "legacyCli": "aliyun openitag GET /openapi/api/v1/tenants/GA000W134/users --region cn-hangzhou --PageSize 1 --PageNumber 20 --header \"Content-Type=application/json\""
  }
