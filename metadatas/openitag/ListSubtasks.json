      "description": {
        "zh": "子任务列表的页码。起始值为1，默认为1。",
        "en": "The page number of the subtask List. The starting value is 1, and the default value is 1."
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页查询时设置的每页显示的子任务数量，默认为20。",
        "en": "The number of subtasks displayed per page in a paged query. Default value is 20."
      }
    },
    {
      "name": "TaskID",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "如何获取任务ID，请参见[ListTasks](~~454662~~)。",
        "en": "For information about how to obtain a task ID, see [ListTasks](~~454662~~)."
      }
    },
    {
      "name": "TenantId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "租户ID。如何获取租户ID，请参见[ListTenants](~~454649~~)。",
        "en": "Tenant ID. For information about how to obtain a tenant ID, see [ListTenants](~~454649~~)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "子任务列表查询",
    "en": "Query Subtask List"
  },
  "example": {
    "unifiedCli": "aliyun openitag list-subtasks --tenant-id GAR000134 --task-id 1540002518306500608 --page-number 1 --page-size 20 --region cn-hangzhou",
    "legacyCli": "aliyun openitag GET /openapi/api/v1/tenants/GAR000134/tasks/1540002518306500608/subtasks --region cn-hangzhou --PageSize 20 --PageNumber 1 --header \"Content-Type=application/json\""
  }
}