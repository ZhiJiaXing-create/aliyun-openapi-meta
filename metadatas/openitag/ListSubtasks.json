{
  "name": "ListSubtasks",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/api/v1/tenants/[TenantId]/tasks/[TaskID]/subtasks",
  "parameters": [
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
