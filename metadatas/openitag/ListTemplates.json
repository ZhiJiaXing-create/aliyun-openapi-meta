  "example": {
    "unifiedCli": "aliyun openitag list-templates --tenant-id GAR000134 --page-number 1 --page-size 20 --search-key demo --types CUSTOM --region cn-hangzhou",
    "legacyCli": "aliyun openitag GET /openapi/api/v1/tenants/GAR000134/templates --region cn-hangzhou --Types CUSTOM --PageSize 20 --PageNumber 1 --SearchKey demo --header \"Content-Type=application/json\""
