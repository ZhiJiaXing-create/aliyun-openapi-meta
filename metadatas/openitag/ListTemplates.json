      "description": {
        "zh": "页面标号",
        "en": "Page number"
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页面大小",
        "en": "Page size"
      }
    },
    {
      "name": "SearchKey",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "搜索内容",
        "en": "Search content"
      }
    },
    {
      "name": "TenantId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "租户id，可以通过ListTenants租户列表查询的API来查询。",
        "en": "Tenant ID, which can be queried by using the ListTenants API to query the tenant list."
