{
  "name": "ListTemplates",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/api/v1/tenants/[TenantId]/templates",
  "parameters": [
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
