{
  "name": "AddWorkNodeWorkforce",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/openapi/api/v1/tenants/[TenantId]/tasks/[TaskId]/worknodes/[WorkNodeId]/workforce",
  "parameters": [
    {
      "name": "TaskId",
      "position": "Path",
      "type": "Long",
      "required": true,
      "description": {
        "zh": "任务ID。如何获取任务ID，请参见[ListTasks](~~454662~~)。",
        "en": "Job ID. For information about how to obtain the job ID, see [ListTasks](~~454662~~)."
      }
    },
    {
      "name": "TenantId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "租户ID。如何获取租户ID，请参见[ListTenants](~~454649~~)。",
        "en": "Tenant ID. For information about how to obtain the tenant ID, see [ListTenants](~~454649~~)."
      }
    },
    {
      "name": "WorkNodeId",
      "position": "Path",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "工作结点ID，工作流顺序，从0开始。例如标注-质检-验收中，标注是0，质检是1，验收是2。",
        "en": "Worker node ID, which corresponds to the pipeline sequence starting from 0. For example, in the sequence annotation → quality inspection → validation, annotation is 0, quality inspection is 1, and validation is 2."
      }
