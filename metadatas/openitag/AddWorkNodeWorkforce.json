    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "项目。",
        "en": "Project."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "增加成员",
    "en": "Add members"
  },
  "example": {
    "unifiedCli": "aliyun openitag add-work-node-workforce --tenant-id GA000W134 --task-id 1543000518306500608 --work-node-id 0 --user-ids 1662000080757311 --region cn-hangzhou",
    "legacyCli": "aliyun openitag POST /openapi/api/v1/tenants/GA000W134/tasks/1543000518306500608/worknodes/0/workforce --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"UserIds\":[1662000080757311]}"
