{
  "name": "CloseChatInstanceSessions",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/openapi/chat/instances/[instanceId]/sessions/close",
  "parameters": [
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "购买开通的实例id，可在订单页查看。",
        "en": "The ID of the chat instance. You can find this ID on the order page."
      }
    },
    {
      "name": "sessionIds",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "待关闭的会话id列表。",
        "en": "The IDs of sessions to be closed."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "关闭实例下的会话",
    "en": "Shut down sessions under an instance"
  }
