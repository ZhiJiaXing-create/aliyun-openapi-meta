{
  "name": "ListPipeline",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/logstashes/[InstanceId]/pipelines",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Logstash实例ID。",
        "en": "The Logstash instance ID."
      }
    },
    {
      "name": "page",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页查询时，设置当前页面的页码。取值范围：1~200，默认值：1。",
        "en": "The page number of the current page for a paged query. Valid values: 1 to 200. Default value: 1."
      }
    },
    {
      "name": "pipelineId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "管道ID。",
        "en": "The pipeline ID."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页查询时，设置每页包含管道的数量。取值范围：1~200。",
        "en": "The number of pipelines per page for a paged query. Valid values: 1 to 200."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "Logstash的管道列表",
    "en": "Logstash pipeline list"
  },
  "example": {
    "unifiedCli": "aliyun elasticsearch list-pipeline --instance-id ls-cn-oew1qbgl0000 --pipeline-id pipeline_test --page 1 --size 15 --api-version 2017-06-13 --region cn-hangzhou",
    "legacyCli": "aliyun elasticsearch GET /openapi/logstashes/ls-cn-oew1qbgl0000/pipelines --region cn-hangzhou --size 15 --page 1 --pipelineId pipeline_test --header \"Content-Type=application/json\""
  }
}