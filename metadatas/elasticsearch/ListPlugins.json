{
  "name": "ListPlugins",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/instances/[InstanceId]/plugins",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "插件名称。",
        "en": "The plugin name."
      }
    },
    {
      "name": "page",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "分页数。",
        "en": "The page number."
      }
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页记录数。",
        "en": "The number of records per page."
      }
    },
    {
      "name": "source",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "插件来源类型，仅支持SYSTEM（系统插件）。",
        "en": "The plugin source type. Only SYSTEM (system plugin) is supported."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取实例插件列表",
    "en": "Retrieve instance plugin list"
  },
  "example": {
    "unifiedCli": "aliyun elasticsearch list-plugins --instance-id es-cn-nif1q9o8r00080000 --name analysis-ik --page 1 --size 10 --source SYSTEM --api-version 2017-06-13 --region cn-hangzhou",
    "legacyCli": "aliyun elasticsearch GET /openapi/instances/es-cn-nif1q9o8r00080000/plugins --region cn-hangzhou --size 10 --name 'analysis-ik' --page 1 --source SYSTEM --header \"Content-Type=application/json\""
  }
}