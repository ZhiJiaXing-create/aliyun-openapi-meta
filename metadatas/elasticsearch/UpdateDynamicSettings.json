{
  "name": "UpdateDynamicSettings",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/openapi/instances/[InstanceId]/dynamic-settings",
  "parameters": [
    {
      "name": "ClientToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "幂等参数",
        "en": "A client token used to ensure the idempotency of the request."
      }
    },
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "en": "The ID of the Elasticsearch instance."
      }
    },
    {
      "name": "RegionId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "en": "The ID of the region where the instance is deployed."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "en": "The request body, which contains the dynamic settings to be updated."
      }
    },
    {
      "name": "mode",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "en": "The update mode for the dynamic settings."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "example": {
    "unifiedCli": "aliyun elasticsearch update-dynamic-settings --client-token example-string --instance-id example-string --biz-region-id cn-hangzhou --biz-body example-string --biz-mode example-string --api-version 2017-06-13 --region cn-hangzhou",
    "legacyCli": "aliyun elasticsearch PUT /openapi/instances/example-string/dynamic-settings --region cn-hangzhou --mode 'example-string' --RegionId 'cn-hangzhou' --ClientToken 'example-string' --header \"Content-Type=application/json\" --body \"example-string\""
  }
