    {
      "name": "scheduleStartTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "调度起始时间",
        "en": "The scheduling start time."
      }
    },
    {
      "name": "scheduleState",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "调度状态",
        "en": "The scheduling status. Valid values:"
      }
    },
    {
      "name": "taskDefinitionJson",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务定义json，包含工作流所有任务的描述信息",
        "en": "The task definition JSON that contains the description of all tasks in the workflow."
      }
    },
    {
      "name": "taskRelationJson",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务依赖关系json，包含工作流所有任务之间的依赖关系，preTaskId为上游任务id，postTaskId为下游任务id，此处指定的任务id为自定义id（不能为0），每一个任务需有唯一的id。如果任务节点没有上游任务，也需要增加一个preTaskId为0的依赖关系",
        "en": "The task dependency JSON that contains the dependencies between all tasks in the workflow. preTaskId specifies the upstream task ID, and postTaskId specifies the downstream task ID. The task IDs specified here are custom IDs that cannot be 0, and each task must have a unique ID. If a task node has no upstream task, add a dependency with preTaskId set to 0."
      }
    },
    {
      "name": "timeZone",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "时区",
        "en": "The time zone."
      }
    },
    {
      "name": "timeout",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "超时的时间，单位：分钟",
        "en": "The timeout period. Unit: minutes."
      }
    },
    {
      "name": "workflowInstancePriority",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作流实例优先级",
        "en": "The workflow instance priority."
      }
    },
    {
      "name": "workflowParams",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "工作流参数",
        "en": "The workflow parameters."
      }
