{
  "name": "GetPodEvents",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/jobs/[JobId]/pods/[PodId]/events",
  "parameters": [
    {
      "name": "EndTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "截止时间（UTC）。",
        "en": "The end time (UTC)."
      }
    },
    {
      "name": "JobId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "任务ID。参见[ListJobs](~~459676~~)获取任务ID。",
        "en": "The job ID. Call [ListJobs](~~459676~~) to get the job ID."
      }
    },
    {
      "name": "MaxEventsNum",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "返回的事件最大数量。",
        "en": "The maximum number of events that can be returned."
      }
    },
    {
      "name": "PodId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "节点ID。参见[GetJob](~~459677~~)获取节点ID。",
        "en": "The node ID. Call [GetJob](~~459677~~) to get the node ID."
      }
    },
    {
      "name": "PodUid",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "节点UID。参见[GetJob](~~459677~~)获取节点UID。",
        "en": "The node UID. Call [GetJob](~~459677~~) to get the node UID."
      }
    },
    {
      "name": "StartTime",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "起始时间（UTC）。",
        "en": "The start time (UTC)."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取任务中某个节点的系统事件",
    "en": "GetPodEvents"
  },
  "example": {
    "unifiedCli": "aliyun pai-dlc get-pod-events --job-id dlc-20210126170216-00000 --pod-id dlc-20210126170216-mtl37ge7g0000-chief-0 --pod-uid dlc-20210126170216-00000-chief-0 --max-events-num 100 --start-time 2020-11-08T16:00:00Z --end-time 2020-11-09T16:00:00Z --region cn-hangzhou",
    "legacyCli": "aliyun pai-dlc GET /api/v1/jobs/dlc-20210126170216-00000/pods/dlc-20210126170216-mtl37ge7g0000-chief-0/events --region cn-hangzhou --EndTime '2020-11-09T16:00:00Z' --PodUid 'dlc-20210126170216-00000-chief-0' --StartTime '2020-11-08T16:00:00Z' --MaxEventsNum 100 --header \"Content-Type=application/json\""
  }
}