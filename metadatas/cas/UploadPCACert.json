  "title": {
    "zh": "上传证书仓库pca证书",
    "en": "UploadPCACert"
  },
  "descriptions": {
    "zh": "本接口一般用于在证书仓库中上传PCA证书。\n## QPS限制\n本接口的单用户QPS限制为10次/秒。超过限制，API调用将会被限流，这可能影响您的业务，请合理调用。",
    "en": "Use this operation to upload a PCA certificate to a certificate warehouse.\n\n## QPS limit\n\nThe QPS limit for this operation is 10 requests per second per user. Exceeding this limit triggers throttling, which can affect your business."
  },
  "example": {
    "unifiedCli": "aliyun cas upload-pca-cert --warehouse-id 1 --cert -----BEGIN_CERTIFICATE-----_MIIEJDCCAwygAwIBAgIQITRHItTLTQizTyd3K7AMRTANBgkqhkiG9w0BAQsFADBe_0000000000000000_5/akmr2GK/Y=_-----END_CERTIFICATE-----_-----BEGIN_CERTIFICATE-----_MIIDuzCCAqOgAwIBAgIQSEIWDPfWTDKZcWNyL2O+fjANBgkqhkiG9w0BAQsFADBf_0000000000000000_URUHyMW5Qd5Q9g6Y4sDOIm6It9TF7EjpwMs42R30agcRYzuUsN72ZFBYFJwnBX8=_-----END_CERTIFICATE-----_-----BEGIN_CERTIFICATE-----_MIIDizCCAnOgAwIBAgIRAMfjPkDKfELTo07l3A3cUSYwDQYJKoZIhvcNAQELBQAw_000000000_CjWTnYPhCcO2uIcnqMt7zCVs5LXBK/XSwlAXKMvKT0uuzw9VxeMfEabflKu0By8=_-----END_CERTIFICATE----- --biz-private-key -----BEGIN_RSA_PRIVATE_KEY-----_MIIEowIBAAKCAQEA5SIfpNCBoiDrZhX1H39CHwQMVD0kBNeBTWfP9xkeesvfzbOz_0000000_POVNFfDf9h7pJtQ5fRZNTYTDs/d+cH62Z3+nS74mNnEfff0nkvne_-----END_RSA_PRIVATE_KEY----- --name cert_name --api-version 2020-04-07 --region cn-hangzhou",
    "legacyCli": "aliyun cas UploadPCACert --region cn-hangzhou --PrivateKey '-----BEGIN_RSA_PRIVATE_KEY-----_MIIEowIBAAKCAQEA5SIfpNCBoiDrZhX1H39CHwQMVD0kBNeBTWfP9xkeesvfzbOz_0000000_POVNFfDf9h7pJtQ5fRZNTYTDs/d+cH62Z3+nS74mNnEfff0nkvne_-----END_RSA_PRIVATE_KEY-----' --WarehouseId 1 --Cert '-----BEGIN_CERTIFICATE-----_MIIEJDCCAwygAwIBAgIQITRHItTLTQizTyd3K7AMRTANBgkqhkiG9w0BAQsFADBe_0000000000000000_5/akmr2GK/Y=_-----END_CERTIFICATE-----_-----BEGIN_CERTIFICATE-----_MIIDuzCCAqOgAwIBAgIQSEIWDPfWTDKZcWNyL2O+fjANBgkqhkiG9w0BAQsFADBf_0000000000000000_URUHyMW5Qd5Q9g6Y4sDOIm6It9TF7EjpwMs42R30agcRYzuUsN72ZFBYFJwnBX8=_-----END_CERTIFICATE-----_-----BEGIN_CERTIFICATE-----_MIIDizCCAnOgAwIBAgIRAMfjPkDKfELTo07l3A3cUSYwDQYJKoZIhvcNAQELBQAw_000000000_CjWTnYPhCcO2uIcnqMt7zCVs5LXBK/XSwlAXKMvKT0uuzw9VxeMfEabflKu0By8=_-----END_CERTIFICATE-----' --Name cert_name"
  }
