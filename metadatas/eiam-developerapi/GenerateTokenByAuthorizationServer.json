{
  "name": "GenerateTokenByAuthorizationServer",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/v2/[instanceId]/authorizationServer/[authorizationServerId]/oauth2/token",
  "parameters": [
    {
      "name": "application_federated_credential_name",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "应用联邦凭证名称。",
        "en": "Federated application credential name."
      }
    },
    {
      "name": "authorizationServerId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "授权服务器ID。",
        "en": "Authorization server ID."
      }
    },
    {
      "name": "client_assertion",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "客户端断言。",
        "en": "Client assertion."
      }
    },
    {
      "name": "client_assertion_type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "客户端断言的类型。",
        "en": "Client assertion type."
      }
    },
    {
      "name": "client_id",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "客户端ID。",
        "en": "Client ID."
      }
    },
    {
      "name": "client_secret",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "客户端密钥。",
        "en": "Client key."
      }
    },
    {
      "name": "client_x509",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "终端证书。",
        "en": "Client certificate."
      }
    },
    {
      "name": "client_x509_chain",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "中间证书列表。",
        "en": "Intermediate certificate list."
      }
    },
    {
      "name": "code",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "授权code码，传入场景：\ngrant\\_type=authorization_code 授权码模式时，必填参数。",
        "en": "Authorization code. Required when grant\\_type is authorization\\_code."
      }
    },
    {
      "name": "code_verifier",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "验证 code。",
        "en": "You can validate the code."
      }
    },
    {
      "name": "device_code",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "设备code码，传入场景：\ngrant\\_type=urn:ietf:params:oauth:grant-type:device_code即设备流模式时，必填参数。",
        "en": "Device code. Required when grant\\_type is urn:ietf:params:oauth:grant-type:device\\_code."
      }
    },
    {
      "name": "grant_type",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "授权类型。",
        "en": "Grant type."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例 ID。",
        "en": "Instance ID."
      }
    },
    {
      "name": "password",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户密码。",
        "en": "Password."
      }
    },
    {
      "name": "redirect_uri",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "重定向URI，传入场景：\ngrant_type=authorization_code 授权码模式时，必须参数，与获取授权码请求中的重定向URI必须是一致的。",
        "en": "Redirection URI. Required when grant\\_type is authorization\\_code. Must match the redirect\\_uri used in the authorization code request."
      }
    },
    {
      "name": "refresh_token",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "刷新凭证。",
        "en": "Refresh token."
      }
    },
    {
      "name": "scope",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "scope范围。",
        "en": "Scope."
      }
    },
    {
      "name": "username",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "用户名。",
        "en": "Username."
      }
    }
  ],
  "security": [
    "Anonymous"
  ],
  "title": {
    "zh": "通过实例级授权服务器生成应用认证 token",
    "en": "GenerateTokenByAuthorizationServer"
  }
}