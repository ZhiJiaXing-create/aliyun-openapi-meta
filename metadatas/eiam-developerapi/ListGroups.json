{
  "name": "ListGroups",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v2/[instanceId]/[applicationId]/groups",
  "parameters": [
    {
      "name": "Authorization",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "认证信息。\n格式：Bearer ${access_token}。\n示例：Bearer ATxxxx。",
        "en": "The authentication information. The value is in the Bearer ${access\\_token} format. Example: Bearer ATxxxx."
      }
    },
    {
      "name": "applicationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用ID。",
        "en": "The application ID."
      }
    },
    {
      "name": "groupNameStartWith",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "组名称前缀",
        "en": "The prefix of the group name."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "maxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "单页大小，默认20",
        "en": "The number of entries per page. Default value: 20."
      }
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "nextToken",
        "en": "nextToken"
      }
    }
  ],
  "security": [
    "Anonymous"
  ],
  "title": {
    "zh": "列表查询EIAM组信息",
    "en": "ListGroups"
  }
}