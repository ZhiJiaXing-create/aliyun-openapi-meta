{
  "name": "ListUsers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/v2/[instanceId]/[applicationId]/users",
  "parameters": [
    {
      "name": "Authorization",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "认证信息。\n格式：Bearer ${access_token}。\n示例：Bearer ATxxxx。",
        "en": "The authentication information. Format: Bearer ${access\\_token}. Example: Bearer ATxxxx."
      }
    },
    {
      "name": "applicationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用ID。",
        "en": "The application ID."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "organizationalUnitId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "组织ID。",
        "en": "The organization ID."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认1。",
        "en": "The page number. The default value is 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "单页大小读取记录数，默认20，范围为1～100。",
        "en": "The number of records to return on each page. The default value is 20. The value must be in the range of 1 to 100."
      }
    }
  ],
  "security": [
    "Anonymous"
  ],
  "title": {
    "zh": "列表查询EIAM账户",
    "en": "ListUsers"
  }
}