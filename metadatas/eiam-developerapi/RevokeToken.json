{
  "name": "RevokeToken",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/v2/[instanceId]/[applicationId]/oauth2/revoke",
  "parameters": [
    {
      "name": "applicationId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "应用ID。",
        "en": "The application ID."
      }
    },
    {
      "name": "client_id",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "客户端ID。",
        "en": "The client ID."
      }
    },
    {
      "name": "client_secret",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "客户端密钥。",
        "en": "The client secret."
      }
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID。",
        "en": "The instance ID."
      }
    },
    {
      "name": "token",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待撤销的token。",
        "en": "The token to be revoked."
      }
    },
    {
      "name": "token_type_hint",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "token类型，取值可选范围：\naccess_token\nrefresh\\_token",
        "en": "The type of the token. Valid values: access\\_token refresh\\_token"
      }
    }
  ],
  "security": [
    "Anonymous"
  ],
  "title": {
    "zh": "吊销指定的token",
    "en": "RevokeToken"
  }
}