    "en": "UpdateResourceInstanceLabel"
  },
  "example": {
    "unifiedCli": "aliyun eas update-resource-instance-label --cluster-id cn-shanghai --resource-id eas-r-asdasdasd --instance-ids eas-i-xxxxxx --all-instances false --labels key=example-string --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/resources/cn-shanghai/eas-r-asdasdasd/label --region cn-hangzhou --InstanceIds 'eas-i-xxxxxx' --AllInstances false --header \"Content-Type=application/json\" --body {\"Labels\":{\"key\":\"example-string\"}}"
