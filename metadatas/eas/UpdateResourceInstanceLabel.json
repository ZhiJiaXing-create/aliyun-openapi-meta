        "en": "The region ID."
      }
    },
    {
      "name": "InstanceIds",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "机器实例ID。",
        "en": "The instance IDs."
      }
    },
    {
      "name": "ResourceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "资源组的ID。",
        "en": "The resource group ID."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求Body。",
        "en": "The request body."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
