{
  "name": "UpdateResourceInstance",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/resources/[ClusterId]/[ResourceId]/instances/[InstanceId]",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例所在地域ID。",
        "en": "The region ID of the instance."
      }
    },
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例ID，如何获取实例ID，请参见[ListResourceInstances](~~412129~~)。",
        "en": "The ID of the instance. For more information, see [ListResourceInstances](~~412129~~)."
      }
    },
    {
      "name": "ResourceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "实例所属资源组ID，如何查询资源组ID，请参见[ListResources](~~412133~~)。",
        "en": "The ID of the resource group that contains the instance. For more information, see [ListResources](~~412133~~)."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求body参数。",
        "en": "The request body."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新资源组机器实例",
    "en": "UpdateResourceInstance"
  },
  "example": {
    "unifiedCli": "aliyun eas update-resource-instance --cluster-id cn-beijing --resource-id eas-r-asdas0000 --instance-id eas-i-asdas0000 --action Cordon --new-disk-size example-string --reason example-string --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/resources/cn-beijing/eas-r-asdas0000/instances/eas-i-asdas0000 --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"NewDiskSize\":\"example-string\",\"Action\":\"Cordon\",\"Reason\":\"example-string\"}"
  }
}