{
  "name": "UpdateServiceVersion",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/version",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务所在地域ID。",
        "en": "The ID of the region where the service is deployed."
      }
    },
    {
      "name": "ServiceName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务名字。如何查看服务名称，请参见[ListServices ](~~412109~~)。",
        "en": "The service name. For more information about how to query the service name, see [ListServices](~~412109~~)."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求Body。",
        "en": "The request body."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "切换服务版本",
    "en": "UpdateServiceVersion"
  },
  "example": {
    "unifiedCli": "aliyun eas update-service-version --cluster-id cn-shanghai --service-name echo --biz-version 1 --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-shanghai/echo/version --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"Version\":1}"
  }
}