{
  "name": "UpdateGroup",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/groups/[ClusterId]/[GroupName]",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "所属所在地域ID。",
        "en": "The region ID."
      }
    },
    {
      "name": "GroupName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务群组名称。如何获取群组名称，请参见ListServices 。",
        "en": "The name of the service group. To obtain the group name, call ListServices."
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求内容",
        "en": "The request body."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新服务组",
    "en": "Update a service group"
  },
  "example": {
    "unifiedCli": "aliyun eas update-group --cluster-id cn-wulanchabu --group-name foo --traffic-mode auto --network VpcId=vpc-bp1xxxxxx17e0qrykjr9b VSwitchId=vsw-bp1xxxxxxjeqwbo3z2pux SecurityGroupId=sg-uf6xxxxxxc3lysxabg72i GatewayId=gw-rcgxxxxxxzytgq9zrj --labels key=example-string --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/groups/cn-wulanchabu/foo --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"TrafficMode\":\"auto\",\"Network\":{\"VpcId\":\"vpc-bp1xxxxxx17e0qrykjr9b\",\"VSwitchId\":\"vsw-bp1xxxxxxjeqwbo3z2pux\",\"SecurityGroupId\":\"sg-uf6xxxxxxc3lysxabg72i\",\"GatewayId\":\"gw-rcgxxxxxxzytgq9zrj\"},\"Labels\":{\"key\":\"example-string\"}}"
  }
}