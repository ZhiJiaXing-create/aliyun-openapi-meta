{
  "name": "ListServiceContainers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/instances/[InstanceName]/containers",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务所在地域ID。",
        "en": "The region ID of the service."
      }
    },
    {
      "name": "InstanceName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务实例的名称。",
        "en": "The name of the instance that runs the service."
      }
    },
    {
      "name": "ServiceName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "服务名称。",
        "en": "The service name."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查询服务的容器列表",
    "en": "ListServiceContainers"
  },
  "example": {
    "unifiedCli": "aliyun eas list-service-containers --cluster-id cn-shanghai --service-name foo --instance-name foo-69xxxx4f4-5w9r9 --region cn-hangzhou",
    "legacyCli": "aliyun eas GET /api/v2/services/cn-shanghai/foo/instances/foo-69xxxx4f4-5w9r9/containers --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}