  "example": {
    "unifiedCli": "aliyun eas update-app-service --cluster-id cn-shanghai --service-name foo --workspace-id 123400 --quota-id abcdef --app-type LLM --app-version v1 --service-spec llama_7b_fp16 --replicas 1 --config key=example-string --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/app_services/cn-shanghai/foo --region cn-hangzhou --QuotaId abcdef --WorkspaceId 123400 --header \"Content-Type=application/json\" --body {\"AppVersion\":\"v1\",\"Config\":{\"key\":\"example-string\"},\"ServiceSpec\":\"llama_7b_fp16\",\"Replicas\":1,\"AppType\":\"LLM\"}"
