{
  "name": "UpdateDeploymentTargetV2",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/namespaces/[namespace]/deployment-targets/support-elastic/[deploymentTargetName]",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": false,
      "description": {
        "zh": "部署目标资源。",
        "en": "The deployment target resource."
      }
    },
    {
      "name": "deploymentTargetName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "部署目标名称。",
        "en": "The name of the deployment target."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The namespace name."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "更新部署目标（V2）",
    "en": "Update Deployment Target (V2)"
  },
  "descriptions": {
    "zh": "原更新部署目标的接口仅支持创建固定资源或弹性资源的部署目标，新接口支持更新固定资源、弹性资源或者混合模式的部署目标。",
    "en": "This new API operation updates deployment targets that use fixed resources, elastic resources, or mixed mode. The previous operation supported only fixed and elastic resources."
  },
  "example": {
    "unifiedCli": "aliyun ververica update-deployment-target-v2 --workspace a14bd5d90a0000 --namespace default-namespace --deployment-target-name test-dt --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica PUT /api/v2/namespaces/default-namespace/deployment-targets/support-elastic/test-dt --region cn-hangzhou --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\" --body \"example-string\""
  }
}