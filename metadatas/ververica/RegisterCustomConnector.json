{
  "name": "RegisterCustomConnector",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/api/v2/namespaces/[namespace]/connectors:register",
  "parameters": [
    {
      "name": "jarUrl",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "自定义连接器Jar包存放的地址，需要平台可访问该地址。",
        "en": "The URL in which the JAR package of the custom connector is stored. The platform must be able to access this address."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "注册自定义连接器",
    "en": "RegisterCustomConnector"
  },
  "example": {
    "unifiedCli": "aliyun ververica register-custom-connector --workspace a14bd5d90a0000 --namespace default-namespace --jar-url oss://flink/connector/mysql123 --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica POST /api/v2/namespaces/default-namespace/connectors:register --region cn-hangzhou --jarUrl 'oss://flink/connector/mysql123' --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}