{
  "name": "ListScheduledPlan",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/scheduled-plans",
  "parameters": [
    {
      "name": "deploymentId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "已部署作业ID。",
        "en": "The ID of the job."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "pageIndex",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页参数，页码索引，表示所请求页码，默认值为1。",
        "en": "The page number to return. The default value is 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页参数，所请求页码的元素数量，默认值为10，最大值100。",
        "en": "The number of entries to return on each page. The default value is 10. The maximum value is 100."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取定时计划列表",
    "en": "Retrieve the list of scheduled plans"
  },
  "example": {
    "unifiedCli": "aliyun ververica list-scheduled-plan --workspace a14bd5d90a0000 --namespace default-namespace --page-size 10 --page-index 1 --deployment-id 737d0921-c5ac-47fc-9ba9-07a1e0b40000 --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/scheduled-plans --region cn-hangzhou --pageIndex 1 --deploymentId '737d0921-c5ac-47fc-9ba9-07a1e0b40000' --pageSize 10 --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}