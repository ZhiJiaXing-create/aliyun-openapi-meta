    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/deployments/737d0921-c5ac-47fc-9ba9-07a1e0b40000/jobs/5af678c0-7db0-4650-94c2-d2604f0a0000/job-diagnoses/lite --region cn-hangzhou --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
