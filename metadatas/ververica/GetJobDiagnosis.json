{
  "name": "GetJobDiagnosis",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/deployments/[deploymentId]/jobs/[jobId]/job-diagnoses/lite",
  "parameters": [
    {
      "name": "deploymentId",
      "position": "Path",
      "type": "String",
