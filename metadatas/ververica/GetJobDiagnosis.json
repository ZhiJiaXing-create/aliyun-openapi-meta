        "zh": "已部署作业ID。",
        "en": "The ID of the deployed job."
      }
    },
    {
      "name": "jobId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "作业实例ID。",
        "en": "The job instance ID."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The namespace."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
