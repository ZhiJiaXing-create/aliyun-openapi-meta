        "en": "The name of the namespace."
      }
    },
    {
      "name": "udfArtifactName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "UDF对应的Jar或者Python文件的名称。",
        "en": "The name of the JAR or Python file that corresponds to the UDF."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
