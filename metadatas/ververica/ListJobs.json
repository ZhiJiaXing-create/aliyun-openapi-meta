{
  "name": "ListJobs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/jobs",
  "parameters": [
    {
      "name": "deploymentId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "已部署作业ID。",
        "en": "The ID of the deployment."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "pageIndex",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页参数，页码索引，表示所请求页码，最小值为1，默认值为1。",
        "en": "The page number to return. Minimum value: 1. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页参数，表示所请求页码元素数量，最大值为100，最小值为1，默认值为10。",
        "en": "The number of entries per page. Maximum value: 100. Minimum value: 1. Default value: 10."
      }
    },
    {
      "name": "sortName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序规则。",
        "en": "The field to sort the results by."
      }
    },
    {
      "name": "sortOrder",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The ID of the workspace."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取作业实例列表",
    "en": "ListJobs"
  },
  "example": {
    "unifiedCli": "aliyun ververica list-jobs --workspace a14bd5d90a0000 --namespace default-namespace --page-index 1 --page-size 10 --deployment-id 58718c99-3b29-4c5e-93bb-c9fc4ec60000 --sort-name gmt_create --sort-order example-string --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/jobs --region cn-hangzhou --sortName gmt_create --pageIndex 1 --deploymentId '58718c99-3b29-4c5e-93bb-c9fc4ec60000' --sortOrder 'example-string' --pageSize 10 --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}