{
  "name": "GetEvents",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/events",
  "parameters": [
    {
      "name": "deploymentId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "已部署作业ID。",
        "en": "The ID of the deployed job. If you specify this parameter, the operation returns events only for this job."
      }
    },
    {
      "name": "deploymentName",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "pageIndex",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页参数，页码索引，表示所请求页码，默认值为1。",
        "en": "The page number to retrieve. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页参数，所请求页码的元素数量，默认值为10，最大值100。",
        "en": "The number of entries per page. Default value: 10. Maximum value: 100."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The ID of the workspace."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取运行事件",
    "en": "Retrieve management events"
  },
  "example": {
    "unifiedCli": "aliyun ververica get-events --workspace a14bd5d90a0000 --namespace default-namespace --page-size 10 --page-index 1 --deployment-id 58718c99-3b29-4c5e-93bb-c9fc4ec60000 --deployment-name example-string --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/events --region cn-hangzhou --pageIndex 1 --deploymentId '58718c99-3b29-4c5e-93bb-c9fc4ec60000' --pageSize 10 --deploymentName 'example-string' --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}