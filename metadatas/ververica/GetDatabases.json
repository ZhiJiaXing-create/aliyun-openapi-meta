{
  "name": "GetDatabases",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/catalogs/[catalogName]/databases",
  "parameters": [
    {
      "name": "catalogName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "catalog名称。",
        "en": "The name of the catalog."
      }
    },
    {
      "name": "databaseName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "database名称，为空时返回所有database信息。",
        "en": "The name of the database. If you do not specify this parameter, information about all databases in the catalog is returned."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The ID of the workspace."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取Database信息",
    "en": "GetDatabases"
  },
  "example": {
    "unifiedCli": "aliyun ververica get-databases --workspace a14bd5d90a0000 --namespace default-namespace --catalog-name paimon --database-name paimon-ods --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/catalogs/paimon/databases --region cn-hangzhou --databaseName 'paimon-ods' --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}