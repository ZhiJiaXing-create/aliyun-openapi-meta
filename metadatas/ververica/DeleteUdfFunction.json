{
  "name": "DeleteUdfFunction",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "DELETE",
  "pathPattern": "/api/v2/namespaces/[namespace]/udfartifacts/function/[functionName]",
  "parameters": [
    {
      "name": "className",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "自定义函数对应的类名。",
        "en": "The name of the class that corresponds to the UDF."
      }
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "需删除的自定义函数名称。",
        "en": "The name of the UDF that you want to delete."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "udfArtifactName",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "需要删除的自定义函数对应的自定义函数资源名称。",
        "en": "The name of the resource that corresponds to the UDF that you want to delete."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "删除自定义函数",
    "en": "DeleteUdfFunction"
  },
  "example": {
    "unifiedCli": "aliyun ververica delete-udf-function --workspace a14bd5d90a0000 --namespace u-gs3rgla9-default --function-name category --udf-artifact-name test-udf --class-name Category --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica DELETE /api/v2/namespaces/u-gs3rgla9-default/udfartifacts/function/category --region cn-hangzhou --udfArtifactName 'test-udf' --className Category --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}