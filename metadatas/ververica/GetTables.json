{
  "name": "GetTables",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/catalogs/[catalogName]/databases/[databaseName]/tables",
  "parameters": [
    {
      "name": "catalogName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "catalog名称。",
        "en": "The name of the catalog."
      }
    },
    {
      "name": "databaseName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "database名称。",
        "en": "The name of the database."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "tableName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "表名，表名为空返回所有表信息。",
        "en": "The name of the table. If this parameter is left empty, information about all tables is returned."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取表信息",
    "en": "Obtain Table Information"
  },
  "example": {
    "unifiedCli": "aliyun ververica get-tables --workspace a14bd5d90a0000 --namespace u-gs3rgla9-default --catalog-name paimon --database-name paimon-ods --table-name item --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/u-gs3rgla9-default/catalogs/paimon/databases/paimon-ods/tables --region cn-hangzhou --tableName item --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}