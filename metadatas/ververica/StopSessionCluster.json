{
  "name": "StopSessionCluster",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/api/v2/namespaces/[namespace]/sessionclusters/[sessionClusterName]:stop",
  "parameters": [
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "sessionClusterName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "Session集群名称。",
        "en": "The name of the session cluster."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The ID of the workspace."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "停止Session集群",
    "en": "Stop Session Cluster"
  },
  "example": {
    "unifiedCli": "aliyun ververica stop-session-cluster --workspace a14bd5d90a0000 --namespace default-namespace --session-cluster-name test-session --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica POST /api/v2/namespaces/default-namespace/sessionclusters/test-session:stop --region cn-hangzhou --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}