{
  "name": "ListMembers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/gateway/v2/namespaces/[namespace]/members",
  "parameters": [
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "pageIndex",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页参数，页码索引，表示所请求页码，默认值为1。",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页参数，所请求页码的元素数量，默认值为10，最大值100。",
        "en": "The number of entries per page. Default value: 10. Maximum value: 100."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "The workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "查看项目下成员授权列表",
    "en": "ListMembers"
  },
  "example": {
    "unifiedCli": "aliyun ververica list-members --workspace a14bd5d90a0000 --namespace default-namespace --page-index 1 --page-size 10 --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /gateway/v2/namespaces/default-namespace/members --region cn-hangzhou --pageIndex 1 --pageSize 10 --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}