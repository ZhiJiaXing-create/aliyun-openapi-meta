        "en": "The deployment ID. This parameter is optional."
      }
    },
    {
      "name": "jobId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "实例ID，非必填。",
        "en": "The job ID. This parameter is optional."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "The name of the namespace."
      }
    },
    {
      "name": "pageIndex",
      "position": "Query",
      "type": "Integer",
