{
  "name": "GetFolder",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/folder",
  "parameters": [
    {
      "name": "folderId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "文件夹ID，为空返回根文件夹。",
        "en": "Folder ID. If empty, the root folder is returned."
      }
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "项目空间名称。",
        "en": "Namespace name."
      }
    },
    {
      "name": "rootType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "en": "The type of the root folder."
      }
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true,
      "description": {
        "zh": "工作空间ID。",
        "en": "Workspace ID."
      }
    }
  ],
  "security": [
    "AK"
  ],
  "title": {
    "zh": "获取文件夹信息",
    "en": "Obtain Folder Information"
  },
  "example": {
    "unifiedCli": "aliyun ververica get-folder --workspace a14bda1c4a0000 --namespace default-namespace --folder-id 89097 --root-type DEVELOPMENT --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/folder --region cn-hangzhou --rootType DEVELOPMENT --folderId 89097 --header \"workspace=a14bda1c4a0000\" --header \"Content-Type=application/json\""
  }
}